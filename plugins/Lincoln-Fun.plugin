__id__ = "lincoln_funpack"
__name__ = "Lincoln-Fun"
__description__ = "Развлекательный и удобный набор: пранк-набор текста («печатает…», «записывает голосовое/видео»), массовая очистка чатов (все сразу или по поиску ника/юзернейма) и скриншоты там, где они запрещены."
__author__ = "Lincoln"
__version__ = "2.0"
__icon__ = "msg_edit"
__app_version__ = ">=12.5.1"
__sdk_version__ = ">=1.4.4.3"
__category__ = ["tools"]

import random
import threading
import time
from typing import Any, Dict, List

from base_plugin import BasePlugin, HookResult, HookStrategy
from ui.settings import Header, Switch, Input, Divider, Text
from android_utils import log, run_on_ui_thread
from client_utils import get_last_fragment, run_on_queue
from org.telegram.messenger import AccountInstance
from java.lang import Long, Integer, Boolean

# ---------------------------------------------------------------- пранк-набор

PRANK_ACTIONS = {
    "typing": "TL_sendMessageTypingAction",
    "voice": "TL_sendMessageRecordAudioAction",
    "video": "TL_sendMessageRecordVideoAction",
}

# ------------------------------------------------------------- поиск/очистка


class ChatCleaner:

    def __init__(self, plugin):
        self.plugin = plugin
        self._running = False

    @staticmethod
    def _cached_method(cls, name, *types):
        try:
            return cls.getDeclaredMethod(name, *types)
        except Exception:
            try:
                return cls.getMethod(name, *types)
            except Exception:
                return None

    def _collect_dialogs(self, controller):
        dialogs = []
        try:
            field = controller.getClass().getDeclaredField("dialogs_dict")
            field.setAccessible(True)
            obj = field.get(controller)
            if obj is not None:
                it = obj.entrySet().iterator()
                while it.hasNext():
                    entry = it.next()
                    dialogs.append((entry.getKey(), entry.getValue()))
                return dialogs
        except Exception as e:
            log("[funpack] dialogs_dict error: %s" % e)
        try:
            for method in controller.getClass().getDeclaredMethods():
                if method.getName() in ("getAllDialogs", "getDialogs") and method.getParameterTypes().length == 0:
                    method.setAccessible(True)
                    result = method.invoke(controller)
                    if result is not None and hasattr(result, "entrySet"):
                        it = result.entrySet().iterator()
                        while it.hasNext():
                            entry = it.next()
                            dialogs.append((entry.getKey(), entry.getValue()))
                        return dialogs
        except Exception as e:
            log("[funpack] fallback dialogs error: %s" % e)
        return dialogs

    def _dialog_title(self, dialog):
        """Достаём имя чата/пользователя для поиска."""
        try:
            user = None
            if hasattr(dialog, "getUser"):
                try:
                    user = dialog.getUser()
                except Exception:
                    user = None
            if user is None:
                try:
                    from org.telegram.messenger import MessagesController
                    mc = MessagesController.getInstance(0) if hasattr(MessagesController, "getInstance") else None
                    user = mc.getUser(dialog.id) if mc else None
                except Exception:
                    pass
            if user is not None:
                first = user.first_name or ""
                last = user.last_name or ""
                username = user.username or ""
                return (first + " " + last).strip(), username.lower()
        except Exception:
            pass
        try:
            chat = None
            if hasattr(dialog, "getChat"):
                try:
                    chat = dialog.getChat()
                except Exception:
                    chat = None
            if chat is None:
                try:
                    from org.telegram.messenger import MessagesController
                    mc = MessagesController.getInstance(0) if hasattr(MessagesController, "getInstance") else None
                    chat = mc.getChat(dialog.id) if mc else None
                except Exception:
                    pass
            if chat is not None:
                return chat.title or "", ""
        except Exception:
            pass
        return "", ""

    def _matches(self, dialog_id, dialog, only_private, only_groups, only_channels):
        if dialog_id == 0:
            if self.plugin.get_setting("keep_saved", True):
                return False
        is_private = dialog_id > 0
        is_channel = dialog_id < -1000000000000
        is_group = dialog_id < 0 and not is_channel
        if only_private and is_private:
            pass
        elif only_groups and is_group:
            pass
        elif only_channels and is_channel:
            pass
        else:
            return False
        return True

    def _matches_query(self, dialog, query):
        if not query:
            return True
        title, username = self._dialog_title(dialog)
        q = query.lower()
        return q in title.lower() or q in username

    def _find_delete_method(self, controller):
        try:
            for method in controller.getClass().getDeclaredMethods():
                if method.getName() != "deleteDialog":
                    continue
                if method.getParameterTypes().length in (1, 2, 3):
                    return method
        except Exception:
            pass
        try:
            return controller.getClass().getMethod("deleteDialog", Long.TYPE, Integer.TYPE, Boolean.TYPE)
        except Exception:
            return None

    def _delete_dialog(self, account, dialog_id):
        try:
            instance = AccountInstance.getInstance(account)
            controller = instance.getMessagesController()
            method = self._find_delete_method(controller)
            if method is None:
                log("[funpack] deleteDialog method not found")
                return
            method.setAccessible(True)
            try:
                method.invoke(controller, Long(dialog_id), Integer(0), Boolean(False))
            except Exception:
                try:
                    method.invoke(controller, Long(dialog_id))
                except Exception:
                    try:
                        method.invoke(controller, Long(dialog_id), Integer(0))
                    except Exception as e:
                        log("[funpack] deleteDialog invoke error: %s" % e)
        except Exception as e:
            log("[funpack] delete error %s: %s" % (dialog_id, e))

    def run(self, account, query, only_private, only_groups, only_channels):
        from android_utils import run_on_ui_thread
        from ui.bulletin import BulletinHelper
        try:
            if self._running:
                run_on_ui_thread(lambda: BulletinHelper.show_info("Очистка уже выполняется…"))
                return
            self._running = True

            def _work():
                try:
                    instance = AccountInstance.getInstance(account)
                    controller = instance.getMessagesController()
                    dialogs = self._collect_dialogs(controller)
                    count = 0
                    for dialog_id, dialog in dialogs:
                        try:
                            if not self._matches(dialog_id, dialog, only_private, only_groups, only_channels):
                                continue
                            if not self._matches_query(dialog, query):
                                continue
                            self._delete_dialog(account, dialog_id)
                            count += 1
                        except Exception:
                            continue
                    self._running = False
                    msg = "Удалено чатов: %d" % count
                    if query:
                        msg += " (по запросу «%s»)" % query
                    run_on_ui_thread(lambda: BulletinHelper.show_info(msg))
                except Exception as e:
                    self._running = False
                    log("[funpack] clean work error: %s" % e)

            run_on_queue(_work)
        except Exception as e:
            self._running = False
            log("[funpack] clean run error: %s" % e)

    def confirm(self, query, only_private, only_groups, only_channels):
        from ui.alert import AlertDialogBuilder
        fragment = get_last_fragment()
        activity = fragment.getParentActivity() if fragment else None
        if activity is None:
            return
        builder = AlertDialogBuilder(activity)
        builder.set_title("Lincoln-Fun · Очистка чатов")
        if query:
            builder.set_message("Удалить чаты, где найден «%s»? Действие нельзя отменить." % query)
        else:
            builder.set_message("Удалить ВСЕ чаты по выбранным правилам? Действие нельзя отменить.")
        builder.set_positive_button("Удалить", lambda b, w: (b.dismiss(), self.run(0, query, only_private, only_groups, only_channels)))
        builder.set_negative_button("Отмена", lambda b, w: b.dismiss())
        builder.make_button_red(AlertDialogBuilder.BUTTON_POSITIVE)
        builder.show()


class LincolnFunPackPlugin(BasePlugin):

    def __init__(self):
        super().__init__()
        self._sessions: Dict[int, float] = {}
        self._timers: Dict[int, threading.Timer] = {}
        self._cleaner = None

    def on_plugin_load(self):
        self.add_hook("TL_updateNewMessage")
        self.add_hook("TL_updateNewChannelMessage")
        try:
            self.add_hook("TL_messages_sendMessage")
        except Exception:
            pass
        if self.get_setting("allow_screenshots", True):
            self._apply_secure(False)

    # ===================================================== разрешение скриншотов

    def _apply_secure(self, allow):
        """allow=True — снять запрет скриншотов (FLAG_SECURE), allow=False — вернуть."""
        try:
            from android.view import WindowManager
            from org.telegram.messenger import ApplicationLoader
            from android.app import Activity
            for activity in _activity_list():
                try:
                    win = activity.getWindow()
                    if win is None:
                        continue
                    if allow:
                        win.clearFlags(WindowManager.LayoutParams.FLAG_SECURE)
                        log("[funpack] FLAG_SECURE cleared")
                    else:
                        win.addFlags(WindowManager.LayoutParams.FLAG_SECURE)
                except Exception as e:
                    log("[funpack] secure apply error: %s" % e)
            # Запасной вариант: текущая активность
            try:
                frag = get_last_fragment()
                activity = frag.getParentActivity() if frag else None
                if activity is not None:
                    win = activity.getWindow()
                    if allow:
                        win.clearFlags(WindowManager.LayoutParams.FLAG_SECURE)
                    else:
                        win.addFlags(WindowManager.LayoutParams.FLAG_SECURE)
            except Exception:
                pass
        except Exception as e:
            log("[funpack] secure error: %s" % e)

    def _on_scr_on_click(self, *args):
        self._apply_secure(True)
        from ui.bulletin import BulletinHelper
        from android_utils import run_on_ui_thread
        run_on_ui_thread(lambda: BulletinHelper.show_info("Запрет скриншотов снят. Можно делать скрины."))

    def _on_scr_off_click(self, *args):
        self._apply_secure(False)
        from ui.bulletin import BulletinHelper
        from android_utils import run_on_ui_thread
        run_on_ui_thread(lambda: BulletinHelper.show_info("Запрет скриншотов вернули."))

    # ============================================================ запуск чистки

    def _on_clean_all_click(self, *args):
        if self._cleaner is None:
            self._cleaner = ChatCleaner(self)
        q = str(self.get_setting("clean_query", "") or "").strip()
        self._cleaner.confirm(
            q,
            self.get_setting("only_private", True),
            self.get_setting("only_groups", True),
            self.get_setting("only_channels", True),
        )

    def _on_clean_search_click(self, *args):
        """
        Открывает окно ввода ника/юзернейма, после ввода спрашивает подтверждение
        и удаляет подходящие диалоги.
        """
        from ui.alert import AlertDialogBuilder
        from android.widget import EditText
        from android.widget import LinearLayout
        from android.widget import FrameLayout
        from java.lang import Runnable
        from android_utils import run_on_ui_thread

        fragment = get_last_fragment()
        activity = fragment.getParentActivity() if fragment else None
        if activity is None:
            return

        field = EditText(activity)
        field.setHint("Ник или @username")
        field.setText(str(self.get_setting("clean_query", "") or ""))
        field.setSingleLine(True)

        wrap = LinearLayout(activity)
        wrap.setOrientation(LinearLayout.VERTICAL)
        wrap.setPadding(24, 24, 24, 0)
        wrap.addView(field)

        builder = AlertDialogBuilder(activity)
        builder.set_title("Поиск чата")
        builder.set_view(wrap)
        builder.set_positive_button("Найти", lambda b, w: self._search_submit(field.getText().toString()))
        builder.set_negative_button("Отмена", lambda b, w: b.dismiss())
        builder.show()

    def _search_submit(self, query):
        query = (query or "").strip()
        if not query:
            from ui.bulletin import BulletinHelper
            from android_utils import run_on_ui_thread
            run_on_ui_thread(lambda: BulletinHelper.show_info("Введите ник или @username"))
            return
        self._cleaner = self._cleaner or ChatCleaner(self)
        self._cleaner.confirm(
            query,
            self.get_setting("only_private", True),
            self.get_setting("only_groups", True),
            self.get_setting("only_channels", True),
        )

    # ===================================================== пранк-набор (часть 1)

    def _peer_id(self, message):
        peer = getattr(message, "peer_id", None)
        val = getattr(peer, "chat_id", None) or getattr(peer, "user_id", None) or \
            getattr(peer, "channel_id", None)
        if val is None and peer is not None:
            try:
                val = int(peer)
            except Exception:
                val = None
        return val

    def _is_target(self, peer_id: int) -> bool:
        mode = str(self.get_setting("prank_mode", "all") or "all").strip().lower()
        raw = str(self.get_setting("prank_chats", "") or "")
        chats = []
        for part in raw.replace(" ", "").replace("\n", ",").replace(";", ",").split(","):
            part = part.strip()
            if part:
                try:
                    chats.append(int(part))
                except Exception:
                    pass
        if mode == "only":
            return peer_id in chats
        if mode == "except":
            return peer_id not in chats
        return True

    def _send_prank_action(self, account: int, peer_id: int, action_name: str):
        try:
            from org.telegram.tgnet import TLRPC

            inst = AccountInstance.getInstance(account)
            if inst is None:
                return
            controller = inst.getMessagesController()
            peer_input = controller.getInputPeer(int(peer_id))
            if peer_input is None:
                return
            action_cls = getattr(TLRPC, action_name, None)
            if action_cls is None:
                return
            req = TLRPC.TL_messages_setTyping()
            req.peer = peer_input
            req.action = action_cls()
            inst.getConnectionsManager().sendRequest(req, lambda res, err: None)
        except Exception as e:
            log("[funpack] prank send error: %s" % e)

    def _send_prank_cancel(self, account: int, peer_id: int):
        try:
            from org.telegram.tgnet import TLRPC

            inst = AccountInstance.getInstance(account)
            if inst is None:
                return
            controller = inst.getMessagesController()
            peer_input = controller.getInputPeer(int(peer_id))
            if peer_input is None:
                return
            req = TLRPC.TL_messages_setTyping()
            req.peer = peer_input
            req.action = TLRPC.TL_sendMessageCancelAction()
            inst.getConnectionsManager().sendRequest(req, lambda res, err: None)
        except Exception:
            pass

    def _start_prank(self, account: int, peer_id: int):
        now = time.time()
        prev = self._sessions.get(peer_id, 0)
        if now - prev < 3:
            return
        self._sessions[peer_id] = now

        try:
            duration = float(str(self.get_setting("prank_duration", "8") or "8").strip())
        except Exception:
            duration = 8.0
        if duration <= 0:
            duration = 8.0

        chosen = None
        for key, clsname in PRANK_ACTIONS.items():
            if self.get_setting(key, False):
                chosen = clsname
                break
        if chosen is None:
            chosen = PRANK_ACTIONS["typing"]

        stop_at = now + duration
        interval = 4.0

        def _tick():
            try:
                if time.time() > stop_at:
                    self._send_prank_cancel(account, peer_id)
                    self._timers.pop(peer_id, None)
                    return
                self._send_prank_action(account, peer_id, chosen)
                t = threading.Timer(interval, _tick)
                t.daemon = True
                self._timers[peer_id] = t
                t.start()
            except Exception:
                self._timers.pop(peer_id, None)

        t = threading.Timer(0.3, _tick)
        t.daemon = True
        self._timers[peer_id] = t
        t.start()

    def on_update_hook(self, update_name: str, account: int, update: Any) -> HookResult:
        try:
            if not self.get_setting("prank_enabled", True):
                return HookResult()
            if update_name not in ("TL_updateNewMessage", "TL_updateNewChannelMessage"):
                return HookResult()
            message = getattr(update, "message", None)
            if message is None:
                return HookResult()
            if bool(getattr(message, "out", False)):
                return HookResult()
            text = getattr(message, "message", "") or ""
            if not text and getattr(message, "media", None) is None:
                return HookResult()
            peer_id = self._peer_id(message)
            if peer_id is None:
                return HookResult()
            if peer_id > 0 and not self.get_setting("prank_private", True):
                return HookResult()
            if not self._is_target(peer_id):
                return HookResult()
            self._start_prank(account, peer_id)
        except Exception as e:
            log("[funpack] prank hook error: %s" % e)
        return HookResult()

    # ============================================================== настройки

    def create_settings(self) -> List[Any]:
        return [
            Header(text="Lincoln-Fun"),
            Header(text="Скриншоты"),
            Text(
                text="Разрешить скриншоты",
                subtext="Снимает FLAG_SECURE — можно делать скрины там, где запрещено (секретные чаты и т.п.)",
                on_click=self._on_scr_on_click,
                icon="msg_camera",
            ),
            Text(
                text="Вернуть запрет скриншотов",
                subtext="Возвращает защиту экрана от скриншотов",
                on_click=self._on_scr_off_click,
                icon="msg_lock",
            ),
            Divider(),
            Header(text="Очистка чатов"),
            Text(
                text="Удалить все чаты",
                subtext="Одним нажатием удаляет ВСЕ диалоги по правилам ниже",
                on_click=self._on_clean_all_click,
                icon="msg_delete",
            ),
            Text(
                text="Удалить по поиску",
                subtext="Вводите ник или @username — удалит все чаты с таким именем",
                on_click=self._on_clean_search_click,
                icon="msg_search",
            ),
            Input(
                key="clean_query",
                text="Запрос по умолчанию",
                default="",
                subtext="Ник или юзернейм для поиска (можно оставить пустым)",
                icon="msg_search",
            ),
            Divider(),
            Header(text="Правила очистки"),
            Switch(key="only_private", text="Личные чаты", default=True, icon="msg_user"),
            Switch(key="only_groups", text="Группы", default=True, icon="msg_chat"),
            Switch(key="only_channels", text="Каналы", default=True, icon="msg_broadcast"),
            Switch(key="keep_saved", text="Сохранить «Избранное»", default=True, icon="msg_bookmark"),
            Divider(),
            Header(text="Пранк-набор текста"),
            Switch(key="prank_enabled", text="Включить пранк-набор", default=True, icon="msg_switcher_on"),
            Divider(),
            Header(text="Что показывать"),
            Switch(key="typing", text="«Печатает…»", default=True, icon="msg_edit"),
            Switch(key="voice", text="«Записывает голосовое…»", default=False, icon="msg_mic"),
            Switch(key="video", text="«Записывает видео…»", default=False, icon="msg_camera"),
            Input(
                key="prank_duration",
                text="Длительность (сек)",
                default="8",
                subtext="Сколько секунд собеседник видит «печатает»",
                icon="msg_timer",
            ),
            Divider(),
            Header(text="Чаты"),
            Switch(key="prank_private", text="Только личные чаты", default=True, icon="msg_user"),
            Input(
                key="prank_mode",
                text="Режим чатов",
                default="all",
                subtext="all — все, only — только из списка, except — все, кроме списка",
                icon="msg_filter",
            ),
            Input(
                key="prank_chats",
                text="ID чатов",
                default="",
                subtext="Через запятую, например: 123456789, -1001234567890",
                icon="msg_group",
            ),
            Divider(),
            Text(
                text="Как работает",
                subtext="Пранк-набор шлёт «печатает» по протоколу Telegram и сам отменяет по таймеру. Очистка удаляет диалоги локально через MessagesController. Скриншоты снимаются снятием FLAG_SECURE у окон приложения.",
                icon="msg_info",
            ),
        ]


def _activity_list():
    """Возвращает список активных Activity текущего процесса (best effort)."""
    out = []
    try:
        from org.telegram.messenger import ApplicationLoader
        from android.app import Activity
        from android.os import Build
        ctx = ApplicationLoader.applicationContext
        if ctx is None:
            return out
        if hasattr(ctx, "getActivity") and ctx.getActivity() is not None:
            out.append(ctx.getActivity())
    except Exception:
        pass
    return out


def create_plugin():
    return LincolnFunPackPlugin()


def get_plugin():
    return LincolnFunPackPlugin()