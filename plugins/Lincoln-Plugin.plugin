profile_gradient_active = False
gradient_view_proxy_ready = None
cls_profile_gradient_view = None

def hsv_to_argb_color(hue, sat, val, alpha):
    try:
        Color = jclass('android.graphics.Color')
        return int(Color.HSVToColor(int(alpha), [float(hue), float(sat), float(val)]))
    except Exception:
        return int(1714657791)

def draw_animated_gradient(canvas, view):
    try:
        if not profile_gradient_active:
            return
        w = int(view.getWidth())
        h = int(view.getHeight())
        if w <= 0 or h <= 0:
            view.invalidate()
            return
        now_ms = time.time() * 1000
        hue = now_ms * 0.02 % 360.0
        c1 = hsv_to_argb_color(hue, 0.55, 1.0, 180)
        c2 = hsv_to_argb_color((hue + 50) % 360.0, 0.6, 1.0, 90)
        LinearGradient = jclass('android.graphics.LinearGradient')
        TileMode = jclass('android.graphics.Shader$TileMode')
        paint = jclass('android.graphics.Paint')()
        paint.setAntiAlias(True)
        paint.setShader(LinearGradient(0.0, 0.0, float(w), float(h), int(c1), int(c2), TileMode.CLAMP))
        canvas.drawRect(0.0, 0.0, float(w), float(h), paint)
        view.invalidate()
    except Exception:
        pass

def init_gradient_view_proxy():
    global gradient_view_proxy_ready, cls_profile_gradient_view
    if gradient_view_proxy_ready is not None:
        return gradient_view_proxy_ready
    try:
        from extera_utils.classes import Base, java_subclass, joverride
        ViewCls = jclass('android.view.View')

        @java_subclass(ViewCls)
        class _GradientView(Base):

            @joverride('onDraw', ['android.graphics.Canvas'])
            def on_draw(self, canvas):
                draw_animated_gradient(canvas, self)
        cls_profile_gradient_view = _GradientView
        gradient_view_proxy_ready = True
    except Exception as e:
        log(f'[Cool] proxy unavailable: {e}')
        gradient_view_proxy_ready = False
    return gradient_view_proxy_ready

def invoke_original_param_method(param):
    try:
        return param.method.invoke(param.thisObject, param.args)
    except Exception:
        return None

class hook_patch_reactions_after_update(MethodHook):

    def __init__(self, plugin):
        self.plugin = plugin

    def after_hooked_method(self, param):
        try:
            if not self.plugin._licensed():
                return
            self.plugin._patch_reactions(param.args)
        except Exception:
            pass

class replace_reactions_count(MethodReplacement):

    def __init__(self, plugin):
        self.plugin = plugin

    def replace_hooked_method(self, param):
        try:
            if not self.plugin._licensed():
                return invoke_original_param_method(param)
            if not self.plugin._reactions_enabled():
                return invoke_original_param_method(param)
            mo = param.thisObject
            if mo is None:
                return invoke_original_param_method(param)
            try:
                msg_id = int(mo.getId())
            except Exception:
                return invoke_original_param_method(param)
            target = self.plugin._reactions_target()
            if target <= 0 or msg_id != target:
                return invoke_original_param_method(param)
            return self.plugin._reactions_count()
        except Exception:
            return invoke_original_param_method(param)

class replace_printing_strings_fake_typing(MethodReplacement):

    def __init__(self, plugin):
        self.plugin = plugin

    def replace_hooked_method(self, param):
        if not self.plugin._licensed():
            return invoke_original_param_method(param)
        try:
            original = invoke_original_param_method(param)
        except Exception:
            original = None
        try:
            if not self.plugin._fake_typing_enabled():
                return original
            peer = param.args[0] if param.args else None
            if peer is None or not self.plugin._typing_peer_matches(peer):
                return original
            fake = self.plugin._fake_typing_list()
            if fake is None:
                return original
            if original is None:
                return fake
            try:
                result = ArrayList(original)
            except Exception:
                result = ArrayList()
                try:
                    for i in range(int(original.size())):
                        result.add(original.get(i))
                except Exception:
                    return original
            for i in range(int(fake.size())):
                result.add(fake.get(i))
            return result
        except Exception:
            return original

