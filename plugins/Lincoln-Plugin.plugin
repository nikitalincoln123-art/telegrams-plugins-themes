    REGULAR_GIFT_KEYWORDS = ('bear', 'медвед')
    REGULAR_GIFT_OVERRIDES = ({'id': 5170145012310081615, 'stars': 15, 'title': 'Сердце'}, {'id': 5170233102089322756, 'stars': 15, 'title': 'Мишка'}, {'id': 5170250947678437525, 'stars': 25, 'title': 'Подарок'}, {'id': 5168103777563050263, 'stars': 25, 'title': 'Роза'}, {'id': 5170144170496491616, 'stars': 50, 'title': 'Торт'}, {'id': 5170314324215857265, 'stars': 50, 'title': 'Букет'}, {'id': 5170564780938756245, 'stars': 50, 'title': 'Ракета'}, {'id': 6028601630662853006, 'stars': 50, 'title': 'Шампанское'}, {'id': 5168043875654172773, 'stars': 100, 'title': 'Кубок'}, {'id': 5170690322832818290, 'stars': 100, 'title': 'Кольцо'}, {'id': 5170521118301225164, 'stars': 100, 'title': 'Кристалл'})
    UNIQUE_GIFT_OVERRIDES = ({'id': 5956217000635139069, 'title': 'Новый год мишка'}, {'id': 5922558454332916696, 'title': 'Елка'}, {'id': 5800655655995968830, 'title': '14 февраля мишка'}, {'id': 5801108895304779062, 'title': '14 февраля сердце'}, {'id': 5866352046986232958, 'title': '8 марта мишка'}, {'id': 5893356958802511476, 'title': 'День Патрика мишка'}, {'id': 5935895822435615975, 'title': '1 апреля'})

    def _register_chat_menu_items(self):
        try:
            if bool(self.get_setting(self.MENU_OPEN_SELECTOR_KEY, True)):
                self.add_menu_item(MenuItemData(menu_type=MenuItemType.CHAT_ACTION_MENU, item_id='nft_builder_open_selector', text='NFT конструктор', icon='msg_gift', on_click=self._on_menu_open_selector))
            if bool(self.get_setting(self.MENU_OPEN_LINK_KEY, True)):
                self.add_menu_item(MenuItemData(menu_type=MenuItemType.CHAT_ACTION_MENU, item_id='nft_builder_open_link', text='NFT по ссылке', icon='msg_gift', on_click=self._on_menu_open_direct_link))
            self.add_menu_item(MenuItemData(menu_type=MenuItemType.CHAT_ACTION_MENU, item_id='cool_typing_toggle', text='Печатает здесь', icon='msg_mention', on_click=self._on_menu_toggle_typing))
        except Exception as e:
            log(f'[{__id__}] menu registration warning: {e}')

    def _menu_context_get(self, context: Any, key: str):
        if context is None:
            return None
        try:
            if isinstance(context, dict):
                return context.get(key)
        except Exception:
            pass
        try:
            getter = getattr(context, 'get', None)
            if callable(getter):
                return getter(key)
        except Exception:
            pass
        return None

    def _menu_context_account(self, context: Any) -> int:
        value = self._menu_context_get(context, 'account')
        if value is not None:
            try:
                return int(value)
            except Exception:
                pass
        return int(self._get_current_account())

    def _menu_context_peer(self, context: Any) -> Optional[int]:
        for key in ('dialog_id', 'dialogId', 'peer'):
            value = self._menu_context_get(context, key)
            if value is not None:
                try:
                    return int(value)
                except Exception:
                    pass
        user = self._menu_context_get(context, 'user')
        if user is not None:
            try:
                uid = int(getattr(user, 'id'))
                if uid > 0:
                    return uid
            except Exception:
                pass
        chat = self._menu_context_get(context, 'chat')
        if chat is not None:
            try:
                cid = int(getattr(chat, 'id'))
                if cid > 0:
                    return -cid
            except Exception:
                pass
        try:
            fragment = self._get_effective_fragment()
            if fragment is not None and hasattr(fragment, 'getDialogId'):
                return int(fragment.getDialogId())
        except Exception:
            pass
        return None

    def _on_menu_open_selector(self, context: Any):
        if not self._license_guard():
            return
        account = self._menu_context_account(context)
        peer = self._menu_context_peer(context)
        if peer is None:
            BulletinHelper.show_error('Не удалось определить чат')
            return
        run_on_ui_thread(lambda: self._show_direction_selector(int(account), int(peer), ''))

    def _show_direct_link_input_dialog(self, account: int, peer: int):
        activity = self._get_activity()
        if activity is None:
            BulletinHelper.show_error('Не удалось открыть ввод ссылки NFT')
            return
        et = EditText(activity)
        et.setHint('https://t.me/nft/...')
        try:
            et.setInputType(InputType.TYPE_CLASS_TEXT)
        except Exception:
            pass
        builder = AlertDialogBuilder(activity)
        builder.set_title('NFT по ссылке · Конструктор')
        builder.set_message('Вставь ссылку collectible вида https://t.me/nft/name-123')
        builder.set_view(et)

        def _apply(_, __):
            raw = ''
            try:
                raw = et.getText().toString()
            except Exception:
                raw = ''
            normalized = self._normalize_nft_url(raw)
            if not normalized:
                BulletinHelper.show_error('Нужна ссылка формата https://t.me/nft/name-123')
                return
            self._show_direction_selector_for_direct_link(int(account), int(peer), str(normalized))
        builder.set_positive_button('Продолжить', _apply)
        builder.set_negative_button('Отмена', lambda dialog, which: dialog.dismiss())
        builder.show()

    def _on_menu_open_direct_link(self, context: Any):
        if not self._license_guard():
            return
        account = self._menu_context_account(context)
        peer = self._menu_context_peer(context)
        if peer is None:
            BulletinHelper.show_error('Не удалось определить чат')
            return
        run_on_ui_thread(lambda: self._show_direct_link_input_dialog(int(account), int(peer)))

    def _sheet_icon_id(self) -> int:
        return 0

    def _show_bottom_sheet_picker(self, title: str, labels: List[str], on_pick) -> bool:
        if not labels:
            return False
        activity = self._get_activity()
        if activity is None:
            return False
        try:
            from java.lang import String, Integer
            from java.lang.reflect import Array
            from org.telegram.ui.ActionBar import BottomSheet
            fragment = self._get_effective_fragment()
            resource_provider = None
            try:
                resource_provider = fragment.getResourceProvider() if fragment is not None else None
            except Exception:
                resource_provider = None
            if resource_provider is not None:
                builder = BottomSheet.Builder(activity, False, resource_provider)
            else:
                builder = BottomSheet.Builder(activity)
            count = len(labels)
            text_array = Array.newInstance(String, count)
            icon_array = Array.newInstance(Integer.TYPE, count)
            icon_id = int(self._sheet_icon_id())
            for i, label in enumerate(labels):
                Array.set(text_array, i, String(str(label)))
                Array.setInt(icon_array, i, int(icon_id))
            builder.setTitle(String(str(title or 'NFT')), True)
            try:
                if icon_id > 0:
                    builder.setItems(text_array, icon_array, cls_dialog_click_listener(on_pick))
                else:
                    builder.setItems(text_array, cls_dialog_click_listener(on_pick))
            except Exception:
                builder.setItems(text_array, cls_dialog_click_listener(on_pick))
            sheet = builder.create()
            try:
                if fragment is not None and hasattr(fragment, 'showDialog'):
                    fragment.showDialog(sheet)
                else:
                    sheet.show()
            except Exception:
                sheet.show()
            return True
        except Exception:
            return False

    def _show_direction_picker(self, title: str, message: str, on_mine, on_incoming):
        labels = ['От моего имени', 'От имени собеседника']

        def _pick(idx: int):
            if int(idx) == 0:
                on_mine()
            elif int(idx) == 1:
                on_incoming()
        if self._show_bottom_sheet_picker(title, labels, _pick):
            return
        activity = self._get_activity()
        if activity is None:
            BulletinHelper.show_error('Не удалось открыть выбор направления NFT')
            return
        builder = AlertDialogBuilder(activity)
        builder.set_title(title)
        builder.set_message(message)
        builder.set_positive_button('От моего имени', lambda dialog, which: on_mine())
        builder.set_negative_button('От имени собеседника', lambda dialog, which: on_incoming())
        builder.show()

    def on_send_message_hook(self, account: int, params: Any) -> HookResult:
        if not self._licensed():
            return HookResult(strategy=HookStrategy.DEFAULT)
        try:
            text = getattr(params, 'message', None)
            if not isinstance(text, str):
                return HookResult()
            raw = text.strip()
            lowered = raw.lower()
            if lowered == '.nfthelp':
                run_on_ui_thread(self._show_help_dialog)
                return HookResult(strategy=HookStrategy.CANCEL)
            if lowered == '.nftwipe':
                self._migrate_and_purge_broken_messages(force=True)
                return HookResult(strategy=HookStrategy.CANCEL)
            if lowered == '.nftclear':
                peer = self._get_peer_from_params(params)
                if peer is None:
                    run_on_ui_thread(lambda: BulletinHelper.show_error('Не удалось определить текущий чат'))
                    return HookResult(strategy=HookStrategy.CANCEL)
                run_on_ui_thread(lambda: self._clear_current_chat(int(account), int(peer)))
                return HookResult(strategy=HookStrategy.CANCEL)
            direct_link_info = self._parse_direct_nft_command(raw)
            if direct_link_info is not None:
                peer = self._get_peer_from_params(params)
                if peer is None:
                    run_on_ui_thread(lambda: BulletinHelper.show_error('Не удалось определить текущий чат. Открой диалог и повтори команду.'))
                    return HookResult(strategy=HookStrategy.CANCEL)
                normalized_url = str(direct_link_info.get('url'))
                forced = bool(direct_link_info.get('from_command', False))
                if forced:
                    direct_outgoing = bool(direct_link_info.get('is_outgoing', True))
                    run_on_ui_thread(lambda: BulletinHelper.show_info('Соединение с интернетом...'))
                    run_on_queue(lambda: self._handle_direct_nft_link(int(account), int(peer), bool(direct_outgoing), str(normalized_url)))
                else:
                    run_on_ui_thread(lambda: self._show_direction_selector_for_direct_link(int(account), int(peer), str(normalized_url)))
                return HookResult(strategy=HookStrategy.CANCEL)
            if lowered.startswith('.sendnft') or lowered.startswith('.getnft'):
                peer = self._get_peer_from_params(params)
                if peer is None:
                    run_on_ui_thread(lambda: BulletinHelper.show_error('Не удалось определить текущий чат. Открой диалог и повтори команду.'))
                    return HookResult(strategy=HookStrategy.CANCEL)
                query = raw.split(' ', 1)[1].strip() if ' ' in raw else ''
                run_on_ui_thread(lambda: self._show_direction_selector(int(account), int(peer), query))
                return HookResult(strategy=HookStrategy.CANCEL)
            return HookResult()
        except Exception as e:
            log(f'[{__id__}] hook error: {e}\n{traceback.format_exc()}')
            run_on_ui_thread(lambda: BulletinHelper.show_error('Ошибка NFT плагина. Подробности в логах.'))
            return HookResult(strategy=HookStrategy.CANCEL)

    def _show_help_dialog(self):
        activity = self._get_activity()
        if activity is None:
            BulletinHelper.show_error('Не удалось открыть справку')
            return
        builder = AlertDialogBuilder(activity)
        builder.set_title('NFT Collectible Direction Builder')
        builder.set_message('.sendnft - открыть выбор NFT с вопросом, от кого будет подарок\n.getnft - то же самое, алиас команды\n.sendnft <поиск> - быстрый поиск по названию NFT\n.sendnft <ссылка t.me/nft/...> - сразу вставить NFT по ссылке без меню\n.getnft <ссылка t.me/nft/...> - сразу показать входящий NFT по ссылке\nПросто вставить ссылку https://t.me/nft/... в чат - тоже работает, по умолчанию как исходящий подарок.\n.nftclear - убрать из чата вставленные плагином NFT (текущий диалог)\n.nftwipe - очистить мусор старых сломанных версий\n\nДля прямой ссылки плагин парсит страницу collectible, берет модель / symbol / backdrop / номер\nи собирает по ним тот же NFT без ручного выбора.')
        builder.set_positive_button('Ок', lambda dialog, which: dialog.dismiss())
        builder.show()

    def _show_direction_selector(self, account: int, peer: int, query: str):

        def _mine():
            self._open_or_search(account, peer, True, query, 0)

        def _incoming():
            self._open_or_search(account, peer, False, query, 0)
        self._show_direction_picker(title='NFT конструктор · Шаг 1/5', message='Выбери направление collectible NFT.\n\nОт твоего имени - будет видно, будто ты подарил NFT собеседнику.\nОт имени собеседника - будет видно, будто собеседник подарил NFT тебе.', on_mine=_mine, on_incoming=_incoming)

    def _show_direction_selector_for_direct_link(self, account: int, peer: int, url: str):

        def _run_selected(is_outgoing: bool):
            run_on_ui_thread(lambda: BulletinHelper.show_info('Соединение с интернетом...'))
            run_on_queue(lambda: self._handle_direct_nft_link(int(account), int(peer), bool(is_outgoing), str(url)))

        def _mine():
            _run_selected(True)

        def _incoming():
            _run_selected(False)
        self._show_direction_picker(title='NFT по ссылке · Шаг 1/2', message='Ссылка на collectible распознана.\n\nВыбери направление вставки NFT в чат.\nОт твоего имени - будет видно, будто ты подарил NFT собеседнику.\nОт имени собеседника - будет видно, будто собеседник подарил NFT тебе.', on_mine=_mine, on_incoming=_incoming)

    def _open_or_search(self, account: int, peer: int, is_outgoing: bool, query: str, attempt: int=0):
        catalog = self._get_runtime_catalog(account, refresh=attempt == 0)
        if not catalog:
            if attempt < 3:
                self._load_catalog_silent(account)
                if attempt == 0:
                    BulletinHelper.show_info('Загружаю NFT каталог Telegram...')
                AndroidUtilities.runOnUIThread(RUNNABLE_PROXY_CLASS(lambda: self._open_or_search(account, peer, is_outgoing, query, attempt + 1)), 700)
                return
            BulletinHelper.show_error('Не удалось получить NFT каталог. Открой раздел подарков Telegram один раз и повтори команду.')
            return
        query = (query or '').strip()
        if query:
            direct = self._resolve_query_direct(account, query)
            if direct is not None:
                self._start_builder_flow(account, peer, direct, is_outgoing)
                return
            results = self._search_catalog(account, query)
            if not results:
                BulletinHelper.show_error(f'Ничего не найдено по запросу: {query}')
                return
            self._show_catalog_page(account, peer, is_outgoing, results, f'NFT: {query}', 0)
            return
        self._show_catalog_page(account, peer, is_outgoing, catalog, 'Выбери NFT основу', 0)

    def _show_catalog_page(self, account: int, peer: int, is_outgoing: bool, catalog: List[Dict[str, Any]], title: str, page: int):
        activity = self._get_activity()
        if activity is None:
            BulletinHelper.show_error('Не удалось открыть меню выбора NFT')
            return
        if not catalog:
            BulletinHelper.show_error('NFT каталог пуст')
            return
        total_pages = max(1, (len(catalog) + self.PAGE_SIZE - 1) // self.PAGE_SIZE)
        page = max(0, min(page, total_pages - 1))
        start = page * self.PAGE_SIZE
        end = min(len(catalog), start + self.PAGE_SIZE)
        page_items = catalog[start:end]
        direction = 'от тебя собеседнику' if bool(is_outgoing) else 'от собеседника тебе'
        labels = []
        for item in page_items:
            name = str(item.get('title', 'NFT') or 'NFT').strip()
            if not name:
                name = 'NFT'
            if self._is_regular_catalog_item(item):
                stars = int(self._to_int_safe(item.get('stars', 0), 0))
                if stars > 0 and '⭐' not in name and ('star' not in name.lower()):
                    name = f'{name} · {self._format_stars_count_label(stars)}'
            labels.append(name)

        def _on_click(_, which):
            try:
                idx = int(which)
            except Exception:
                idx = -1
            if 0 <= idx < len(page_items):
                self._start_builder_flow(account, peer, page_items[idx], is_outgoing)
        if total_pages == 1:
            if self._show_bottom_sheet_picker('Шаг 2/5 · Выбери NFT основу', labels, lambda idx: _on_click(None, idx)):
                return
        builder = AlertDialogBuilder(activity)
        builder.set_title(f'Шаг 2/5 · {title} ({page + 1}/{total_pages})')
        builder.set_message(f'Направление: {direction}\nВыбери основу collectible NFT или обычный подарок.')
        builder.set_items(labels, _on_click)
        if page > 0:
            builder.set_neutral_button('Назад', lambda dialog, which: self._show_catalog_page(account, peer, is_outgoing, catalog, title, page - 1))
        if page + 1 < total_pages:
            builder.set_positive_button('Дальше', lambda dialog, which: self._show_catalog_page(account, peer, is_outgoing, catalog, title, page + 1))
        builder.set_negative_button('Закрыть', lambda dialog, which: dialog.dismiss())
        builder.show()

    def _start_builder_flow(self, account: int, peer: int, item: Dict[str, Any], is_outgoing: bool):
        if self._is_regular_catalog_item(item):
            self._show_regular_gift_confirm(account, peer, item, is_outgoing)
            return
        self._request_upgrade_preview(account, peer, item, is_outgoing)

    def _is_regular_catalog_item(self, item: Optional[Dict[str, Any]]) -> bool:
        if not isinstance(item, dict):
            return False
        return str(item.get('_gift_mode', '') or '').strip().lower() == 'regular'

    def _show_regular_gift_confirm(self, account: int, peer: int, item: Dict[str, Any], is_outgoing: bool):
        activity = self._get_activity()
        if activity is None:
            BulletinHelper.show_error('Не удалось открыть подтверждение подарка')
            return
        title = str(item.get('title') or 'Подарок').strip() or 'Подарок'
        stars = int(self._to_int_safe(item.get('stars', 0), 0))
        direction = 'от тебя собеседнику' if bool(is_outgoing) else 'от собеседника тебе'
        state = {'account': int(account), 'peer': int(peer), 'is_outgoing': bool(is_outgoing), 'item': item, 'gift_comment': ''}
        et = EditText(activity)
        et.setHint('Комментарий к подарку (по желанию)')
        try:
            et.setInputType(InputType.TYPE_CLASS_TEXT | InputType.TYPE_TEXT_FLAG_MULTI_LINE)
        except Exception:
            pass
        builder = AlertDialogBuilder(activity)
        builder.set_title(self._regular_gift_dialog_title())
        if stars > 0:
            builder.set_message(f"Направление: {direction}\nПодарок: {title}\n{self._gift_price_line(stars, 'ru')}\n\nНапиши комментарий — как при отправке подарка в Telegram, затем нажми «В чат».")
        else:
            builder.set_message(f'Направление: {direction}\nПодарок: {title}\n\nКомментарий по желанию, затем «В чат».')
        builder.set_view(et)

        def _send(_, __):
            raw = ''
            try:
                raw = et.getText().toString()
            except Exception:
                raw = ''
            state['gift_comment'] = str(raw or '').strip()
            self._inject_selected_nft(state)
        builder.set_positive_button('В чат', _send)
        builder.set_negative_button('Отмена', lambda dialog, which: dialog.dismiss())
        builder.show()

    def _request_upgrade_preview(self, account: int, peer: int, item: Dict[str, Any], is_outgoing: bool):
        try:
            source_gift = item.get('_source_obj')
            if source_gift is None:
                raise RuntimeError('Не найден runtime объект подарка')
            if not self._is_upgradeable_gift(source_gift):
                raise RuntimeError('Этот подарок нельзя использовать как основу для NFT')
            base_id = self._resolve_base_gift_id(source_gift, item)
            if base_id <= 0:
                raise RuntimeError('Не удалось определить gift id для NFT')
            request_cls = None
            for cls_name in ('org.telegram.tgnet.tl.TL_stars$getStarGiftUpgradeAttributes', 'org.telegram.tgnet.tl.TL_stars$getStarGiftUpgradePreview'):
                try:
                    request_cls = jclass(cls_name)
                    break
                except Exception:
                    request_cls = None
            if request_cls is None:
                raise RuntimeError('Не найден TL класс запроса NFT атрибутов')
            req = request_cls()
            self._set_any_field(req, ['gift_id', 'giftId', 'id'], int(base_id))
            BulletinHelper.show_info('Загружаю NFT атрибуты...')

            def _on_done(response, error):

                def _finish():
                    try:
                        self._pending_request_delegates = [cb for cb in getattr(self, '_pending_request_delegates', []) if cb is not delegate]
                    except Exception:
                        pass
                    if error is not None:
                        err_text = self._get_any_field_value(error, 'text', 'error_message', 'message') or str(error)
                        BulletinHelper.show_error(f'Не удалось получить NFT атрибуты: {err_text}')
                        return
                    try:
                        self._open_builder_dialogs(account, peer, item, is_outgoing, response)
                    except Exception as builder_error:
                        log(f'[{__id__}] builder open error: {builder_error}\n{traceback.format_exc()}')
                        BulletinHelper.show_error(f'Не удалось открыть NFT конструктор: {builder_error}')
                run_on_ui_thread(_finish)
            delegate = REQUEST_DELEGATE_PROXY_CLASS(_on_done)
            try:
                self._pending_request_delegates.append(delegate)
            except Exception:
                self._pending_request_delegates = [delegate]
            get_connections_manager().sendRequest(req, delegate)
        except Exception as e:
            log(f'[{__id__}] preview request error: {e}\n{traceback.format_exc()}')
            BulletinHelper.show_error(f'Не удалось подготовить NFT: {e}')

    def _open_builder_dialogs(self, account: int, peer: int, item: Dict[str, Any], is_outgoing: bool, response: Any):
        models, patterns, backdrops = self._extract_attr_groups(response)
        if not models:
            raise RuntimeError('Сервер не вернул модели NFT')
        if not backdrops:
            raise RuntimeError('Сервер не вернул фоны NFT')
        state = {'account': int(account), 'peer': int(peer), 'is_outgoing': bool(is_outgoing), 'item': item, 'response': response, 'models': models, 'patterns': patterns, 'backdrops': backdrops, 'model_index': 0, 'pattern_index': 0, 'backdrop_index': 0, 'number': self._default_nft_number(item)}
        self._show_model_selector(state)

    def _show_model_selector(self, state: Dict[str, Any]):
        labels = [self._describe_attr(obj, i + 1) for i, obj in enumerate(state.get('models', []))]
        gift_title = str((state.get('item', {}) or {}).get('title', 'NFT') or 'NFT').strip()
        if not gift_title:
            gift_title = 'NFT'
        self._show_items_dialog(title=f'Шаг 3/5 · Модель ({gift_title})', labels=labels, on_select=lambda idx: self._on_select_model(state, idx))

    def _on_select_model(self, state: Dict[str, Any], idx: int):
        state['model_index'] = int(idx)
        if state.get('patterns'):
            self._show_pattern_selector(state)
        else:
            self._show_backdrop_selector(state)

    def _show_pattern_selector(self, state: Dict[str, Any]):
        labels = [self._describe_attr(obj, i + 1) for i, obj in enumerate(state.get('patterns', []))]
        gift_title = str((state.get('item', {}) or {}).get('title', 'NFT') or 'NFT').strip()
        if not gift_title:
            gift_title = 'NFT'
        self._show_items_dialog(title=f'Шаг 3/5 · Узор ({gift_title})', labels=labels, on_select=lambda idx: self._on_select_pattern(state, idx))

    def _on_select_pattern(self, state: Dict[str, Any], idx: int):
        state['pattern_index'] = int(idx)
        self._show_backdrop_selector(state)

    def _show_backdrop_selector(self, state: Dict[str, Any]):
        labels = [self._describe_attr(obj, i + 1) for i, obj in enumerate(state.get('backdrops', []))]
        gift_title = str((state.get('item', {}) or {}).get('title', 'NFT') or 'NFT').strip()
        if not gift_title:
            gift_title = 'NFT'
        self._show_items_dialog(title=f'Шаг 3/5 · Фон ({gift_title})', labels=labels, on_select=lambda idx: self._on_select_backdrop(state, idx))

    def _on_select_backdrop(self, state: Dict[str, Any], idx: int):
        state['backdrop_index'] = int(idx)
        self._show_number_input(state)

    def _show_number_input(self, state: Dict[str, Any]):
        activity = self._get_activity()
        if activity is None:
            BulletinHelper.show_error('Не удалось открыть ввод номера NFT')
            return
        et = EditText(activity)
        et.setHint('Номер NFT')
        et.setInputType(InputType.TYPE_CLASS_NUMBER)
        try:
            et.setText(str(int(state.get('number', 1) or 1)))
            et.setSelection(len(et.getText().toString()))
        except Exception:
            pass
        builder = AlertDialogBuilder(activity)
        gift_title = str((state.get('item', {}) or {}).get('title', 'NFT') or 'NFT').strip()
        if not gift_title:
            gift_title = 'NFT'
        builder.set_title(f'Шаг 4/5 · Номер NFT ({gift_title})')
        try:
            models = state.get('models') or []
            patterns = state.get('patterns') or []
            backdrops = state.get('backdrops') or []
            model_idx = int(state.get('model_index', 0))
            pattern_idx = int(state.get('pattern_index', 0))
            backdrop_idx = int(state.get('backdrop_index', 0))
            model_name = self._describe_attr(models[model_idx % len(models)], model_idx + 1) if models else '-'
            pattern_name = self._describe_attr(patterns[pattern_idx % len(patterns)], pattern_idx + 1) if patterns else 'без узора'
            backdrop_name = self._describe_attr(backdrops[backdrop_idx % len(backdrops)], backdrop_idx + 1) if backdrops else '-'
            builder.set_message(f'Модель: {model_name}\nУзор: {pattern_name}\nФон: {backdrop_name}\n\nУкажи номер и перейди к подтверждению.')
        except Exception:
            pass
        builder.set_view(et)

        def _apply(_, __):
            raw = ''
            try:
                raw = et.getText().toString()
            except Exception:
                raw = ''
            number = self._to_int_safe(raw, 0)
            if number <= 0:
                number = self._default_nft_number(state.get('item', {}))
            state['number'] = int(number)
            self._show_confirm_preview(state)
        builder.set_positive_button('Продолжить', _apply)
        builder.set_negative_button('Отмена', lambda dialog, which: dialog.dismiss())
        builder.show()

    def _show_items_dialog(self, title: str, labels: List[str], on_select, page: int=0):
        activity = self._get_activity()
        if activity is None:
            BulletinHelper.show_error('Не удалось открыть NFT меню')
            return
        if not labels:
            BulletinHelper.show_error('Список NFT атрибутов пуст')
            return
        total_pages = max(1, (len(labels) + self.PAGE_SIZE - 1) // self.PAGE_SIZE)
        page = max(0, min(page, total_pages - 1))
        start = page * self.PAGE_SIZE
        end = min(len(labels), start + self.PAGE_SIZE)
        page_labels = labels[start:end]
        if total_pages == 1:
            if self._show_bottom_sheet_picker(title, page_labels, lambda idx: on_select(start + int(idx))):
                return
        builder = AlertDialogBuilder(activity)
        builder.set_title(f'{title} ({page + 1}/{total_pages})')
        builder.set_message('Выбери один вариант из списка.')

        def _click(_, which):
            try:
                idx = int(which)
            except Exception:
                idx = -1
            if 0 <= idx < len(page_labels):
                on_select(start + idx)
        builder.set_items(page_labels, _click)
        if page > 0:
            builder.set_neutral_button('Назад', lambda dialog, which: self._show_items_dialog(title, labels, on_select, page - 1))
        if page + 1 < total_pages:
            builder.set_positive_button('Дальше', lambda dialog, which: self._show_items_dialog(title, labels, on_select, page + 1))
        builder.set_negative_button('Закрыть', lambda dialog, which: dialog.dismiss())
        builder.show()

    def _safe_attr_label(self, items: List[Any], idx: int, fallback: str) -> str:
        try:
            if not items:
                return fallback
            pos = int(idx) % len(items)
            return str(self._describe_attr(items[pos], pos + 1) or fallback)
        except Exception:
            return fallback

    def _show_confirm_preview(self, state: Dict[str, Any]):
        item = state.get('item', {}) or {}
        gift_title = str(item.get('title', 'NFT') or 'NFT').strip()
        if not gift_title:
            gift_title = 'NFT'
        models = state.get('models') or []
        patterns = state.get('patterns') or []
        backdrops = state.get('backdrops') or []
        model_name = self._safe_attr_label(models, int(state.get('model_index', 0)), 'модель не выбрана')
        pattern_name = self._safe_attr_label(patterns, int(state.get('pattern_index', 0)), 'без узора') if patterns else 'без узора'
        backdrop_name = self._safe_attr_label(backdrops, int(state.get('backdrop_index', 0)), 'фон не выбран')
        number = int(self._to_int_safe(state.get('number', 0), 0) or self._default_nft_number(item))
        state['number'] = int(number)
        direction = 'от тебя собеседнику' if bool(state.get('is_outgoing', True)) else 'от собеседника тебе'
        actions = [(f'Вставить NFT: {gift_title} #{number}', lambda: self._inject_selected_nft(state)), (f'Изменить номер ({number})', lambda: self._show_number_input(state)), (f'Изменить фон ({backdrop_name})', lambda: self._show_backdrop_selector(state)), (f'Изменить модель ({model_name})', lambda: self._show_model_selector(state))]
        if patterns:
            actions.insert(3, (f'Изменить узор ({pattern_name})', lambda: self._show_pattern_selector(state)))
        labels = [a[0] for a in actions]

        def _pick(idx: int):
            try:
                i = int(idx)
            except Exception:
                i = -1
            if 0 <= i < len(actions):
                actions[i][1]()
        if self._show_bottom_sheet_picker(f'Шаг 5/5 · {gift_title}', labels, _pick):
            return
        activity = self._get_activity()
        if activity is None:
            BulletinHelper.show_error('Не удалось открыть подтверждение NFT')
            return
        builder = AlertDialogBuilder(activity)
        builder.set_title(f'Шаг 5/5 · Подтверждение ({gift_title})')
        builder.set_message(f'Направление: {direction}\nМодель: {model_name}\nУзор: {pattern_name}\nФон: {backdrop_name}\nНомер: {number}')
        builder.set_positive_button('Вставить NFT', lambda dialog, which: self._inject_selected_nft(state))
        builder.set_neutral_button('Изменить номер', lambda dialog, which: self._show_number_input(state))
        builder.set_negative_button('Отмена', lambda dialog, which: dialog.dismiss())
        builder.show()

    def _describe_attr(self, obj: Any, index: int) -> str:
        try:
            name = str(self._get_any_field_value(obj, 'name', 'title') or '').strip()
        except Exception:
            name = ''
        if not name:
            name = f'Вариант {int(index)}'
        return name

    def _default_nft_number(self, item: Dict[str, Any]) -> int:
        base = self._to_int_safe(item.get('id', 0), 0)
        if base > 0:
            return max(1, 500 + base % 9500)
        return random.randint(1, 9999)

    def _inject_selected_nft(self, state: Dict[str, Any], quiet: bool=False):
        try:
            account = int(state.get('account', 0))
            peer = int(state.get('peer', 0))
            is_outgoing = bool(state.get('is_outgoing', True))
            message = self._create_fake_gift_message(account, peer, state, is_outgoing)
            put_ok = self._store_and_refresh_message(account, peer, message)
            if bool(put_ok):
                self._remove_persisted_entry_for_state(state)
            if not quiet and bool(self.get_setting(self.KEEP_NFT_IN_CHAT_KEY, True)) and (not bool(put_ok)):
                self._append_persisted_entry_for_state(state)
        except Exception as e:
            log(f'[{__id__}] inject error: {e}\n{traceback.format_exc()}')
            if not quiet:
                BulletinHelper.show_error(f'Не удалось вставить NFT: {e}')

    def _create_fake_gift_message(self, account: int, peer: int, state: Dict[str, Any], is_outgoing: bool):
        msg = self._build_service_message_instance()
        current_user_config = UserConfig.getInstance(account)
        current_time = int(time.time())
        message_id = int(current_user_config.getNewMessageId())
        current_user_config.saveConfig(False)
        peer_obj = self._build_peer_obj(account, peer)
        self_peer = self._build_self_peer(account)
        self._set_any_field(msg, ['id', 'local_id', 'localId'], message_id)
        self._set_any_field(msg, ['date'], current_time)
        self._set_any_field(msg, ['dialog_id', 'dialogId'], int(peer))
        self._set_any_field(msg, ['message'], '')
        self._set_any_field(msg, ['out'], bool(is_outgoing))
        self._set_any_field(msg, ['unread'], not bool(is_outgoing))
        self._set_any_field(msg, ['media_unread', 'mediaUnread'], False)
        self._set_any_field(msg, ['mentioned'], False)
        self._set_any_field(msg, ['peer_id', 'peer'], peer_obj)
        self._set_any_field(msg, ['from_id', 'fromId'], self_peer if is_outgoing else peer_obj)
        self._set_any_field(msg, ['post'], False)
        self._set_any_field(msg, ['legacy'], False)
        try:
            current_flags = self._to_int_safe(self._get_any_field_value(msg, 'flags'), 0)
            current_flags |= 1 << 8
            self._set_any_field(msg, ['flags'], current_flags)
        except Exception:
            pass
        action = self._build_star_gift_action(state, account, peer, is_outgoing, self_peer, peer_obj, current_time)
        if not self._set_any_field(msg, ['action'], action):
            raise RuntimeError('Не удалось привязать NFT action к сообщению')
        return msg

    def _build_star_gift_action(self, state: Dict[str, Any], account: int, peer: int, is_outgoing: bool, self_peer: Any, peer_obj: Any, event_date: int):
        item = state.get('item', {}) or {}
        if self._is_regular_catalog_item(item):
            return self._build_regular_star_gift_action(state, account, peer, is_outgoing, self_peer, peer_obj)
        sender_peer = self_peer if is_outgoing else peer_obj
        target_peer = peer_obj if is_outgoing else self_peer
        owner_peer = target_peer if is_outgoing else None
        sender_name = self._resolve_peer_display_name(account, self._get_self_id(account) if is_outgoing else int(peer))
        gift = self._build_collectible_gift_from_selection(state, owner_peer, sender_peer, target_peer, event_date, sender_name if not is_outgoing else None)
        action = self._new_java_instance_any((TLRPC, 'TL_messageActionStarGiftUnique'), (TLRPC, 'messageActionStarGiftUnique'), 'org.telegram.tgnet.TLRPC$TL_messageActionStarGiftUnique', 'org.telegram.tgnet.TLRPC$messageActionStarGiftUnique', 'org.telegram.tgnet.tl.TL_stars$TL_messageActionStarGiftUnique', 'org.telegram.tgnet.tl.TL_stars$messageActionStarGiftUnique')
        if action is None:
            action = self._instantiate_discovered_tl_class(['action', 'gift', 'unique'], ['saved', 'sheet', 'cell', 'button', 'adapter', 'builder', 'controller', 'menu'], ['star', 'message'])
        if action is None:
            raise RuntimeError('Не найден TL класс action для NFT')
        if not self._set_any_field(action, ['gift', 'starGift', 'uniqueGift', 'currentGift'], gift):
            raise RuntimeError('Не удалось привязать collectible NFT к action')
        flags = self._to_int_safe(self._get_any_field_value(action, 'flags'), 0)
        self._set_any_field(action, ['upgrade'], False)
        self._set_any_field(action, ['saved'], False)
        self._set_any_field(action, ['refunded'], False)
        self._set_any_field(action, ['prepaid_upgrade', 'prepaidUpgrade'], False)
        flags |= 1 << 1
        self._set_any_field(action, ['transferred'], True)
        is_private_dialog = int(peer) > 0
        if not is_private_dialog:
            if sender_peer is not None and self._set_any_field(action, ['from_id', 'fromId', 'sender', 'senderId'], sender_peer):
                flags |= 1 << 6
            if target_peer is not None and self._set_any_field(action, ['peer', 'to_id', 'toId', 'recipient', 'recipientId'], target_peer):
                flags |= 1 << 7
        self._set_any_field(action, ['flags'], int(flags))
        return action

    def _build_regular_star_gift_action(self, state: Dict[str, Any], account: int, peer: int, is_outgoing: bool, self_peer: Any, peer_obj: Any):
        sender_peer = self_peer if is_outgoing else peer_obj
        target_peer = peer_obj if is_outgoing else self_peer
        gift = self._build_regular_gift_from_selection(state)
        action = self._new_java_instance_any((TLRPC, 'TL_messageActionStarGift'), (TLRPC, 'messageActionStarGift'), 'org.telegram.tgnet.TLRPC$TL_messageActionStarGift', 'org.telegram.tgnet.TLRPC$messageActionStarGift', 'org.telegram.tgnet.tl.TL_stars$TL_messageActionStarGift', 'org.telegram.tgnet.tl.TL_stars$messageActionStarGift')
        if action is None:
            action = self._instantiate_discovered_tl_class(['action', 'gift'], ['unique', 'saved', 'sheet', 'cell', 'button', 'adapter', 'builder', 'controller', 'menu'], ['star', 'message'])
        if action is None:
            raise RuntimeError('Не найден TL класс action для обычного подарка')
        if not self._set_any_field(action, ['gift', 'starGift', 'currentGift'], gift):
            raise RuntimeError('Не удалось привязать обычный подарок к action')
        flags = self._to_int_safe(self._get_any_field_value(action, 'flags'), 0)
        self._set_any_field(action, ['saved'], False)
        self._set_any_field(action, ['refunded'], False)
        self._set_any_field(action, ['name_hidden', 'nameHidden'], False)
        self._set_any_field(action, ['transferred'], True)
        comment = str(state.get('gift_comment', '') or '').strip()
        if comment:
            twe = self._build_plain_text_with_entities(comment)
            if twe is not None and self._set_any_field(action, ['message'], twe):
                flags |= 1 << 1
        is_private_dialog = int(peer) > 0
        if not is_private_dialog:
            if sender_peer is not None and self._set_any_field(action, ['from_id', 'fromId', 'sender', 'senderId'], sender_peer):
                flags |= 1 << 6
            if target_peer is not None and self._set_any_field(action, ['peer', 'to_id', 'toId', 'recipient', 'recipientId'], target_peer):
                flags |= 1 << 7
        self._set_any_field(action, ['flags'], int(flags))
        return action

    def _build_plain_text_with_entities(self, text: str) -> Any:
        text = (text or '').strip()
        if not text:
            return None
        obj = self._new_java_instance_any((TLRPC, 'TL_textWithEntities'), (TLRPC, 'textWithEntities'), 'org.telegram.tgnet.TLRPC$TL_textWithEntities', 'org.telegram.tgnet.TLRPC$textWithEntities', 'org.telegram.tgnet.tl.TL_stars$TL_textWithEntities')
        if obj is None:
            return None
        if not self._set_any_field(obj, ['text'], str(text)):
            return None
        try:
            self._set_any_field(obj, ['entities'], ArrayList())
        except Exception:
            pass
        return obj

    def _extract_gift_comment_line(self, action_obj: Any) -> str:
        try:
            if action_obj is None:
                return ''
            tw = self._get_any_field_value(action_obj, 'message')
            if tw is None:
                return ''
            t = self._get_any_field_value(tw, 'text')
            if t is None:
                return ''
            return str(t).strip()
        except Exception:
            return ''

    def _build_regular_gift_from_selection(self, state: Dict[str, Any]):
        item = state.get('item', {}) or {}
        source_gift = item.get('_source_obj')
        if source_gift is None:
            raise RuntimeError('Не найден runtime объект обычного подарка')
        return source_gift

    def _build_collectible_gift_from_selection(self, state: Dict[str, Any], owner_peer: Any, sender_peer: Any=None, recipient_peer: Any=None, event_date: int=0, original_sender_name: str=None):
        item = state.get('item', {})
        source_gift = item.get('_source_obj')
        if source_gift is None:
            raise RuntimeError('Не найден runtime объект подарка')
        unique = self._new_java_instance_any((TLRPC, 'TL_starGiftUnique'), (TLRPC, 'StarGiftUnique'), (TLRPC, 'starGiftUnique'), 'org.telegram.tgnet.tl.TL_stars$TL_starGiftUnique', 'org.telegram.tgnet.tl.TL_stars$StarGiftUnique', 'org.telegram.tgnet.tl.TL_stars$starGiftUnique', 'org.telegram.tgnet.TLRPC$TL_starGiftUnique', 'org.telegram.tgnet.TLRPC$StarGiftUnique', 'org.telegram.tgnet.TLRPC$starGiftUnique')
        if unique is None:
            unique = self._instantiate_discovered_tl_class(['gift', 'unique'], ['saved', 'message', 'media', 'sheet', 'cell', 'button', 'adapter', 'builder', 'controller', 'menu', 'action'], ['star'])
        if unique is None:
            raise RuntimeError('Не найден TL класс collectible NFT')
        base_id = self._resolve_base_gift_id(source_gift, item)
        if base_id <= 0:
            raise RuntimeError('Не удалось определить base gift id')
        base_title = self._get_runtime_title(source_gift)
        base_slug = self._get_runtime_slug(source_gift)
        nft_num = self._to_int_safe(state.get('number', 0), 0)
        if nft_num <= 0:
            nft_num = self._default_nft_number(item)
        models = state.get('models') or []
        patterns = state.get('patterns') or []
        backdrops = state.get('backdrops') or []
        model = models[int(state.get('model_index', 0)) % len(models)] if models else None
        pattern = patterns[int(state.get('pattern_index', 0)) % len(patterns)] if patterns else None
        backdrop = backdrops[int(state.get('backdrop_index', 0)) % len(backdrops)] if backdrops else None
        if model is None or backdrop is None:
            raise RuntimeError('Не выбран полный набор NFT атрибутов')
        attrs = ArrayList()
        attrs.add(model)
        if pattern is not None:
            attrs.add(pattern)
        attrs.add(backdrop)
        original_details = self._build_original_details_attr(sender_peer, recipient_peer, int(event_date or time.time()))
        if original_details is not None:
            try:
                attrs.add(original_details)
            except Exception:
                pass
        model_doc = self._get_attr_document(model)
        pattern_doc = self._get_attr_document(pattern)
        best_doc = self._pick_best_document(model_doc, self._get_any_field_value(source_gift, 'document', 'sticker', 'model_document', 'modelDocument'))
        generated_unique_id = int(time.time() * 1000) << 8 ^ random.randint(1, 2147483647)
        availability_total = max(1000, self._to_int_safe(self._get_any_field_value(source_gift, 'availability_total', 'availabilityTotal', 'limited_count', 'limitedCount'), 1000))
        availability_total = max(availability_total, nft_num + 50)
        availability_issued = max(1, min(availability_total, nft_num))
        self._set_any_field(unique, ['id'], generated_unique_id)
        self._set_any_field(unique, ['gift_id', 'giftId', 'giftID'], int(base_id))
        self._set_any_field(unique, ['title'], str(base_title or 'NFT'))
        self._set_any_field(unique, ['slug'], f'{self._sanitize_slug(base_slug or base_title)}-{int(nft_num)}')
        self._set_any_field(unique, ['num'], int(nft_num))
        self._set_any_field(unique, ['attributes'], attrs)
        self._set_any_field(unique, ['availability_total', 'availabilityTotal', 'total', 'total_count', 'totalCount'], int(availability_total))
        self._set_any_field(unique, ['availability_issued', 'availabilityIssued', 'issued', 'issued_count', 'issuedCount'], int(availability_issued))
        self._set_any_field(unique, ['limited_count', 'limitedCount'], int(availability_total))
        if best_doc is not None:
            self._set_any_field(unique, ['document', 'sticker'], best_doc)
        if model_doc is not None:
            self._set_any_field(unique, ['model_document', 'modelDocument'], model_doc)
        if pattern_doc is not None:
            self._set_any_field(unique, ['pattern_document', 'patternDocument'], pattern_doc)
        flags = 0
        if owner_peer is not None and self._set_any_field(unique, ['owner_id', 'owner', 'ownerId'], owner_peer):
            flags |= 1
        if original_sender_name and self._set_any_field(unique, ['owner_name', 'ownerName', 'gift_owner_name', 'giftOwnerName'], str(original_sender_name)):
            flags |= 1 << 1
        released_by = self._get_any_field_value(source_gift, 'released_by', 'releasedBy', 'release_peer', 'releasePeer', 'issuer', 'issuer_peer', 'issuerPeer', 'publisher', 'publisherPeer')
        if released_by is not None and self._set_any_field(unique, ['released_by', 'releasedBy'], released_by):
            flags |= 1 << 5
        if bool(self._get_any_field_value(source_gift, 'require_premium', 'requirePremium')):
            self._set_any_field(unique, ['require_premium', 'requirePremium'], True)
            flags |= 1 << 6
        if bool(self._get_any_field_value(source_gift, 'theme_available', 'themeAvailable')):
            self._set_any_field(unique, ['theme_available', 'themeAvailable'], True)
            flags |= 1 << 9
        theme_peer = self._get_any_field_value(source_gift, 'theme_peer', 'themePeer')
        if theme_peer is not None and self._set_any_field(unique, ['theme_peer', 'themePeer'], theme_peer):
            flags |= 1 << 10
        if original_sender_name:
            self._set_any_field(unique, ['from_name', 'fromName', 'sender_name', 'senderName'], str(original_sender_name))
        self._set_any_field(unique, ['flags'], int(flags))
        return unique

    def _store_and_refresh_message(self, account: int, peer: int, message: Any) -> bool:
        mc = MessagesController.getInstance(account)
        message_object = MessageObject(account, message, False, True)
        self._patch_fake_message_visual(account, peer, message, message_object)
        put_ok = False
        try:
            list_msg = ArrayList()
            list_msg.add(message)
            MessagesStorage.getInstance(account).putMessages(list_msg, True, True, False, 0, 0, 0)
            put_ok = True
        except Exception as e:
            log(f'[{__id__}] putMessages: {e}')
        try:
            dialog_list = mc.dialogMessage.get(int(peer))
        except Exception:
            dialog_list = None
        if dialog_list is None:
            dialog_list = ArrayList()
        try:
            dialog_list.add(0, message_object)
            mc.dialogMessage.put(int(peer), dialog_list)
        except Exception as e:
            log(f'[{__id__}] dialog cache warning: {e}')
        try:
            mc.dialogMessagesByIds.put(int(message_object.getId()), message_object)
        except Exception as e:
            log(f'[{__id__}] ids cache warning: {e}')
        self._remember_session_fake_id(int(peer), int(message.id))

        def _refresh_ui():
            try:
                mo_list = ArrayList()
                mo_list.add(message_object)
                mc.updateInterfaceWithMessages(int(peer), mo_list, 0)
            except Exception as e:
                log(f'[{__id__}] updateInterfaceWithMessages warning: {e}')
            try:
                NotificationCenter.getInstance(account).postNotificationName(NotificationCenter.dialogsNeedReload)
            except Exception as e:
                log(f'[{__id__}] dialogsNeedReload warning: {e}')
        run_on_ui_thread(_refresh_ui)
        return bool(put_ok)

    def _patch_fake_message_visual(self, account: int, peer: int, message: Any, message_object: Any):
        try:
            is_outgoing = bool(self._get_any_field_value(message, 'out'))
            peer_name = self._resolve_peer_display_name(account, int(peer))
            owner = self._get_any_field_value(message_object, 'messageOwner')
            self._hide_service_time_visuals(message_object, owner or message, incoming=not is_outgoing)
            action_obj = self._get_any_field_value(owner or message, 'action')
            action_name = self._class_name_lower(action_obj)
            is_regular = 'stargift' in action_name and 'unique' not in action_name
            stars = self._stars_from_star_gift_action(action_obj) if is_regular else 0
            if is_outgoing:
                service_text = self._build_outgoing_regular_service_text(stars) if is_regular else self._build_outgoing_service_text()
                self._set_any_field(message, ['message'], service_text)
                self._set_any_field(message_object, ['messageText', 'messageTextShort'], service_text)
                if owner is not None:
                    self._set_any_field(owner, ['message'], service_text)
            else:
                patched_text = self._build_incoming_regular_service_text(peer_name, stars) if is_regular else self._build_incoming_service_text(peer_name)
                self._set_any_field(message, ['message'], patched_text)
                self._set_any_field(message_object, ['messageText', 'messageTextShort'], patched_text)
                if owner is not None:
                    self._set_any_field(owner, ['message'], patched_text)
                try:
                    self._set_any_field(message_object, ['localName', 'customName'], str(peer_name))
                except Exception:
                    pass
        except Exception as e:
            log(f'[{__id__}] visual patch warning: {e}')

    def _build_outgoing_service_text(self) -> str:
        return 'Вы передали уникальный коллекционный\nNFT'

    def _build_incoming_service_text(self, peer_name: str) -> str:
        return f'{peer_name} передал(а) вам уникальный коллекционный NFT'

    def _get_app_locale_lang(self) -> str:
        try:
            from org.telegram.messenger import LocaleController
            loc = LocaleController.getInstance()
            if loc is not None and loc.getCurrentLocale() is not None:
                l = (loc.getCurrentLocale().getLanguage() or 'en').lower()
                if l.startswith('zh_hans') or l == 'zh':
                    return 'zh'
                if l.startswith('pt'):
                    return 'pt'
                return l[:2]
        except Exception:
            pass
        return 'en'

    def _format_stars_count_label(self, count: int, lang: Optional[str]=None) -> str:
        n = int(max(0, count))
        if n < 0:
            n = 0
        if lang is not None and str(lang).strip():
            raw = str(lang).strip().lower()
            if raw.startswith('zh'):
                eff = 'zh'
            elif raw.startswith('pt'):
                eff = 'pt'
            else:
                eff = raw[:2] if len(raw) >= 2 else raw or 'en'
        else:
            eff = self._get_app_locale_lang()
        if eff in ('ru', 'be'):
            mod100, mod10 = (n % 100, n % 10)
            if mod10 == 1 and mod100 != 11:
                w = 'звезда'
            elif 2 <= mod10 <= 4 and mod100 not in (12, 13, 14):
                w = 'звезды'
            else:
                w = 'звёзд'
            return f'{n} {w}'
        if eff == 'uk':
            mod100, mod10 = (n % 100, n % 10)
            if mod10 == 1 and mod100 != 11:
                w = 'зірка'
            elif 2 <= mod10 <= 4 and mod100 not in (12, 13, 14):
                w = 'зірки'
            else:
                w = 'зірок'
            return f'{n} {w}'
        if eff == 'de':
            w = 'Stern' if n == 1 else 'Sterne'
            return f'{n} {w}'
        if eff == 'it':
            w = 'stella' if n == 1 else 'stelle'
            return f'{n} {w}'
        if eff == 'tr':
            return f'{n} yıldız'
        if eff in ('es', 'ca', 'gl', 'eu'):
            w = 'estrella' if n == 1 else 'estrellas'
            return f'{n} {w}'
        if eff == 'pt':
            w = 'estrela' if n == 1 else 'estrelas'
            return f'{n} {w}'
        if eff == 'fr':
            w = 'étoile' if n == 1 else 'étoiles'
            return f'{n} {w}'
        if eff == 'pl':
            mod100, mod10 = (n % 100, n % 10)
            if n == 1 and mod100 != 11:
                w = 'gwiazda'
            elif 2 <= mod10 <= 4 and mod100 not in (12, 13, 14):
                w = 'gwiazdy'
            else:
                w = 'gwiazd'
            return f'{n} {w}'
        if eff == 'ja':
            return f'{n} スター'
        if eff == 'ko':
            return f'{n} 별'
        if eff == 'vi':
            return f'{n} sao'
        if eff == 'zh':
            return f'{n} 颗星'
        if eff == 'ar':
            w = 'نجمة' if n == 1 else 'نجوم'
            return f'{n} {w}'
        if eff in ('fa', 'he', 'ur'):
            w = 'star' if n == 1 else 'stars'
            return f'{n} {w}'
        if eff == 'en':
            w = 'Star' if n == 1 else 'Stars'
            return f'{n} {w}'
        w = 'star' if n == 1 else 'stars'
        return f'{n} {w}'

    def _regular_gift_dialog_title(self) -> str:
        lang = self._get_app_locale_lang()
        m = {'ru': 'Подарок', 'en': 'Gift', 'uk': 'Подарунок', 'be': 'Падарунак', 'de': 'Geschenk', 'es': 'Regalo', 'fr': 'Cadeau', 'it': 'Regalo', 'pt': 'Presente', 'pl': 'Prezent', 'ja': 'ギフト', 'zh': '礼物'}
        return m.get(lang, m['en'])

    def _gift_price_line(self, stars: int, lang: Optional[str]=None) -> str:
        s = int(self._to_int_safe(stars, 0) or 0)
        eff = lang if lang is not None and str(lang).strip() else self._get_app_locale_lang()
        label = self._format_stars_count_label(s, eff) if s > 0 else '—'
        m = {'ru': f'Цена: {label}', 'en': f'Price: {label}', 'uk': f'Ціна: {label}', 'be': f'Кошт: {label}', 'de': f'Preis: {label}', 'es': f'Precio: {label}', 'fr': f'Prix : {label}', 'it': f'Prezzo: {label}', 'pt': f'Preço: {label}', 'pl': f'Cena: {label}', 'ja': f'価格: {label}', 'zh': f'价格: {label}'}
        key = eff if isinstance(eff, str) else 'en'
        if key.startswith('zh'):
            key = 'zh'
        elif key.startswith('pt'):
            key = 'pt'
        else:
            key = (key[:2] if len(key) >= 2 else key) if key else 'en'
        return m.get(key, m['en'])

    def _regular_out_text(self, stars: int) -> str:
        n = int(stars or 0)
        lang = self._get_app_locale_lang()
        label = self._format_stars_count_label(n, lang)
        if n <= 0:
            m = {'ru': 'Вы отправили подарок', 'be': 'Вы адправілі падарунак', 'uk': 'Ви надіслали подарунок', 'en': 'You sent a gift', 'de': 'Du hast ein Geschenk gesendet', 'es': 'Enviaste un regalo', 'fr': 'Vous avez envoyé un cadeau', 'it': 'Hai inviato un regalo', 'pt': 'Você enviou um presente', 'pl': 'Wysłano prezent', 'ja': 'ギフトを送信しました', 'zh': '你发送了礼物'}
            return m.get(lang, m['en'])
        m = {'ru': f'Вы отправили подарок за {label}', 'be': f'Вы адправілі падарунак за {label}', 'uk': f'Ви надіслали подарунок за {label}', 'en': f'You sent a gift for {label}', 'de': f'Du hast ein Geschenk für {label} gesendet', 'es': f'Enviaste un regalo por {label}', 'fr': f'Vous avez envoyé un cadeau pour {label}', 'it': f'Hai inviato un regalo per {label}', 'pt': f'Você enviou um presente por {label}', 'pl': f'Wysłano prezent za {label}', 'ja': f'{label}のギフトを贈りました', 'zh': f'你发送了{label}的礼物'}
        if lang in m:
            return m[lang]
        if lang in ('ca', 'gl'):
            return f'Enviaste un regalo por {label}'
        return m['en']

    def _regular_in_text(self, peer_name: str, stars: int) -> str:
        n = int(stars or 0)
        lang = self._get_app_locale_lang()
        label = self._format_stars_count_label(n, lang)
        if n <= 0:
            m = {'ru': f'{peer_name} отправил(а) вам подарок', 'be': f'{peer_name} адправіў(ла) вам падарунак', 'uk': f'{peer_name} надіслав(ла) вам подарунок', 'en': f'{peer_name} sent you a gift', 'de': f'{peer_name} hat dir ein Geschenk geschickt', 'es': f'{peer_name} te envió un regalo', 'fr': f'{peer_name} t’a envoyé un cadeau', 'it': f'{peer_name} ti ha inviato un regalo', 'pt': f'{peer_name} enviou-lhe um presente', 'pl': f'{peer_name} wysłał(a) ci prezent', 'ja': f'{peer_name}がギフトを贈りました', 'zh': f'{peer_name} 送了你一份礼物'}
            return m.get(lang, m['en'])
        m = {'ru': f'{peer_name} отправил(а) вам подарок за {label}', 'be': f'{peer_name} адправіў(ла) вам падарунак за {label}', 'uk': f'{peer_name} надіслав(ла) вам подарунок за {label}', 'en': f'{peer_name} sent you a gift for {label}', 'de': f'{peer_name} hat dir ein Geschenk für {label} geschickt', 'es': f'{peer_name} te envió un regalo por {label}', 'fr': f'{peer_name} t’a envoyé un cadeau pour {label}', 'it': f'{peer_name} ti ha inviato un regalo per {label}', 'pt': f'{peer_name} enviou-lhe um presente por {label}', 'pl': f'{peer_name} wysłał(a) ci prezent za {label}', 'ja': f'{peer_name}が{label}のギフトを贈りました', 'zh': f'{peer_name} 给你发了{label}的礼物'}
        if lang in m:
            return m[lang]
        if lang in ('ca', 'gl'):
            return f'{peer_name} te envió un regalo por {label}'
        return m['en']

    def _stars_from_star_gift_action(self, action_obj: Any) -> int:
        if action_obj is None:
            return 0
        gift = self._get_any_field_value(action_obj, 'gift', 'star_gift', 'stargift', 'starGift')
        if gift is None:
            return 0
        return int(self._get_runtime_stars(gift))

    def _build_outgoing_regular_service_text(self, stars: int) -> str:
        return self._regular_out_text(int(stars or 0))

    def _build_incoming_regular_service_text(self, peer_name: str, stars: int) -> str:
        return self._regular_in_text(str(peer_name), int(stars or 0))

    def _hide_service_time_visuals(self, message_object: Any, owner: Any, incoming: bool=False):
        try:
            targets = [obj for obj in (message_object, owner) if obj is not None]
            for target in targets:
                self._set_any_field(target, ['notime', 'noTime', 'hideTime', 'hide_time', 'withoutTime', 'drawWithoutTime', 'draw_time'], True)
                self._set_any_field(target, ['forceUpdate'], True)
                self._set_any_field(target, ['dateText', 'customDateText', 'timeText'], '')
            if incoming and message_object is not None:
                self._set_any_field(message_object, ['messageTextShort'], self._get_any_field_value(message_object, 'messageText') or '')
        except Exception as e:
            log(f'[{__id__}] hide time warning: {e}')

    def _build_original_details_attr(self, sender_peer: Any, recipient_peer: Any, event_date: int):
        attr = self._new_java_instance_any((TLRPC, 'TL_starGiftAttributeOriginalDetails'), (TLRPC, 'starGiftAttributeOriginalDetails'), 'org.telegram.tgnet.tl.TL_stars$TL_starGiftAttributeOriginalDetails', 'org.telegram.tgnet.tl.TL_stars$starGiftAttributeOriginalDetails', 'org.telegram.tgnet.TLRPC$TL_starGiftAttributeOriginalDetails', 'org.telegram.tgnet.TLRPC$starGiftAttributeOriginalDetails')
        if attr is None:
            return None
        flags = self._to_int_safe(self._get_any_field_value(attr, 'flags'), 0)
        if sender_peer is not None and self._set_any_field(attr, ['sender_id', 'senderId'], sender_peer):
            flags |= 1
        if recipient_peer is not None:
            self._set_any_field(attr, ['recipient_id', 'recipientId'], recipient_peer)
        self._set_any_field(attr, ['date'], int(event_date or time.time()))
        self._set_any_field(attr, ['flags'], int(flags))
        return attr

    def _get_self_id(self, account: int) -> int:
        try:
            return int(UserConfig.getInstance(account).getClientUserId())
        except Exception:
            return 0

    def _resolve_peer_display_name(self, account: int, peer: int) -> str:
        try:
            mc = MessagesController.getInstance(account)
        except Exception:
            mc = None
        try:
            if int(peer) > 0 and mc is not None:
                user = mc.getUser(int(peer))
                if user is not None:
                    first_name = str(self._get_any_field_value(user, 'first_name', 'firstName') or '').strip()
                    last_name = str(self._get_any_field_value(user, 'last_name', 'lastName') or '').strip()
                    username = str(self._get_any_field_value(user, 'username') or '').strip()
                    full = (first_name + ' ' + last_name).strip()
                    if full:
                        return full
                    if username:
                        return username
        except Exception:
            pass
        try:
            if int(peer) <= 0 and mc is not None:
                chat = mc.getChat(abs(int(peer)))
                if chat is not None:
                    title = str(self._get_any_field_value(chat, 'title', 'name') or '').strip()
                    if title:
                        return title
        except Exception:
            pass
        try:
            me_id = self._get_self_id(account)
            if int(peer) == int(me_id) and mc is not None:
                me = mc.getUser(int(me_id))
                if me is not None:
                    first_name = str(self._get_any_field_value(me, 'first_name', 'firstName') or '').strip()
                    last_name = str(self._get_any_field_value(me, 'last_name', 'lastName') or '').strip()
                    full = (first_name + ' ' + last_name).strip()
                    if full:
                        return full
        except Exception:
            pass
        return 'Пользователь' if int(peer) > 0 else 'Чат'

    def _clear_current_chat(self, account: int, peer: int):
        self._remove_persisted_for_account_peer(int(account), int(peer))
        removed_session = self._clear_session_fake_messages(account, peer)
        removed_legacy = self._purge_legacy_for_peer(account, peer)
        if removed_session or removed_legacy:
            BulletinHelper.show_success('вставки NFT в этом чате очищены')
        else:
            BulletinHelper.show_success('в этом чате нет вставок NFT от плагина')

    def _clear_session_fake_messages(self, account: int, peer: int) -> bool:
        peer = int(peer)
        ids = list(self._session_fake_ids.get(peer, []))
        if not ids:
            return False
        mc = MessagesController.getInstance(account)
        try:
            for mid in ids:
                try:
                    mc.dialogMessagesByIds.remove(int(mid))
                except Exception:
                    pass
        except Exception as e:
            log(f'[{__id__}] clear ids cache warning: {e}')
        try:
            dialog_list = mc.dialogMessage.get(peer)
            if dialog_list is not None:
                i = 0
                while i < dialog_list.size():
                    try:
                        obj = dialog_list.get(i)
                    except Exception:
                        break
                    msg_id = None
                    try:
                        msg_id = int(obj.getId()) if hasattr(obj, 'getId') else int(getattr(obj, 'id'))
                    except Exception:
                        msg_id = None
                    if msg_id is not None and msg_id in ids:
                        dialog_list.remove(i)
                        continue
                    i += 1
                mc.dialogMessage.put(peer, dialog_list)
        except Exception as e:
            log(f'[{__id__}] clear dialog cache warning: {e}')

        def _refresh_ui():
            try:
                mc.updateInterfaceWithMessages(peer, ArrayList(), 0)
            except Exception as e:
                log(f'[{__id__}] clear updateInterfaceWithMessages warning: {e}')
            try:
                NotificationCenter.getInstance(account).postNotificationName(NotificationCenter.dialogsNeedReload)
            except Exception as e:
                log(f'[{__id__}] clear dialogsNeedReload warning: {e}')
        run_on_ui_thread(_refresh_ui)
        self._session_fake_ids[peer] = []
        return True

    def _remember_session_fake_id(self, peer: int, message_id: int):
        peer = int(peer)
        message_id = int(message_id)
        current = self._session_fake_ids.get(peer)
        if current is None:
            current = []
            self._session_fake_ids[peer] = current
        if message_id not in current:
            current.append(message_id)

    def _load_persisted_list(self) -> List[Dict[str, Any]]:
        try:
            raw = self.get_setting(self.PERSISTED_NFT_KEY, '[]')
            if isinstance(raw, list):
                return [x for x in raw if isinstance(x, dict)]
            parsed = json.loads(str(raw or '[]'))
            if not isinstance(parsed, list):
                return []
            return [x for x in parsed if isinstance(x, dict)]
        except Exception as e:
            log(f'[{__id__}] load persisted list: {e}')
            return []

    def _save_persisted_list(self, data: List[Dict[str, Any]]) -> None:
        try:
            self.set_setting(self.PERSISTED_NFT_KEY, json.dumps(data, ensure_ascii=False))
        except Exception as e:
            log(f'[{__id__}] save persisted list: {e}\n{traceback.format_exc()}')

    def _state_to_persisted_entry(self, state: Dict[str, Any]) -> Optional[Dict[str, Any]]:
        try:
            account = int(state.get('account', 0) or 0)
            peer = int(state.get('peer', 0) or 0)
            if peer <= 0:
                return None
            item = state.get('item', {}) or {}
            gid = int(self._to_int_safe(item.get('id', 0), 0))
            if gid <= 0:
                return None
            is_out = bool(state.get('is_outgoing', True))
            gcom = str(state.get('gift_comment', '') or '').strip()
            if self._is_regular_catalog_item(item):
                return {'v': 1, 'kind': 'regular', 'account': account, 'peer': peer, 'is_outgoing': is_out, 'gift_id': gid, 'gift_comment': gcom}
            return {'v': 1, 'kind': 'unique', 'account': account, 'peer': peer, 'is_outgoing': is_out, 'gift_id': gid, 'gift_comment': gcom, 'model_index': int(state.get('model_index', 0) or 0), 'pattern_index': int(state.get('pattern_index', 0) or 0), 'backdrop_index': int(state.get('backdrop_index', 0) or 0), 'number': int(self._to_int_safe(state.get('number', 0), 0) or 0)}
        except Exception as e:
            log(f'[{__id__}] state to persisted: {e}\n{traceback.format_exc()}')
            return None

    def _append_persisted_entry_for_state(self, state: Dict[str, Any]) -> None:
        entry = self._state_to_persisted_entry(state)
        if not entry:
            return
        data = self._load_persisted_list()
        data.append(entry)
        self._save_persisted_list(data)

    def _entry_matches_state(self, e: Dict[str, Any], state: Dict[str, Any]) -> bool:
        try:
            if int(e.get('account', -1)) != int(state.get('account', 0) or 0):
                return False
            if int(e.get('peer', 0) or 0) != int(state.get('peer', 0) or 0):
                return False
            item = state.get('item', {}) or {}
            if int(self._to_int_safe(e.get('gift_id', 0), 0)) != int(self._to_int_safe(item.get('id', 0), 0)):
                return False
            if str(e.get('gift_comment', '') or '').strip() != str(state.get('gift_comment', '') or '').strip():
                return False
            is_reg = self._is_regular_catalog_item(item)
            if (e.get('kind') == 'regular') != is_reg:
                return False
            if not is_reg:
                if int(self._to_int_safe(e.get('number', 0), 0) or 0) != int(self._to_int_safe(state.get('number', 0), 0) or 0):
                    return False
            return True
        except Exception:
            return False

    def _remove_persisted_entry_for_state(self, state: Dict[str, Any]) -> None:
        data = self._load_persisted_list()
        new = [e for e in data if not self._entry_matches_state(e, state)]
        if len(new) == len(data):
            return
        self._save_persisted_list(new)

    def _remove_persisted_for_account_peer(self, account: int, peer: int) -> None:
        account, peer = (int(account), int(peer))
        data = self._load_persisted_list()
        new = [e for e in data if not (int(self._to_int_safe(e.get('account', -1), -1)) == account and int(self._to_int_safe(e.get('peer', 0), 0) or 0) == peer)]
        if len(new) != len(data):
            self._save_persisted_list(new)

    def _find_catalog_item_by_id(self, account: int, gift_id: int) -> Optional[Dict[str, Any]]:
        account = int(account)
        gift_id = int(gift_id)
        for it in self._get_runtime_catalog(account, refresh=False):
            if int(self._to_int_safe((it or {}).get('id', 0), 0)) == gift_id:
                return it
        for it in self._get_runtime_catalog(account, refresh=True):
            if int(self._to_int_safe((it or {}).get('id', 0), 0)) == gift_id:
                return it
        return None

    def _rebuild_state_regular_from_persisted(self, default_account: int, entry: Dict[str, Any]) -> Optional[Dict[str, Any]]:
        account = int(self._to_int_safe(entry.get('account', default_account), default_account) or default_account)
        peer = int(entry.get('peer', 0) or 0)
        gift_id = int(entry.get('gift_id', 0) or 0)
        if peer <= 0 or gift_id <= 0:
            return None
        item = self._find_catalog_item_by_id(account, gift_id)
        if item is None:
            log(f'[{__id__}] restore regular: нет в каталоге gift_id={gift_id} acc={account}')
            return None
        return {'account': account, 'peer': peer, 'is_outgoing': bool(entry.get('is_outgoing', True)), 'item': item, 'gift_comment': str(entry.get('gift_comment', '') or '').strip()}

    def _rebuild_state_unique_from_persisted(self, account: int, peer: int, item: Dict[str, Any], is_out: bool, response: Any, entry: Dict[str, Any]) -> Optional[Dict[str, Any]]:
        models, patterns, backdrops = self._extract_attr_groups(response)
        if not models or not backdrops:
            log(f'[{__id__}] restore unique: пустой ответ атрибутов')
            return None
        n_models = len(models)
        n_pat = len(patterns) if patterns else 0
        n_back = len(backdrops)
        mi = int(entry.get('model_index', 0) or 0)
        if mi < 0 or mi >= n_models:
            mi = 0
        if n_pat > 0:
            pi = int(entry.get('pattern_index', 0) or 0)
            if pi < 0 or pi >= n_pat:
                pi = 0
        else:
            pi = 0
        bi = int(entry.get('backdrop_index', 0) or 0)
        if bi < 0 or bi >= n_back:
            bi = 0
        num = int(self._to_int_safe(entry.get('number', 0), 0) or 0)
        if num <= 0:
            num = int(self._default_nft_number(item) or 1)
        return {'account': int(account), 'peer': int(peer), 'is_outgoing': bool(is_out), 'item': item, 'response': response, 'models': models, 'patterns': patterns, 'backdrops': backdrops, 'model_index': mi, 'pattern_index': pi, 'backdrop_index': bi, 'number': int(num), 'gift_comment': str(entry.get('gift_comment', '') or '').strip()}

    def _restore_persisted_fakes_once(self) -> None:
        if not self._licensed():
            return
        if getattr(self, '_persist_restore_done', False):
            return
        if not bool(self.get_setting(self.KEEP_NFT_IN_CHAT_KEY, True)):
            self._persist_restore_done = True
            return
        self._persist_restore_done = True
        entries: List[Dict[str, Any]] = []
        try:
            entries = self._load_persisted_list()
        except Exception as e:
            log(f'[{__id__}] restore read list: {e}\n{traceback.format_exc()}')
            return
        if not entries:
            return
        try:
            self._load_catalog_silent(self._get_current_account())
        except Exception:
            pass
        default_acc = self._get_current_account()
        for e in entries:
            if e.get('kind') != 'regular':
                continue
            try:
                st = self._rebuild_state_regular_from_persisted(int(default_acc), e)
                if st:
                    self._inject_selected_nft(st, quiet=True)
            except Exception as ex:
                log(f'[{__id__}] restore regular failed: {ex}\n{traceback.format_exc()}')
        uniques = [e for e in entries if e.get('kind') == 'unique']
        if uniques:
            self._restore_unique_entries_sequentially(uniques, 0)

    def _send_star_gift_attributes_request(self, base_id: int, on_done, tag: str='nft_restore') -> bool:
        request_cls = None
        for cls_name in ('org.telegram.tgnet.tl.TL_stars$getStarGiftUpgradeAttributes', 'org.telegram.tgnet.tl.TL_stars$getStarGiftUpgradePreview'):
            try:
                request_cls = jclass(cls_name)
                break
            except Exception:
                request_cls = None
        if request_cls is None:
            log(f'[{__id__}] {tag}: нет TL-класса запроса атрибутов')
            run_on_ui_thread(lambda: on_done(None, RuntimeError('no request class')))
            return False
        try:
            req = request_cls()
            self._set_any_field(req, ['gift_id', 'giftId', 'id'], int(base_id))
        except Exception as e:
            log(f'[{__id__}] {tag} build req: {e}\n{traceback.format_exc()}')
            err = e
            run_on_ui_thread(lambda: on_done(None, err))
            return False

        def _on_done(response, error):

            def _finish():
                try:
                    self._pending_request_delegates = [cb for cb in getattr(self, '_pending_request_delegates', []) if cb is not delegate]
                except Exception:
                    pass
                on_done(response, error)
            run_on_ui_thread(_finish)
        delegate = REQUEST_DELEGATE_PROXY_CLASS(_on_done)
        try:
            self._pending_request_delegates.append(delegate)
        except Exception:
            self._pending_request_delegates = [delegate]
        try:
            get_connections_manager().sendRequest(req, delegate)
        except Exception as e:
            log(f'[{__id__}] {tag} send: {e}\n{traceback.format_exc()}')
            err = e
            run_on_ui_thread(lambda: on_done(None, err))
        return True

    def _restore_unique_entries_sequentially(self, entries: List[Dict[str, Any]], index: int) -> None:
        if index >= len(entries):
            return
        entry = entries[index]

        def _next():
            self._restore_unique_entries_sequentially(entries, index + 1)
        default_acc = self._get_current_account()
        account = int(self._to_int_safe(entry.get('account', default_acc), default_acc) or default_acc)
        peer = int(entry.get('peer', 0) or 0)
        gift_id = int(entry.get('gift_id', 0) or 0)
        if peer <= 0 or gift_id <= 0:
            log(f'[{__id__}] restore unique: плохой peer/gift {peer} {gift_id}')
            _next()
            return
        item = self._find_catalog_item_by_id(account, gift_id)
        if item is None:
            log(f'[{__id__}] restore unique: нет в каталоге gift_id={gift_id} acc={account}')
            _next()
            return
        source_gift = item.get('_source_obj')
        if source_gift is None or not self._is_upgradeable_gift(source_gift):
            log(f'[{__id__}] restore unique: подарок не upgradeable id={gift_id}')
            _next()
            return
        base_id = int(self._resolve_base_gift_id(source_gift, item))
        if base_id <= 0:
            log(f'[{__id__}] restore unique: base_id={base_id}')
            _next()
            return
        is_out = bool(entry.get('is_outgoing', True))

        def _on_done(response, error):
            if error is not None or response is None:
                try:
                    err_text = self._get_any_field_value(error, 'text', 'error_message', 'message') or str(error)
                except Exception:
                    err_text = str(error) if error is not None else 'empty response'
                log(f'[{__id__}] restore unique request err: {err_text}')
                _next()
                return
            try:
                st = self._rebuild_state_unique_from_persisted(account, peer, item, is_out, response, entry)
                if st:
                    self._inject_selected_nft(st, quiet=True)
            except Exception as ex:
                log(f'[{__id__}] restore unique state: {ex}\n{traceback.format_exc()}')
            _next()
        self._send_star_gift_attributes_request(base_id, _on_done, tag='unique_restore')

    def _migrate_and_purge_broken_messages(self, force: bool=False):
        try:
            if not force and self.get_setting(self.MIGRATION_DONE_KEY, False):
                return False
        except Exception:
            pass
        account = self._get_current_account()
        legacy = self._load_legacy_ids_map()
        if not legacy:
            try:
                self.set_setting(self.MIGRATION_DONE_KEY, True)
            except Exception:
                pass
            return False
        removed_any = False
        for peer_str, ids in legacy.items():
            try:
                peer = int(peer_str)
            except Exception:
                continue
            if self._purge_ids_from_storage(account, peer, ids):
                removed_any = True
        try:
            self.set_setting(self.LEGACY_STORAGE_KEY, '{}')
            self.set_setting(self.MIGRATION_DONE_KEY, True)
        except Exception:
            pass
        if removed_any:
            run_on_ui_thread(lambda: BulletinHelper.show_success('Очистил мусор старых сломанных NFT версий'))
        return removed_any

    def _purge_legacy_for_peer(self, account: int, peer: int) -> bool:
        legacy = self._load_legacy_ids_map()
        key = str(int(peer))
        ids = legacy.get(key, [])
        if not ids:
            return False
        removed = self._purge_ids_from_storage(account, peer, ids)
        try:
            del legacy[key]
        except Exception:
            pass
        try:
            self.set_setting(self.LEGACY_STORAGE_KEY, json.dumps(legacy))
        except Exception:
            pass
        return removed

    def _purge_ids_from_storage(self, account: int, peer: int, ids: List[int]) -> bool:
        ids = [int(mid) for mid in ids if mid is not None]
        if not ids:
            return False
        storage = MessagesStorage.getInstance(account)
        mc = MessagesController.getInstance(account)
        removed_any = False
        try:
            java_ids = ArrayList()
            for mid in ids:
                java_ids.add(JAVA_INTEGER_CLASS(int(mid)))
            try:
                storage.markMessagesAsDeleted(int(peer), java_ids, True, False, 0, 0)
                removed_any = True
            except Exception as e:
                log(f'[{__id__}] legacy markMessagesAsDeleted warning: {e}')
        except Exception as e:
            log(f'[{__id__}] legacy ids build warning: {e}')
        try:
            for mid in ids:
                try:
                    mc.dialogMessagesByIds.remove(int(mid))
                except Exception:
                    pass
        except Exception:
            pass
        try:
            dialog_list = mc.dialogMessage.get(int(peer))
            if dialog_list is not None:
                i = 0
                while i < dialog_list.size():
                    try:
                        obj = dialog_list.get(i)
                    except Exception:
                        break
                    msg_id = None
                    try:
                        msg_id = int(obj.getId()) if hasattr(obj, 'getId') else int(getattr(obj, 'id'))
                    except Exception:
                        msg_id = None
                    if msg_id is not None and msg_id in ids:
                        dialog_list.remove(i)
                        removed_any = True
                        continue
                    i += 1
                mc.dialogMessage.put(int(peer), dialog_list)
        except Exception as e:
            log(f'[{__id__}] legacy dialog cache clear warning: {e}')
        return removed_any

    def _load_legacy_ids_map(self) -> Dict[str, List[int]]:
        raw = self.get_setting(self.LEGACY_STORAGE_KEY, '{}')
        try:
            data = raw if isinstance(raw, dict) else json.loads(str(raw or '{}'))
        except Exception:
            return {}
        if not isinstance(data, dict):
            return {}
        out: Dict[str, List[int]] = {}
        for key, value in data.items():
            try:
                peer = str(int(key))
            except Exception:
                continue
            safe_ids: List[int] = []
            if isinstance(value, list):
                for mid in value:
                    try:
                        safe_ids.append(int(mid))
                    except Exception:
                        continue
            if safe_ids:
                out[peer] = safe_ids
        return out

    def _get_current_account(self) -> int:
        try:
            cfg = get_user_config()
            return int(cfg.selectedAccount)
        except Exception:
            return 0

    def _get_peer_from_params(self, params: Any) -> Optional[int]:
        peer = None
        try:
            if hasattr(params, 'peer') and getattr(params, 'peer') is not None:
                peer = int(getattr(params, 'peer'))
        except Exception:
            peer = None
        if peer is None:
            try:
                if hasattr(params, 'dialog_id') and getattr(params, 'dialog_id') is not None:
                    peer = int(getattr(params, 'dialog_id'))
            except Exception:
                peer = None
        if peer is None:
            try:
                fragment = self._get_effective_fragment()
                if fragment is not None and hasattr(fragment, 'getDialogId'):
                    peer = int(fragment.getDialogId())
            except Exception:
                peer = None
        return peer

    def _get_effective_fragment(self):
        fragment = get_last_fragment()
        if fragment is None:
            return None
        try:
            if hasattr(fragment, 'getChatActivity'):
                hosted = fragment.getChatActivity()
                if hosted is not None:
                    return hosted
        except Exception:
            pass
        return fragment

    def _get_activity(self):
        fragment = self._get_effective_fragment()
        if fragment is None:
            return None
        try:
            return fragment.getParentActivity()
        except Exception:
            return None

    def _parse_direct_nft_command(self, raw: str) -> Optional[Dict[str, Any]]:
        text = (raw or '').strip()
        if not text:
            return None
        lowered = text.lower()
        url = None
        is_outgoing = True
        from_command = False
        if lowered.startswith('.sendnft '):
            payload = text.split(' ', 1)[1].strip() if ' ' in text else ''
            if self._looks_like_nft_link(payload):
                url = payload
                is_outgoing = True
                from_command = True
        elif lowered.startswith('.getnft '):
            payload = text.split(' ', 1)[1].strip() if ' ' in text else ''
            if self._looks_like_nft_link(payload):
                url = payload
                is_outgoing = False
                from_command = True
        elif self._looks_like_nft_link(text):
            url = text
            is_outgoing = True
        if not url:
            return None
        normalized = self._normalize_nft_url(url)
        if not normalized:
            return None
        return {'url': normalized, 'is_outgoing': bool(is_outgoing), 'from_command': bool(from_command)}

    def _looks_like_nft_link(self, text: str) -> bool:
        value = (text or '').strip()
        if not value:
            return False
        return re.match('^(?:https?://)?t\\.me/nft/[A-Za-z0-9_\\-]+-\\d+/?(?:\\?.*)?$', value, re.I) is not None

    def _normalize_nft_url(self, text: str) -> Optional[str]:
        value = (text or '').strip()
        if not value:
            return None
        if not re.match('^https?://', value, re.I):
            value = 'https://' + value.lstrip('/')
        match = re.match('^(https?://t\\.me/nft/[A-Za-z0-9_\\-]+-\\d+)/?(?:\\?.*)?$', value, re.I)
        if not match:
            return None
        return match.group(1)

    def _handle_direct_nft_link(self, account: int, peer: int, is_outgoing: bool, url: str):
        try:
            link_info = self._fetch_nft_page_info(url)
            item = self._resolve_catalog_item_from_link(account, link_info)
            if item is None:
                raise RuntimeError(f"Не удалось найти базовый подарок для '{link_info.get('title') or link_info.get('slug') or url}' в каталоге Telegram")
            self._request_upgrade_preview_direct(account, peer, item, is_outgoing, link_info)
        except Exception as e:
            log(f'[{__id__}] direct link error: {e}\n{traceback.format_exc()}')
            err = e
            run_on_ui_thread(lambda: BulletinHelper.show_error(f'Не удалось вставить NFT по ссылке: {err}'))

    def _fetch_nft_page_info(self, url: str) -> Dict[str, Any]:
        headers = {'User-Agent': 'Mozilla/5.0 (Android; Mobile; rv:122.0) Gecko/122.0 Firefox/122.0', 'Accept-Language': 'en-US,en;q=0.9,ru;q=0.8'}
        response = requests.get(url, headers=headers, timeout=15)
        response.raise_for_status()
        soup = BeautifulSoup(response.text, 'html.parser')
        lines = [line.strip() for line in soup.get_text('\n', strip=True).splitlines() if line and line.strip()]
        if not lines:
            raise RuntimeError('Страница NFT не содержит читаемых данных')
        slug_match = re.search('/nft/([A-Za-z0-9_\\-]+)-(\\d+)$', url, re.I)
        slug = slug_match.group(1) if slug_match else ''
        link_number = int(slug_match.group(2)) if slug_match else 0
        title = ''
        number = link_number
        collectible_index = -1
        for i, line in enumerate(lines):
            number_match = re.search('Collectible\\s*#\\s*(\\d+)', line, re.I)
            if number_match:
                number = int(number_match.group(1))
                collectible_index = i
                if i > 0:
                    title = lines[i - 1].strip()
                break
        if not title:
            og_title = None
            try:
                og_title = soup.find('meta', property='og:title')
            except Exception:
                og_title = None
            if og_title is not None:
                title = str(og_title.get('content') or '').strip()
            if title.lower().startswith('telegram:'):
                title = ''
        if not title and slug:
            title = self._humanize_slug(slug)
        model = self._extract_collectible_line_value(lines, 'Model')
        symbol = self._extract_collectible_line_value(lines, 'Symbol')
        backdrop = self._extract_collectible_line_value(lines, 'Backdrop')
        owner = self._extract_collectible_line_value(lines, 'Owner')
        quantity = self._extract_collectible_line_value(lines, 'Quantity')
        if not title:
            raise RuntimeError('Не удалось определить название collectible из ссылки')
        if number <= 0:
            raise RuntimeError('Не удалось определить номер collectible из ссылки')
        return {'url': url, 'slug': slug, 'title': title, 'number': int(number), 'model': model, 'symbol': symbol, 'backdrop': backdrop, 'owner': owner, 'quantity': quantity, 'collectible_index': collectible_index}

    def _extract_collectible_line_value(self, lines: List[str], label: str) -> str:
        label_l = str(label or '').strip().lower()
        for idx, line in enumerate(lines):
            raw = str(line or '').strip()
            lower = raw.lower()
            if lower == label_l:
                if idx + 1 < len(lines):
                    return self._cleanup_collectible_label_value(lines[idx + 1])
                return ''
            prefix = label + ' '
            if lower.startswith(prefix.lower()):
                return self._cleanup_collectible_label_value(raw[len(prefix):])
        return ''

    def _cleanup_collectible_label_value(self, value: str) -> str:
        text = str(value or '').strip()
        text = re.sub('\\s+[0-9]+(?:[\\.,][0-9]+)?%$', '', text).strip()
        text = re.sub('\\s+[0-9]+(?:[\\.,][0-9]+)?‰$', '', text).strip()
        return text

    def _humanize_slug(self, slug: str) -> str:
        raw = str(slug or '').replace('_', '-').strip('-')
        if not raw:
            return 'Gift'
        parts = [p for p in raw.split('-') if p]
        human = []
        for part in parts:
            expanded = re.sub('(?<!^)([A-Z])', ' \\1', part).strip()
            human.append(expanded if expanded else part)
        return ' '.join(human).strip() or raw

    def _normalize_lookup_key(self, value: str) -> str:
        raw = str(value or '').strip().lower()
        if not raw:
            return ''
        return re.sub('[^a-z0-9а-яё]+', '', raw, flags=re.I)

    def _resolve_catalog_item_from_link(self, account: int, link_info: Dict[str, Any]) -> Optional[Dict[str, Any]]:
        catalog = self._get_runtime_catalog(account, refresh=False)
        keys = []
        for candidate in (link_info.get('title'), link_info.get('slug'), self._humanize_slug(link_info.get('slug', ''))):
            key = self._normalize_lookup_key(str(candidate or ''))
            if key and key not in keys:
                keys.append(key)
        for item in catalog:
            item_keys = [self._normalize_lookup_key(str(item.get('title', ''))), self._normalize_lookup_key(str(item.get('slug', '')))]
            if any((key and key in item_keys for key in keys)):
                return item
        for item in catalog:
            title_key = self._normalize_lookup_key(str(item.get('title', '')))
            slug_key = self._normalize_lookup_key(str(item.get('slug', '')))
            for key in keys:
                if not key:
                    continue
                if title_key and (key in title_key or title_key in key) or (slug_key and (key in slug_key or slug_key in key)):
                    return item
        return None

    def _request_upgrade_preview_direct(self, account: int, peer: int, item: Dict[str, Any], is_outgoing: bool, link_info: Dict[str, Any]):
        try:
            source_gift = item.get('_source_obj')
            if source_gift is None:
                raise RuntimeError('Не найден runtime объект подарка')
            if not self._is_upgradeable_gift(source_gift):
                raise RuntimeError('Этот подарок нельзя использовать как основу для NFT')
            base_id = self._resolve_base_gift_id(source_gift, item)
            if base_id <= 0:
                raise RuntimeError('Не удалось определить gift id для NFT')
            request_cls = None
            for cls_name in ('org.telegram.tgnet.tl.TL_stars$getStarGiftUpgradeAttributes', 'org.telegram.tgnet.tl.TL_stars$getStarGiftUpgradePreview'):
                try:
                    request_cls = jclass(cls_name)
                    break
                except Exception:
                    request_cls = None
            if request_cls is None:
                raise RuntimeError('Не найден TL класс запроса NFT атрибутов')
            req = request_cls()
            self._set_any_field(req, ['gift_id', 'giftId', 'id'], int(base_id))

            def _on_done(response, error):

                def _finish():
                    try:
                        self._pending_request_delegates = [cb for cb in getattr(self, '_pending_request_delegates', []) if cb is not delegate]
                    except Exception:
                        pass
                    if error is not None:
                        err_text = self._get_any_field_value(error, 'text', 'error_message', 'message') or str(error)
                        BulletinHelper.show_error(f'Не удалось получить NFT атрибуты: {err_text}')
                        return
                    try:
                        self._inject_direct_link_nft(account, peer, item, is_outgoing, response, link_info)
                    except Exception as inject_error:
                        log(f'[{__id__}] direct inject error: {inject_error}\n{traceback.format_exc()}')
                        BulletinHelper.show_error(f'Не удалось собрать NFT из ссылки: {inject_error}')
                run_on_ui_thread(_finish)
            delegate = REQUEST_DELEGATE_PROXY_CLASS(_on_done)
            try:
                self._pending_request_delegates.append(delegate)
            except Exception:
                self._pending_request_delegates = [delegate]
            get_connections_manager().sendRequest(req, delegate)
        except Exception as e:
            log(f'[{__id__}] preview direct request error: {e}\n{traceback.format_exc()}')
            err = e
            run_on_ui_thread(lambda: BulletinHelper.show_error(f'Не удалось подготовить NFT по ссылке: {err}'))

    def _inject_direct_link_nft(self, account: int, peer: int, item: Dict[str, Any], is_outgoing: bool, response: Any, link_info: Dict[str, Any]):
        models, patterns, backdrops = self._extract_attr_groups(response)
        if not models:
            raise RuntimeError('Сервер не вернул модели NFT')
        if not backdrops:
            raise RuntimeError('Сервер не вернул фоны NFT')
        model_index = self._find_attr_index_by_name(models, str(link_info.get('model', '')))
        backdrop_index = self._find_attr_index_by_name(backdrops, str(link_info.get('backdrop', '')))
        pattern_index = 0
        if model_index < 0:
            raise RuntimeError(f"Не удалось сопоставить модель '{link_info.get('model')}'")
        if backdrop_index < 0:
            raise RuntimeError(f"Не удалось сопоставить фон '{link_info.get('backdrop')}'")
        symbol_name = str(link_info.get('symbol', '')).strip()
        if patterns:
            pattern_index = self._find_attr_index_by_name(patterns, symbol_name)
            if symbol_name and pattern_index < 0:
                raise RuntimeError(f"Не удалось сопоставить symbol '{symbol_name}'")
            if pattern_index < 0:
                pattern_index = 0
        state = {'account': int(account), 'peer': int(peer), 'is_outgoing': bool(is_outgoing), 'item': item, 'response': response, 'models': models, 'patterns': patterns, 'backdrops': backdrops, 'model_index': int(model_index), 'pattern_index': int(pattern_index), 'backdrop_index': int(backdrop_index), 'number': int(link_info.get('number', 1) or 1)}
        self._inject_selected_nft(state)

    def _find_attr_index_by_name(self, items: List[Any], wanted: str) -> int:
        wanted_key = self._normalize_lookup_key(wanted)
        if not wanted_key:
            return 0 if items else -1
        exact_idx = -1
        fuzzy_idx = -1
        for idx, obj in enumerate(items):
            candidates = [str(self._get_any_field_value(obj, 'name', 'title') or ''), str(self._get_any_field_value(obj, 'slug') or '')]
            for candidate in candidates:
                candidate_key = self._normalize_lookup_key(candidate)
                if not candidate_key:
                    continue
                if candidate_key == wanted_key:
                    return idx
                if fuzzy_idx < 0 and (wanted_key in candidate_key or candidate_key in wanted_key):
                    fuzzy_idx = idx
            if exact_idx >= 0:
                return exact_idx
        return fuzzy_idx

    def _resolve_query_direct(self, account: int, query: str) -> Optional[Dict[str, Any]]:
        q = (query or '').strip()
        if not q:
            return None
        catalog = self._get_runtime_catalog(account)
        if q.isdigit():
            target = int(q)
            for item in catalog:
                if int(item.get('id', 0)) == target:
                    return item
        exact = q.lower()
        for item in catalog:
            if str(item.get('title', '')).lower() == exact:
                return item
            if str(item.get('slug', '')).lower() == exact:
                return item
        return None

    def _search_catalog(self, account: int, query: str) -> List[Dict[str, Any]]:
        q = (query or '').strip().lower()
        if not q:
            return []
        out: List[Dict[str, Any]] = []
        for item in self._get_runtime_catalog(account):
            hay = ' '.join([str(item.get('title', '')), str(item.get('slug', '')), str(item.get('rarity', ''))]).lower()
            if q in hay:
                out.append(item)
                if len(out) >= self.MAX_SEARCH_RESULTS:
                    break
        return out

    def _derive_rarity(self, stars: int) -> str:
        stars = int(stars or 0)
        if stars >= 5000:
            return 'Mythic'
        if stars >= 1500:
            return 'Legendary'
        if stars >= 300:
            return 'Rare'
        return 'Common'

    def _is_upgradeable_gift(self, gift: Any) -> bool:
        if gift is None:
            return False
        class_name = self._class_name_lower(gift)
        if 'unique' in class_name:
            return True
        return self._to_int_safe(self._get_any_field_value(gift, 'upgrade_stars', 'upgradeStars'), 0) > 0

    def _sanitize_slug(self, text_value: str) -> str:
        raw = str(text_value or '').strip().lower()
        cleaned: List[str] = []
        dash = False
        for ch in raw:
            if 'a' <= ch <= 'z' or '0' <= ch <= '9':
                cleaned.append(ch)
                dash = False
            elif not dash:
                cleaned.append('-')
                dash = True
        out = ''.join(cleaned).strip('-')
        return out or 'gift'

    def _resolve_base_gift_id(self, gift: Any, item: Optional[Dict[str, Any]]=None) -> int:
        base_id = self._to_int_safe(self._get_any_field_value(gift, 'gift_id', 'giftId', 'giftID'), 0)
        if base_id <= 0:
            base_id = self._to_int_safe(self._get_any_field_value(gift, 'id'), 0)
        if base_id <= 0 and item is not None:
            base_id = self._to_int_safe(item.get('id', 0), 0)
        return base_id

    def _extract_attr_groups(self, response: Any):
        models = []
        patterns = []
        backdrops = []
        raw_list = self._get_any_field_value(response, 'attributes')
        if raw_list is None and response is not None:
            for field in self._iter_instance_fields(response):
                try:
                    type_name = str(field.getType().getName() or '')
                    if 'ArrayList' not in type_name and 'List' not in type_name:
                        continue
                    candidate = field.get(response)
                    if candidate is not None:
                        raw_list = candidate
                        break
                except Exception:
                    continue
        if raw_list is None:
            return (models, patterns, backdrops)
        try:
            size = int(raw_list.size())
            getter = lambda idx: raw_list.get(idx)
        except Exception:
            try:
                size = len(raw_list)
                getter = lambda idx: raw_list[idx]
            except Exception:
                return (models, patterns, backdrops)
        for i in range(size):
            try:
                obj = getter(i)
            except Exception:
                continue
            if obj is None:
                continue
            name = self._class_name_lower(obj)
            if 'model' in name:
                models.append(obj)
            elif 'pattern' in name:
                patterns.append(obj)
            elif 'backdrop' in name:
                backdrops.append(obj)
        return (models, patterns, backdrops)

    def _get_attr_document(self, obj: Any):
        if obj is None:
            return None
        return self._get_any_field_value(obj, 'sticker', 'document')

    def _pick_best_document(self, *candidates: Any):
        for candidate in candidates:
            if candidate is None:
                continue
            doc = candidate
            try:
                name = str(candidate.getClass().getSimpleName() or '')
            except Exception:
                name = ''
            if 'Document' not in name:
                doc = self._get_attr_document(candidate)
            if doc is not None:
                return doc
        return None

    def _get_runtime_catalog(self, account: int, refresh: bool=False) -> List[Dict[str, Any]]:
        account = int(account)
        if not refresh:
            cached = self._runtime_catalog_cache.get(account)
            if cached:
                return cached
        gifts_list = self._get_catalog_gifts_from_memory(account)
        if gifts_list is None:
            self._load_catalog_silent(account)
            gifts_list = self._get_catalog_gifts_from_memory(account)
        if gifts_list is None:
            return []
        collectible_out: List[Dict[str, Any]] = []
        regular_pool: List[Dict[str, Any]] = []
        seen = set()
        try:
            size = int(gifts_list.size())
        except Exception:
            return []
        for index in range(size):
            try:
                gift = gifts_list.get(index)
            except Exception:
                continue
            if not self._looks_like_star_gift(gift):
                continue
            gift_id = self._resolve_base_gift_id(gift, None)
            if gift_id <= 0 or gift_id in seen:
                continue
            seen.add(gift_id)
            stars = self._get_runtime_stars(gift)
            title = self._get_runtime_title(gift)
            item_info = {'id': int(gift_id), 'title': title, 'slug': self._get_runtime_slug(gift), 'stars': int(stars), 'rarity': self._derive_rarity(stars), 'availability_total': max(1, self._to_int_safe(self._get_any_field_value(gift, 'availability_total', 'availabilityTotal', 'limited_count', 'limitedCount'), 1000)), 'availability_remains': max(1, self._to_int_safe(self._get_any_field_value(gift, 'availability_remains', 'availabilityRemains'), 1) or 1), '_source_obj': gift}
            unique_title_override = self._get_unique_override_title(int(gift_id))
            if unique_title_override:
                item_info['title'] = unique_title_override
                item_info['slug'] = self._sanitize_slug(unique_title_override)
            if self._is_upgradeable_gift(gift):
                collectible_out.append(item_info)
            else:
                regular_pool.append(item_info)
        try:
            collectible_out.sort(key=lambda item: (-int(item.get('stars', 0)), str(item.get('title', '')).lower()))
        except Exception:
            pass
        regular_presets = self._build_regular_gift_presets(regular_pool)
        out = regular_presets + collectible_out
        self._runtime_catalog_cache[account] = out
        return out

    def _get_unique_override_title(self, gift_id: int) -> str:
        gid = int(self._to_int_safe(gift_id, 0))
        if gid <= 0:
            return ''
        for item in self.UNIQUE_GIFT_OVERRIDES:
            try:
                if int(self._to_int_safe(item.get('id', 0), 0)) == gid:
                    title = str(item.get('title', '') or '').strip()
                    if title:
                        return title
            except Exception:
                continue
        return ''

    def _build_regular_gift_presets(self, regular_pool: List[Dict[str, Any]]) -> List[Dict[str, Any]]:
        result: List[Dict[str, Any]] = []
        if not regular_pool:
            return result
        pool_by_id: Dict[int, Dict[str, Any]] = {}
        for item in regular_pool:
            gid = int(self._to_int_safe(item.get('id', 0), 0))
            if gid > 0:
                pool_by_id[gid] = item
        used_ids = set()
        for override in self.REGULAR_GIFT_OVERRIDES:
            gid = int(self._to_int_safe(override.get('id', 0), 0))
            if gid <= 0:
                continue
            selected = pool_by_id.get(gid)
            if selected is None:
                continue
            stars = int(self._to_int_safe(override.get('stars', selected.get('stars', 0)), 0))
            fixed_title = str(override.get('title', '') or '').strip()
            if fixed_title:
                title = fixed_title
            else:
                title = str(selected.get('title', '') or '').strip() or 'Подарок'
            result.append({'id': gid, 'title': title, 'slug': str(selected.get('slug', '') or ''), 'stars': int(stars), 'rarity': 'Common', 'availability_total': int(self._to_int_safe(selected.get('availability_total', 1), 1) or 1), 'availability_remains': int(self._to_int_safe(selected.get('availability_remains', 1), 1) or 1), '_source_obj': selected.get('_source_obj'), '_gift_mode': 'regular'})
            used_ids.add(gid)
        if result:
            return result
        for wanted_price in self.REGULAR_GIFT_PRICES:
            for item in regular_pool:
                gid = int(self._to_int_safe(item.get('id', 0), 0))
                if gid <= 0 or gid in used_ids:
                    continue
                stars = int(self._to_int_safe(item.get('stars', 0), 0))
                if stars != int(wanted_price):
                    continue
                base_title = str(item.get('title', '') or '').strip() or 'Подарок'
                result.append({'id': gid, 'title': base_title, 'slug': str(item.get('slug', '') or ''), 'stars': int(stars), 'rarity': 'Common', 'availability_total': int(self._to_int_safe(item.get('availability_total', 1), 1) or 1), 'availability_remains': int(self._to_int_safe(item.get('availability_remains', 1), 1) or 1), '_source_obj': item.get('_source_obj'), '_gift_mode': 'regular'})
                used_ids.add(gid)
                break
        return result

    def _get_stars_controller(self, account: int):
        try:
            controller_class = jclass('org.telegram.ui.Stars.StarsController')
            try:
                return controller_class.getInstance(int(account))
            except Exception:
                return controller_class.getInstance(JAVA_INTEGER_CLASS(int(account)))
        except Exception:
            return None

    def _load_catalog_silent(self, account: int) -> bool:
        try:
            controller = self._get_stars_controller(account)
            if controller is None:
                return False
            controller.loadStarGifts()
            self._runtime_catalog_cache.pop(int(account), None)
            return True
        except Exception as e:
            log(f'[{__id__}] loadStarGifts warning: {e}')
            return False

    def _get_catalog_gifts_from_memory(self, account: int):
        controller = self._get_stars_controller(account)
        if controller is None:
            return None
        cached_field = getattr(self, '_stars_catalog_list_field', None)
        if cached_field is not None:
            try:
                cached_field.setAccessible(True)
            except Exception:
                pass
            try:
                value = cached_field.get(controller)
                if value is not None:
                    return value
            except Exception:
                pass
        candidate_list = None
        for field in self._iter_instance_fields(controller):
            try:
                value = field.get(controller)
            except Exception:
                continue
            if value is None:
                continue
            try:
                type_name = str(value.getClass().getName() or '')
            except Exception:
                continue
            if 'ArrayList' not in type_name and 'List' not in type_name:
                continue
            try:
                size = int(value.size())
            except Exception:
                size = 0
            if size > 0:
                try:
                    first = value.get(0)
                    if self._looks_like_star_gift(first):
                        self._stars_catalog_list_field = field
                        return value
                except Exception:
                    pass
            try:
                field_name = str(field.getName() or '').lower()
            except Exception:
                field_name = ''
            if candidate_list is None and 'gift' in field_name and ('saved' not in field_name):
                candidate_list = value
        return candidate_list

    def _looks_like_star_gift(self, obj: Any) -> bool:
        if obj is None:
            return False
        name = self._class_name_lower(obj)
        return ('stargift' in name or ('gift' in name and 'star' in name)) and 'saved' not in name

    def _resolve_gift_id(self, gift: Any) -> int:
        gid = self._to_int_safe(self._get_any_field_value(gift, 'gift_id', 'giftId', 'giftID'), 0)
        if gid <= 0:
            gid = self._to_int_safe(self._get_any_field_value(gift, 'id'), 0)
        return gid

    def _get_runtime_title(self, gift: Any) -> str:
        title = str(self._get_any_field_value(gift, 'title') or '').strip()
        if title:
            return title
        slug = str(self._get_any_field_value(gift, 'slug') or '').strip()
        if slug:
            return slug.replace('gift-', '').replace('_', ' ').replace('-', ' ').strip().title()
        gid = self._resolve_gift_id(gift)
        return f'Gift {gid}' if gid > 0 else 'Gift'

    def _get_runtime_slug(self, gift: Any) -> str:
        slug = str(self._get_any_field_value(gift, 'slug') or '').strip()
        if slug:
            return slug
        return self._sanitize_slug(self._get_runtime_title(gift))

    def _get_runtime_stars(self, gift: Any) -> int:
        for name in ('resell_min_stars', 'min_resell_stars', 'floor_stars', 'floorStars', 'min_resale_stars', 'resellMinStars', 'stars', 'stars_price', 'convert_stars', 'convertStars', 'upgrade_stars', 'upgradeStars'):
            value = self._to_int_safe(self._get_any_field_value(gift, name), 0)
            if value > 0:
                return value
        return 0

    def _build_service_message_instance(self):
        candidates = [(TLRPC, 'TL_messageService'), (TLRPC, 'messageService'), 'org.telegram.tgnet.TLRPC$TL_messageService', 'org.telegram.tgnet.TLRPC$messageService']
        for candidate in candidates:
            obj = self._new_java_instance(candidate)
            if obj is not None:
                return obj
        obj = self._instantiate_discovered_tl_class(['message', 'service'], ['media', 'empty'], ['tl'])
        if obj is None:
            raise RuntimeError('Не найден TL класс service message')
        return obj

    def _build_peer_obj(self, account: int, peer: int):
        peer = int(peer)
        if peer > 0:
            obj = TLRPC.TL_peerUser()
            obj.user_id = int(peer)
            return obj
        chat_id = abs(peer)
        mc = MessagesController.getInstance(account)
        chat = None
        try:
            chat = mc.getChat(chat_id)
        except Exception:
            chat = None
        is_channel = True
        if chat is not None:
            try:
                is_channel = bool(getattr(chat, 'megagroup', False) or getattr(chat, 'broadcast', False) or getattr(chat, 'gigagroup', False))
            except Exception:
                is_channel = True
        if is_channel:
            obj = TLRPC.TL_peerChannel()
            obj.channel_id = int(chat_id)
            return obj
        obj = TLRPC.TL_peerChat()
        obj.chat_id = int(chat_id)
        return obj

    def _build_self_peer(self, account: int):
        obj = TLRPC.TL_peerUser()
        try:
            obj.user_id = int(UserConfig.getInstance(account).getClientUserId())
        except Exception:
            obj.user_id = 0
        return obj

    def _to_int_safe(self, value: Any, default: int=0) -> int:
        try:
            if value is None or isinstance(value, bool):
                return default
            return int(value)
        except Exception:
            try:
                return int(str(value))
            except Exception:
                return default

    def _get_any_field_value(self, obj: Any, *field_names: str):
        if obj is None:
            return None
        for field_name in field_names:
            if not field_name:
                continue
            try:
                value = getattr(obj, field_name)
                if value is not None:
                    return value
            except Exception:
                pass
            try:
                field = obj.getClass().getField(field_name)
                value = field.get(obj)
                if value is not None:
                    return value
            except Exception:
                pass
            try:
                field = obj.getClass().getDeclaredField(field_name)
                field.setAccessible(True)
                value = field.get(obj)
                if value is not None:
                    return value
            except Exception:
                pass
        return None

    def _set_field(self, obj: Any, field_name: str, value: Any) -> bool:
        if obj is None:
            return False
        try:
            setattr(obj, field_name, value)
            return True
        except Exception:
            pass
        for getter_name in ('getField', 'getDeclaredField'):
            try:
                field = getattr(obj.getClass(), getter_name)(field_name)
                try:
                    field.setAccessible(True)
                except Exception:
                    pass
                type_name = str(field.getType().getName())
                if type_name == 'int':
                    field.setInt(obj, self._to_int_safe(value, 0))
                elif type_name == 'long':
                    field.setLong(obj, self._to_int_safe(value, 0))
                elif type_name == 'boolean':
                    field.setBoolean(obj, bool(value))
                else:
                    field.set(obj, value)
                return True
            except Exception:
                continue
        return False

    def _set_any_field(self, obj: Any, field_names: List[str], value: Any) -> bool:
        for field_name in field_names:
            if self._set_field(obj, field_name, value):
                return True
        return False

    def _iter_instance_fields(self, obj: Any):
        if obj is None:
            return []
        result = []
        seen = set()
        for getter_name in ('getFields', 'getDeclaredFields'):
            try:
                fields = getattr(obj.getClass(), getter_name)()
            except Exception:
                continue
            try:
                iterator = list(fields)
            except Exception:
                try:
                    iterator = [fields.get(i) for i in range(int(fields.size()))]
                except Exception:
                    iterator = []
            for field in iterator:
                if field is None:
                    continue
                try:
                    name = str(field.getName())
                except Exception:
                    continue
                if name in seen:
                    continue
                seen.add(name)
                try:
                    field.setAccessible(True)
                except Exception:
                    pass
                result.append(field)
        return result

    def _class_name_lower(self, cls_or_obj: Any) -> str:
        if cls_or_obj is None:
            return ''
        try:
            if hasattr(cls_or_obj, 'getName'):
                return str(cls_or_obj.getName() or '').lower()
        except Exception:
            pass
        try:
            if hasattr(cls_or_obj, 'getClass'):
                return str(cls_or_obj.getClass().getName() or '').lower()
        except Exception:
            pass
        try:
            return str(cls_or_obj or '').lower()
        except Exception:
            return ''

    def _iter_java_array_items(self, array_obj: Any):
        if array_obj is None:
            return []
        try:
            return list(array_obj)
        except Exception:
            pass
        try:
            array_cls = jclass('java.lang.reflect.Array')
            size = int(array_cls.getLength(array_obj))
            return [array_cls.get(array_obj, i) for i in range(size)]
        except Exception:
            return []

    def _get_known_tl_classes(self, refresh: bool=False):
        if self._known_tl_classes_cache is not None and (not refresh):
            return self._known_tl_classes_cache
        result = []
        seen = set()
        for outer_name in ('org.telegram.tgnet.TLRPC', 'org.telegram.tgnet.tl.TL_stars'):
            outer = None
            try:
                outer = find_class(outer_name)
            except Exception:
                outer = None
            if outer is None:
                try:
                    outer = jclass(outer_name)
                except Exception:
                    outer = None
            if outer is None:
                continue
            declared = None
            try:
                declared = outer.getDeclaredClasses()
            except Exception:
                declared = None
            for cls in [outer] + self._iter_java_array_items(declared):
                if cls is None:
                    continue
                name = self._class_name_lower(cls)
                if not name or name in seen:
                    continue
                seen.add(name)
                result.append(cls)
        self._known_tl_classes_cache = result
        return result

    def _discover_tl_class(self, required_tokens: List[str], forbidden_tokens: Optional[List[str]]=None, prefer_tokens: Optional[List[str]]=None):
        forbidden_tokens = list(forbidden_tokens or [])
        prefer_tokens = list(prefer_tokens or [])
        best_cls = None
        best_score = -10 ** 9
        for cls in self._get_known_tl_classes():
            name = self._class_name_lower(cls)
            if not name:
                continue
            if any((token not in name for token in required_tokens)):
                continue
            if any((token in name for token in forbidden_tokens)):
                continue
            score = len(required_tokens) * 100
            for token in prefer_tokens:
                if token in name:
                    score += 10
            if '$tl_' in name or '.tl_' in name:
                score += 4
            if '$tl' in name:
                score += 2
            if score > best_score:
                best_score = score
                best_cls = cls
        return best_cls

    def _instantiate_discovered_tl_class(self, required_tokens: List[str], forbidden_tokens: Optional[List[str]]=None, prefer_tokens: Optional[List[str]]=None):
        cls = self._discover_tl_class(required_tokens, forbidden_tokens, prefer_tokens)
        if cls is None:
            return None
        return self._instantiate_class(cls)

    def _instantiate_class(self, cls: Any):
        if cls is None:
            return None
        try:
            return cls()
        except Exception:
            pass
        try:
            ctor = cls.getDeclaredConstructor()
            ctor.setAccessible(True)
            return ctor.newInstance()
        except Exception:
            pass
        try:
            ctor = cls.getConstructor()
            ctor.setAccessible(True)
            return ctor.newInstance()
        except Exception:
            return None

    def _new_java_instance(self, candidate: Any):
        cls = None
        try:
            if isinstance(candidate, tuple) and len(candidate) == 2:
                owner, attr = candidate
                cls = getattr(owner, attr, None)
            elif isinstance(candidate, str):
                try:
                    cls = find_class(candidate)
                except Exception:
                    cls = None
                if cls is None:
                    cls = jclass(candidate)
            else:
                cls = candidate
        except Exception:
            cls = None
        if cls is None:
            return None
        return self._instantiate_class(cls)

    def _new_java_instance_any(self, *candidates: Any):
        for candidate in candidates:
            try:
                obj = self._new_java_instance(candidate)
            except Exception:
                obj = None
            if obj is not None:
                return obj
        return None

    def _register_cool_stuff(self):
        try:
            mc = self.find_class(MESSAGES_CONTROLLER_CLASS)
            if mc is not None:
                self._unhooks += self.hook_all_methods(mc, 'updateInterfaceWithMessages', hook_patch_reactions_after_update(self)) or []
        except Exception as e:
            log(f'[Cool] hook reactions: {e}')
        try:
            mc = self.find_class(MESSAGES_CONTROLLER_CLASS)
            if mc is not None:
                self._unhooks += self.hook_all_methods(mc, 'getPrintingStrings', replace_printing_strings_fake_typing(self)) or []
        except Exception as e:
            log(f'[Cool] hook typing: {e}')
        try:
            mo_cls = self.find_class('org.telegram.messenger.MessageObject')
            if mo_cls is not None:
                self._unhooks += self.hook_all_methods(mo_cls, 'getReactionsCount', replace_reactions_count(self)) or []
        except Exception as e:
            log(f'[Cool] hook reaction count: {e}')
        try:
            pa = self.find_class('org.telegram.ui.ProfileActivity')
            if pa is not None:
                self._unhooks += self.hook_all_methods(pa, 'createView', hook_apply_profile_gradient(self)) or []
                self._unhooks += self.hook_all_methods(pa, 'onFragmentCreate', hook_apply_profile_gradient(self)) or []
        except Exception as e:
            log(f'[Cool] hook profile: {e}')
        global profile_gradient_active
        profile_gradient_active = self._bool(SETTING_KEY_PROFILE_GRADIENT_ENABLED, False)

    def _get_burst_style(self):
        try:
            s = str(self.get_setting(SETTING_KEY_GIFT_BURST_STYLE, 'confetti') or 'confetti')
        except Exception:
            s = 'confetti'
        if s in BURST_EMOJI_SETS or s in ('confetti', 'off'):
            return s
        return 'confetti'

    def _on_burst_pick(self, idx):
        labels = ['Конфетти', 'Сердечки', 'Монеты', 'Звёзды', 'Выключено']
        if 0 <= idx < len(labels):
            mapping = {'Конфетти': 'confetti', 'Сердечки': 'hearts', 'Монеты': 'coins', 'Звёзды': 'stars', 'Выключено': 'off'}
            key = mapping.get(str(labels[idx]).strip())
            if key is not None:
                try:
                    self.set_setting(SETTING_KEY_GIFT_BURST_STYLE, key)
                except Exception:
                    pass

    def _show_emoji_burst(self, style):
        try:
            la = resolve_java_class(LAUNCH_ACTIVITY_CLASS)
            if la is None:
                return
            inst = getattr(la, 'instance', None)
            if inst is None:
                return
            window = inst.getWindow()
            if window is None:
                return
            decor = window.getDecorView()
            if decor is None:
                return
            ViewGroup = jclass('android.view.ViewGroup')
            FrameLayout = jclass('android.widget.FrameLayout')
            TextView = jclass('android.widget.TextView')
            AndroidUtilities = jclass('org.telegram.messenger.AndroidUtilities')
            if not isinstance(decor, ViewGroup):
                return
            overlay = FrameLayout(decor.getContext())
            overlay.setClickable(False)
            overlay.setFocusable(False)
            overlay.setFocusableInTouchMode(False)
            overlay.setLayoutParams(FrameLayout.LayoutParams(FrameLayout.LayoutParams.MATCH_PARENT, FrameLayout.LayoutParams.MATCH_PARENT))
            try:
                decor.addView(overlay)
            except Exception:
                return
            width = int(decor.getWidth())
            height = int(decor.getHeight())
            if width <= 0:
                try:
                    width = int(AndroidUtilities.displaySize.x)
                except Exception:
                    width = 1080
            if height <= 0:
                try:
                    height = int(AndroidUtilities.displaySize.y)
                except Exception:
                    height = 1920
            emojis = BURST_EMOJI_SETS[style]
            start_y = int(height * 0.9)
            parts = []
            for i in range(30):
                tv = TextView(decor.getContext())
                tv.setText(random.choice(emojis))
                tv.setTextSize(int(16 + random.random() * 24))
                tv.setX(float(random.random() * width))
                tv.setY(float(start_y + random.random() * 60))
                tv.setAlpha(0.0)
                tv.setRotation(float(random.random() * 40 - 20))
                overlay.addView(tv)
                parts.append((tv, float(random.random() * width), random.random() * 6.28, 1400 + random.random() * 700))
            t0 = time.time()

            def _tick():
                try:
                    if overlay.getParent() is None:
                        return
                    dt = (time.time() - t0) * 1000.0
                    done = True
                    for tv, base_x, phase, dur in parts:
                        prog = min(1.0, dt / dur)
                        if prog >= 1.0:
                            tv.setAlpha(0.0)
                            continue
                        done = False
                        y = start_y - prog * (height * 0.62) - 40
                        x = base_x + math.sin(prog * 6.28 + phase) * 70
                        tv.setY(float(y))
                        tv.setX(float(x))
                        if prog < 0.35:
                            alpha = min(1.0, prog * 6)
                        else:
                            alpha = max(0.0, (1.0 - prog) / 0.25)
                        tv.setAlpha(alpha)
                    if done:
                        try:
                            decor.removeView(overlay)
                        except Exception:
                            pass
                        return
                    AndroidUtilities.runOnUIThread(RUNNABLE_PROXY_CLASS(_tick), 16)
                except Exception:
                    try:
                        decor.removeView(overlay)
                    except Exception:
                        pass
            AndroidUtilities.runOnUIThread(RUNNABLE_PROXY_CLASS(_tick), 16)
        except Exception:
            pass

    def _reactions_enabled(self):
        return self._bool(SETTING_KEY_FAKE_REACTIONS_ENABLED, False)

    def _reactions_target(self):
        try:
            return int(self.get_setting(SETTING_KEY_FAKE_REACTION_MESSAGE_ID, '0') or 0)
        except Exception:
            return 0

    def _reactions_count(self):
        try:
            return int(self.get_setting(SETTING_KEY_FAKE_REACTION_COUNT, '1234567') or 1234567)
        except Exception:
            return 1234567

    def _patch_reactions(self, args):
        try:
            if not self._reactions_enabled():
                return
            if not args or len(args) < 2:
                return
            target = self._reactions_target()
            if target <= 0:
                return
            objs = args[1]
            if objs is None:
                return
            size = int(objs.size())
            for i in range(size):
                try:
                    mo = objs.get(i)
                except Exception:
                    continue
                try:
                    if int(mo.getId()) == target:
                        self._apply_fake_reactions(mo)
                except Exception:
                    pass
        except Exception:
            pass

    def _apply_fake_reactions(self, mo):
        try:
            emoji = str(self.get_setting(SETTING_KEY_FAKE_REACTION_EMOJI, '❤️🔥') or '❤️🔥')
            count = self._reactions_count()
            mrs = getattr(mo, 'messageReactions', None)
            if mrs is None:
                MR = resolve_java_class('org.telegram.tgnet.TLRPC$TL_messageReactions')
                if MR is None:
                    return
                mrs = MR()
                try:
                    mo.messageReactions = mrs
                except Exception:
                    return
            try:
                mrs.dcount = count
            except Exception:
                pass
            RC = resolve_java_class('org.telegram.tgnet.TLRPC$TL_reactionCount')
            RE = resolve_java_class('org.telegram.tgnet.TLRPC$TL_reactionEmoji')
            if RC is not None and RE is not None:
                try:
                    rc = RC()
                    re = RE()
                    re.emoticon = emoji
                    rc.reaction = re
                    rc.count = count
                    rc.chosen_order = 0
                    try:
                        mrs.reactions.clear()
                    except Exception:
                        try:
                            mrs.reactions = ArrayList()
                        except Exception:
                            pass
                    mrs.reactions.add(rc)
                except Exception:
                    pass
        except Exception:
            pass

    def _fake_typing_enabled(self):
        return self._bool(SETTING_KEY_FAKE_TYPING_ENABLED, False)

    def _fake_typing_dialog(self):
        try:
            return int(self.get_setting(SETTING_KEY_FAKE_TYPING_DIALOG, '0') or 0)
        except Exception:
            return 0

    def _typing_peer_matches(self, peer):
        target = self._fake_typing_dialog()
        if target <= 0:
            return False
        t = abs(int(target))
        try:
            for f in ('user_id', 'chat_id', 'channel_id'):
                try:
                    v = int(getattr(peer, f, 0) or 0)
                except Exception:
                    v = 0
                if v != 0 and v == t:
                    return True
        except Exception:
            pass
        return False

    def _fake_typing_list(self):
        try:
            TA = resolve_java_class('org.telegram.tgnet.TLRPC$TL_sendMessageTypingAction')
            if TA is None:
                return None
            action = TA()
            CTO = resolve_java_class('org.telegram.tgnet.ChatTypingObject')
            if CTO is None:
                CTO = resolve_java_class('org.telegram.messenger.ChatTypingObject')
            if CTO is None:
                return None
            obj = None
            try:
                obj = CTO(action)
            except Exception:
                obj = None
            if obj is None:
                try:
                    SendMessageAction = resolve_java_class('org.telegram.tgnet.TLRPC$SendMessageAction')
                    if SendMessageAction is not None:
                        ctor = CTO.getDeclaredConstructor(SendMessageAction)
                        ctor.setAccessible(True)
                        obj = ctor.newInstance(action)
                except Exception:
                    obj = None
            if obj is None:
                return None
            try:
                obj.first_time = int(time.time() * 1000)
            except Exception:
                pass
            lst = ArrayList()
            lst.add(obj)
            return lst
        except Exception:
            return None

    def _on_menu_toggle_typing(self, context):
        if not self._license_guard():
            return
        peer = self._menu_context_peer(context)
        if peer is None or abs(peer) <= 1000:
            return
        try:
            cur = self._fake_typing_dialog()
            if cur == peer:
                self.set_setting(SETTING_KEY_FAKE_TYPING_DIALOG, 0)
                self.set_setting(SETTING_KEY_FAKE_TYPING_ENABLED, False)
                run_on_ui_thread_delayed(lambda: BulletinHelper.show_error('Фейк «печатает...» выключен'))
            else:
                self.set_setting(SETTING_KEY_FAKE_TYPING_DIALOG, int(peer))
                self.set_setting(SETTING_KEY_FAKE_TYPING_ENABLED, True)
                run_on_ui_thread_delayed(lambda: BulletinHelper.show_error('«Печатает...» включён для этого чата'))
        except Exception:
            pass

    def inject_profile_fakes(self, user):
        try:
            if not bool(user.self):
                return
        except Exception:
            return
        try:
            if self._bool(SETTING_KEY_EMOJI_STATUS_ENABLED, False):
                try:
                    user.premium = True
                except Exception:
                    pass
                doc = str(self.get_setting(SETTING_KEY_EMOJI_STATUS_DOCUMENT, '') or '').strip()
                if doc:
                    try:
                        ES = resolve_java_class('org.telegram.tgnet.TLRPC$TL_emojiStatus')
                        if ES is not None:
                            es = ES()
                            es.document_id = int(doc)
                            es.flags = 1
                            user.emoji_status = es
                    except Exception:
                        pass
        except Exception as e:
            log(f'[Cool] emoji status: {e}')
        try:
            if self._bool(SETTING_KEY_LAST_SEEN_ENABLED, False):
                mode = str(self.get_setting(SETTING_KEY_LAST_SEEN_MODE, 'online') or 'online')
                if mode == 'offline':
                    SO = resolve_java_class('org.telegram.tgnet.TLRPC$TL_userStatusOffline')
                    if SO is not None:
                        st = SO()
                        raw = str(self.get_setting(SETTING_KEY_LAST_SEEN_TIME, '') or '').strip()
                        val = 0
                        if raw.isdigit():
                            val = int(raw)
                        elif raw:
                            val = parse_date_to_timestamp(raw)
                        if val <= 0:
                            val = int(time.time())
                        st.was_online = val
                        user.status = st
                else:
                    SO = resolve_java_class('org.telegram.tgnet.TLRPC$TL_userStatusOnline')
                    if SO is not None:
                        st = SO()
                        st.expires = int(time.time()) + 31536000
                        user.status = st
        except Exception as e:
            log(f'[Cool] last seen: {e}')
        try:
            if self._bool(SETTING_KEY_FAKE_PHONE_ENABLED, False):
                phone = str(self.get_setting(SETTING_KEY_FAKE_PHONE_VALUE, '') or '').strip()
                digits = re.sub('\\D', '', phone)
                if digits:
                    user.phone = digits
        except Exception as e:
            log(f'[Cool] phone: {e}')
        try:
            if self._bool(SETTING_KEY_VERIFIED_BADGE_ENABLED, False):
                try:
                    user.verified = True
                except Exception:
                    pass
                try:
                    user.premium = True
                except Exception:
                    pass
                try:
                    color_id = int(self.get_setting(SETTING_KEY_VERIFIED_NAME_COLOR, '0') or 0)
                except Exception:
                    color_id = 0
                PC = resolve_java_class('org.telegram.tgnet.TLRPC$TL_peerColor')
                if PC is not None:
                    c = PC()
                    c.color_id = color_id
                    try:
                        c.flags = 1
                    except Exception:
                        pass
                    user.color = c
        except Exception as e:
            log(f'[Cool] verified/color: {e}')

    def _get_field_safe(self, obj, name):
        try:
            return getattr(obj, name, None)
        except Exception:
            pass
        try:
            f = obj.getClass().getDeclaredField(name)
            f.setAccessible(True)
            return f.get(obj)
        except Exception:
            pass
        try:
            cur = obj.getClass()
            while cur is not None:
                try:
                    f = cur.getDeclaredField(name)
                    f.setAccessible(True)
                    return f.get(obj)
                except Exception:
                    cur = cur.getSuperclass()
        except Exception:
            pass
        return None

    def _apply_profile_gradient(self):
        global profile_gradient_active
        try:
            if not self._bool(SETTING_KEY_PROFILE_GRADIENT_ENABLED, False):
                profile_gradient_active = False
                return
            frag = get_last_fragment()
            if frag is None:
                return
            if 'ProfileActivity' not in str(frag.getClass().getName()):
                return
            fv = self._get_field_safe(frag, 'fragmentView')
            if fv is None:
                return
            FrameLayout = jclass('android.widget.FrameLayout')
            Gravity = jclass('android.view.Gravity')
            AndroidUtilities = jclass('org.telegram.messenger.AndroidUtilities')
            if not isinstance(fv, FrameLayout):
                return
            if getattr(self, '_pg_view', None) is not None and self._pg_view.getParent() is not None:
                return
            if not init_gradient_view_proxy():
                return
            if cls_profile_gradient_view is None:
                return
            view = cls_profile_gradient_view.new_java_instance(fv.getContext())
            lp = FrameLayout.LayoutParams(FrameLayout.LayoutParams.MATCH_PARENT, AndroidUtilities.dp(300))
            lp.gravity = Gravity.TOP
            view.setLayoutParams(lp)
            view.setClickable(False)
            view.setFocusable(False)
            view.setFocusableInTouchMode(False)
            fv.addView(view)
            self._pg_view = view
            profile_gradient_active = True
        except Exception as e:
            log(f'[Cool] profile gradient: {e}')

    def _bool(self, key, default=False):
        try:
            return bool(self.get_setting(key, default))
        except Exception:
            return default

    def _save_dialog(self, did):
        if abs(int(did or 0)) < 1000:
            return
        self._last_dialog = int(did)
        try:
            self.set_setting('last_dialog_id', int(did))
        except Exception:
            pass

    def _hook_fill(self):
        gs = resolve_java_class(GIFT_SHEET_CLASS)
        if gs is None:
            return
        try:
            refs = self.hook_all_methods(gs, 'fillItems', hook_gift_sheet_fill_items(self))
            if refs:
                self._hooks.extend(refs if isinstance(refs, list) else [refs])
        except Exception:
            pass

    def _hook_buy(self):
        for m in ('buyStarGift', 'buyGift', 'sendStarGift', 'buyResaleGift'):
            self._try_hook(STARS_CONTROLLER_CLASS, m, hook_gift_buy_show_visual(self, 'SC.%s' % m))
        for m in ('buyStarGift', 'send', 'sendGift', 'onSendPressed'):
            self._try_hook(SEND_GIFT_SHEET_CLASS, m, hook_gift_buy_show_visual(self, 'SGS.%s' % m))
        for m in ('onBuyPressed', 'buy', 'buyPressed', 'send'):
            self._try_hook(STAR_GIFT_SHEET_CLASS, m, hook_gift_buy_show_visual(self, 'SG.%s' % m))

    def _try_hook(self, cls_name, method, hook):
        c = resolve_java_class(cls_name)
        if c is None:
            return
        try:
            refs = self.hook_all_methods(c, method, hook)
            if refs:
                self._hooks.extend(refs if isinstance(refs, list) else [refs])
        except Exception:
            pass

    def on_fill_items(self, param):
        if not self._licensed():
            return
        args = param.args
        if not args:
            return
        items = args[0]
        if items is None:
            return
        try:
            size = int(items.size())
        except Exception:
            return
        for i in range(size):
            try:
                it = items.get(i)
                if it is not None and int(getattr(it, 'id', 0) or 0) == NFT_GIFT_MENU_ITEM_ID:
                    return
            except Exception:
                pass
        insert_at = -1
        for i in range(size):
            try:
                it = items.get(i)
                obj = getattr(it, 'object', None) if it else None
                if obj is not None and hasattr(obj, 'size') and (int(obj.size()) > 0):
                    first = obj.get(0)
                    if isinstance(first, str):
                        insert_at = i
                        break
            except Exception:
                pass
        tab = self._make_tabs()
        if tab is None:
            return
        try:
            items.add(insert_at if insert_at >= 0 else min(1, size), tab)
            self.inject_count += 1
        except Exception:
            pass

    def _make_tabs(self):
        try:
            labels = ArrayList()
            labels.add('Общие')
            factory = resolve_java_class(GIFT_SHEET_TABS_FACTORY_CLASS)
            if factory is None:
                return None
            cb = self._callback()
            sel = 0 if self.visual_mode else 1
            try:
                return factory.asTabs(NFT_GIFT_MENU_ITEM_ID, labels, sel, cb)
            except Exception:
                try:
                    return factory.asTabs(NFT_GIFT_MENU_ITEM_ID, labels, sel, None)
                except Exception:
                    return None
        except Exception:
            return None

    def _callback(self):
        if self._cb is not None:
            return self._cb
        try:
            from java.lang.reflect import Proxy, InvocationHandler
            plugin = self

            class Handler(dynamic_proxy(InvocationHandler)):

                def invoke(self, proxy, method, args):
                    try:
                        if args:
                            plugin.visual_mode = int(args[0]) == 0
                    except Exception:
                        pass
                    return None
            loader = None
            try:
                loader = ApplicationLoader.applicationContext.getClassLoader()
            except Exception:
                pass
            if loader is None:
                try:
                    loader = jclass('java.lang.String').getClassLoader()
                except Exception:
                    pass
            for name in ('org.telegram.messenger.Utilities$Callback', 'org.telegram.messenger.Utilities$Callback1'):
                ic = resolve_java_class(name)
                if ic is None or loader is None:
                    continue
                try:
                    self._cb = Proxy.newProxyInstance(loader, [ic], Handler())
                    return self._cb
                except Exception:
                    pass
        except Exception:
            pass
        return None

    def resolve_dialog(self):
        p = get_recent_dialog_id()
        if abs(p) > 1000:
            return p
        if self._last_dialog and abs(self._last_dialog) > 1000:
            return self._last_dialog
        try:
            saved = int(self.get_setting('last_dialog_id', 0) or 0)
            if abs(saved) > 1000:
                self._last_dialog = saved
                return saved
        except Exception:
            pass
        return 0

    def _my_id(self, account):
        try:
            return int(UserConfig.getInstance(account).getClientUserId())
        except Exception:
            return 0

    def _peer(self, user_id):
        p = TLRPC.TL_peerUser()
        p.user_id = abs(int(user_id))
        return p

    def _new_mid(self, account):
        try:
            mid = UserConfig.getInstance(account).getNewMessageId()
            if mid and int(mid) != 0:
                return int(mid)
        except Exception:
            pass
        return int(time.time() * 1000) & 1073741823

    def _now(self, account):
        try:
            cm = resolve_java_class(CONNECTIONS_MANAGER_CLASS)
            if cm is not None:
                t = cm.getInstance(account).getCurrentTime()
                if t:
                    return int(t)
        except Exception:
            pass
        return int(time.time())

    def _fireworks(self):
        if not self._licensed():
            return
        if not self._bool('confetti', True):
            return
        style = self._get_burst_style()
        if style == 'off':
            return
        if style in BURST_EMOJI_SETS:
            self._show_emoji_burst(style)
            return
        try:
            la = resolve_java_class(LAUNCH_ACTIVITY_CLASS)
            if la is None:
                return
            inst = getattr(la, 'instance', None)
            if inst is None:
                return
            overlay = inst.getFireworksOverlay()
            if overlay is None:
                return
            try:
                overlay.start(True)
            except Exception:
                try:
                    overlay.start()
                except Exception:
                    pass
        except Exception:
            pass

    def send_visual(self, gift, dialog_id, unique=False, anonymous=False, message=''):
        if not self._licensed():
            return
        if self._busy:
            return
        self._busy = True
        as_me = self._bool('send_as_me', True)
        try:
            account = int(UserConfig.selectedAccount)
            my_id = self._my_id(account)
            peer = int(dialog_id) if dialog_id else 0
            if abs(peer) < 1000:
                peer = self.resolve_dialog()
            if abs(peer) < 1000:
                run_on_ui_thread_delayed(lambda: BulletinHelper.show_error('Открой чат и попробуй снова'))
                return
            self._save_dialog(peer)
            ok = self._post(account, gift, peer, my_id, as_me, anonymous, unique, message)
            if ok:
                run_on_ui_thread_delayed(self._fireworks, 120)
        except Exception:
            pass
        finally:

            def _unlock():
                self._busy = False
            run_on_ui_thread_delayed(_unlock, 600)

    def _post(self, account, gift, dialog_id, my_id, as_me, anonymous, unique, message):
        try:
            ActionCls = None
            if unique:
                for n in ('org.telegram.tgnet.TLRPC$TL_messageActionStarGiftUnique', 'org.telegram.tgnet.tl.TL_stars$TL_messageActionStarGiftUnique'):
                    ActionCls = resolve_java_class(n)
                    if ActionCls:
                        break
            if ActionCls is None:
                for n in ('org.telegram.tgnet.TLRPC$TL_messageActionStarGift', 'org.telegram.tgnet.tl.TL_stars$TL_messageActionStarGift'):
                    ActionCls = resolve_java_class(n)
                    if ActionCls:
                        break
            if ActionCls is None:
                return False
            action = ActionCls()
            try:
                action.gift = gift
            except Exception:
                return False
            if unique:
                for f, v in (('upgrade', False), ('saved', False), ('refunded', False), ('transferred', True), ('forceIn', True)):
                    try:
                        setattr(action, f, v)
                    except Exception:
                        pass
            else:
                try:
                    action.forceIn = True
                except Exception:
                    pass
                for src in ('convert_stars', 'stars'):
                    try:
                        v = getattr(gift, src, None)
                        if v is not None:
                            try:
                                action.convert_stars = int(v)
                            except Exception:
                                pass
                            break
                    except Exception:
                        pass
            if message and str(message).strip() and (not is_noise_message_text(message)):
                try:
                    Twe = resolve_java_class('org.telegram.tgnet.TLRPC$TL_textWithEntities')
                    if Twe is None:
                        Twe = resolve_java_class('org.telegram.tgnet.tl.TL_stars$TL_textWithEntities')
                    if Twe is not None:
                        twe = Twe()
                        twe.text = str(message).strip()
                        try:
                            twe.entities = ArrayList()
                        except Exception:
                            pass
                        set_ok = False
                        try:
                            action.message = twe
                            set_ok = True
                        except Exception:
                            try:
                                f = action.getClass().getDeclaredField('message')
                                f.setAccessible(True)
                                f.set(action, twe)
                                set_ok = True
                            except Exception:
                                pass
                        if set_ok:
                            try:
                                action.flags = int(getattr(action, 'flags', 0) or 0) | 2
                            except Exception:
                                pass
                except Exception:
                    pass
            if anonymous:
                for fname in ('anonymous', 'name_hidden', 'nameHidden'):
                    try:
                        setattr(action, fname, True)
                    except Exception:
                        pass
                try:
                    action.flags = int(getattr(action, 'flags', 0) or 0) | 32
                except Exception:
                    pass
            MsgCls = resolve_java_class('org.telegram.tgnet.TLRPC$TL_messageService')
            if MsgCls is None:
                return False
            msg = MsgCls()
            mid = self._new_mid(account)
            msg.id = mid
            try:
                msg.local_id = mid
            except Exception:
                pass
            msg.dialog_id = int(dialog_id)
            msg.date = self._now(account)
            msg.action = action
            msg.peer_id = self._peer(dialog_id)
            msg.send_state = 0
            try:
                msg.media_unread = False
            except Exception:
                pass
            if as_me and my_id > 0:
                msg.from_id = self._peer(my_id)
                msg.out = True
                msg.unread = False
                msg.flags = TL_MESSAGE_FLAG_FROM_ID | TL_MESSAGE_FLAG_OUT
            else:
                msg.from_id = self._peer(dialog_id)
                msg.out = False
                msg.unread = True
                msg.flags = TL_MESSAGE_FLAG_FROM_ID
            mo = MessageObject(account, msg, False, False)
            try:
                mo.setType()
            except Exception:
                pass
            tl = ArrayList()
            tl.add(msg)
            mol = ArrayList()
            mol.add(mo)
            storage_ok = False
            try:
                MessagesStorage.getInstance(account).putMessages(tl, True, False, False, 0, 0, 0)
                storage_ok = True
            except Exception:
                try:
                    MessagesStorage.getInstance(account).putMessages(tl, True, True, False, 0, 0, 0)
                    storage_ok = True
                except Exception:
                    try:
                        MessagesStorage.getInstance(account).putMessages(tl, True, True, False, 0)
                        storage_ok = True
                    except Exception:
                        pass
            ui_ok = False
            try:
                MessagesController.getInstance(account).updateInterfaceWithMessages(int(dialog_id), mol, 0)
                ui_ok = True
            except Exception:
                try:
                    MessagesController.getInstance(account).updateInterfaceWithMessages(int(dialog_id), mol)
                    ui_ok = True
                except Exception:
                    pass
            try:
                nc = resolve_java_class(NOTIFICATIONS_CONTROLLER_CLASS)
                if nc is not None:
                    inst = nc.getInstance(account)
                    arr = ArrayList()
                    arr.add(mo)
                    try:
                        inst.processNewMessages(arr, True, False, None)
                    except Exception:
                        try:
                            inst.processNewMessages(arr, True, False)
                        except Exception:
                            pass
            except Exception:
                pass
            try:
                NotificationCenter.getInstance(account).postNotificationName(NotificationCenter.dialogsNeedReload)
            except Exception:
                pass
            return storage_ok or ui_ok
        except Exception:
            return False

                                         
                                                   
    def _licensed(self):
        return True

    def _license_guard(self):
        return True

class replace_stars_balance(MethodReplacement):

    def __init__(self, plugin):
        self.plugin = plugin

    def replace_hooked_method(self, param):
        if not self.plugin._licensed():
            return None
        return self.decimal_to_amount(STARS_CONTROLLER_HAS_TON_FIELD and param.thisObject.ton)

    def decimal_to_amount(self, is_ton: bool=False):
        value = self.plugin.fr_stars_amount if not is_ton else self.plugin.fr_ton_amount
        if is_ton:
            nano_ton_value = int(value * Decimal('1000000000'))
            amount = TL_stars.TL_starsTonAmount()
            amount.amount = nano_ton_value
            return amount
        frac_part = value - int(value)
        nanos = int((frac_part * Decimal('1000000000')).to_integral_value())
        if STARS_AMOUNT_CLASS_IS_ABSTRACT:
            amount = TL_stars.StarsAmount.ofStars(int(value))
        else:
            amount = TL_stars.StarsAmount(int(value))
        amount.nanos = nanos
        return amount

def create_plugin():
    return Plugin()

def get_plugin():
    return Plugin()


