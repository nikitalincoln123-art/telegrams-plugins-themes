class cls_round_video_localizer:
    strings = {'en': {'SEND_AS': 'Send as Round Video', 'GIF_ALERT_TITLE': 'Can not send GIFs as round video', 'GIF_ALERT_MESSAGE': 'GIF-files can not be send as round video', 'VIDEO_ALERT_TITLE': 'Can not send this video as round video', 'RATIO_AND_SIZE_ALERT_MESSAGE': 'The width and height ratio should be 1:1 and should not be larger than 640 pixels.', 'VIDEO_ERROR': 'Error while sending a round video', 'DURATION_ALERT_MESSAGE': 'Video duration should not be larger than 60 seconds'}, 'ru': {'SEND_AS': 'Отправить как кружок', 'ROUND_VIDEO': 'Кружок', 'GIF_ALERT_TITLE': 'GIF-файлы не могут быть отправлены кружком', 'GIF_ALERT_MESSAGE': 'GIF-файлы не могут быть отправлены кружком', 'VIDEO_ALERT_TITLE': 'Это видео не может быть отправлено как кружок', 'RATIO_AND_SIZE_ALERT_MESSAGE': 'Соотношение сторон должно быть 1:1 и не должно превышать 640 пикселей', 'VIDEO_ERROR': 'Ошибка при отправке видео', 'DURATION_ALERT_MESSAGE': 'Продолжительность видео не должна превышать 60 секунд'}}

    def __init__(self, code: Optional[str]=None):
        if not code:
            code = Locale.getDefault().getLanguage() or 'en'
        self.language = code if code in self._get_supported_languages() else 'en'

    def get_string(self, string_key) -> str:
        return self.strings[self.language].get(string_key, self.strings['en'].get(string_key, string_key))

    def _get_supported_languages(self):
        return self.strings.keys()

    def __getitem__(self, key):
        return self.get_string(key)
round_video_localizer = cls_round_video_localizer()

def get_attach_alert_from_button(this):
    return get_private_field(this, 'a') or get_private_field(this, 'f$0')

def show_simple_alert(msg: str, title: Optional[str]):
    alert_dialog = AlertDialogBuilder(get_last_fragment().getContext())
    if title:
        alert_dialog.set_title(title)
    alert_dialog.set_message(msg)
    alert_dialog.set_positive_button('OK')
    alert_dialog.show()

def send_entries_as_round_video(chat_activity, entries: List[tuple[MediaController.PhotoEntry, Optional[VideoEditedInfo]]]):
    try:
        all_success = True
        for entry, edited_info in entries:
            split = entry.path.split('.')
            if len(split) > 1 and split[-1].lower() == 'gif':
                show_simple_alert(round_video_localizer['GIF_ALERT_MESSAGE'], round_video_localizer['GIF_ALERT_TITLE'])
                all_success = False
                continue
            if not edited_info:
                try:
                    create_comp_method = [x for x in SendMessagesHelper.getClass().getDeclaredMethods() if x.getName() == 'createCompressionSettings'][0]
                    create_comp_method.setAccessible(True)
                    edited_info = create_comp_method.invoke(None, [x for x in [entry.path, 0 if create_comp_method.getParameterCount() > 1 else None] if x != None])
                except Exception as e:
                    log(f'Failed to call createCompressionSettings: {e}')
                    edited_info = VideoEditedInfo()
                    edited_info.originalPath = entry.path
                    edited_info.originalWidth = entry.width
                    edited_info.originalHeight = entry.height
                    edited_info.rotationValue = entry.orientation
                    edited_info.originalDuration = int(entry.duration * 1000000.0)
                    edited_info.estimatedDuration = int(entry.duration * 1000.0)
                    edited_info.framerate = 30
                    edited_info.bitrate = 1000000.0
                    edited_info.estimatedSize = int(edited_info.estimatedDuration / 1000.0 * (edited_info.bitrate / 8))
            duration_us = edited_info.originalDuration if edited_info.originalDuration is not None and edited_info.originalDuration > 0 else 0
            if duration_us > 100000.0:
                duration_ms = duration_us // 1000.0
            elif duration_us > 0:
                duration_ms = duration_us
            elif entry.duration > 100000.0:
                duration_ms = entry.duration
            else:
                duration_ms = int(entry.duration * 1000.0)
            edited_info.originalDuration = int(duration_ms * 1000.0)
            start = edited_info.start if edited_info.start is not None else 0.0
            end = edited_info.end if edited_info.end is not None and edited_info.end > 0.0 else 1.0
            selected_duration_ms = (end - start) * duration_ms
            max_duration_ms = 59950
            if selected_duration_ms > max_duration_ms:
                end = start + max_duration_ms / duration_ms
                if end > 1.0:
                    end = 1.0
                    start = end - max_duration_ms / duration_ms
                    if start < 0.0:
                        start = 0.0
                edited_info.start = start
                edited_info.end = end
                edited_info.startTime = int(start * duration_ms * 1000.0)
                edited_info.endTime = int(end * duration_ms * 1000.0)
                edited_info.estimatedDuration = int(max_duration_ms)
                if edited_info.estimatedSize and edited_info.estimatedSize > 0:
                    edited_info.estimatedSize = int(edited_info.estimatedSize * (max_duration_ms / selected_duration_ms))
            else:
                if edited_info.start is None:
                    edited_info.start = start
                if edited_info.end is None:
                    edited_info.end = end
                if edited_info.startTime is None or edited_info.startTime == -1:
                    edited_info.startTime = int(start * duration_ms * 1000.0)
                if edited_info.endTime is None or edited_info.endTime == -1:
                    edited_info.endTime = int(end * duration_ms * 1000.0)
                if edited_info.estimatedDuration is None or edited_info.estimatedDuration == 0:
                    edited_info.estimatedDuration = int(selected_duration_ms)
            w = edited_info.originalWidth or entry.width
            if not w or w <= 0:
                w = 640
            h = edited_info.originalHeight or entry.height
            if not h or h <= 0:
                h = 640
            crop_state = edited_info.cropState or MediaController.CropState()
            result_size = min(w, h, 640)
            if not crop_state.initied:
                crop_state.cropPw = float(h) / float(w) if w > h else 1.0
                crop_state.cropPh = float(w) / float(h) if h > w else 1.0
                crop_state.cropPx = (1.0 - crop_state.cropPw) / 2.0 if w > h else 0.0
                crop_state.cropPy = (1.0 - crop_state.cropPh) * 0.3 if h > w else 0.0
                crop_state.initied = True
            else:
                crop_pw = crop_state.cropPw if crop_state.cropPw is not None and crop_state.cropPw > 0.0 else 1.0
                crop_ph = crop_state.cropPh if crop_state.cropPh is not None and crop_state.cropPh > 0.0 else 1.0
                crop_px = crop_state.cropPx if crop_state.cropPx is not None else 0.0
                crop_py = crop_state.cropPy if crop_state.cropPy is not None else 0.0
                crop_w_px = w * crop_pw
                crop_h_px = h * crop_ph
                target_size = min(crop_w_px, crop_h_px)
                new_crop_pw = target_size / w
                new_crop_ph = target_size / h
                if crop_w_px > crop_h_px:
                    diff = crop_pw - new_crop_pw
                    new_crop_px = crop_px + diff / 2.0
                    new_crop_py = crop_py
                elif crop_h_px > crop_w_px:
                    diff = crop_ph - new_crop_ph
                    new_crop_px = crop_px
                    new_crop_py = crop_py + diff / 2.0
                else:
                    new_crop_px = crop_px
                    new_crop_py = crop_py
                crop_state.cropPw = new_crop_pw
                crop_state.cropPh = new_crop_ph
                crop_state.cropPx = new_crop_px
                crop_state.cropPy = new_crop_py
            crop_state.transformWidth = result_size
            crop_state.transformHeight = result_size
            edited_info.cropState = crop_state
            edited_info.roundVideo = True
            edited_info.muted = True
            edited_info.resultWidth = result_size
            edited_info.resultHeight = result_size
            send_helper: SendMessagesHelper = get_send_messages_helper()
            if hasattr(chat_activity, 'getSendMessageSuggestionParams'):
                suggestion_params = [chat_activity.getSendMessageSuggestionParams()]
            else:
                suggestion_params = []
            if cls_app_resource_helpers.get_version_code() >= 62989:
                send_helper.prepareSendingVideo(get_account_instance(), entry.path, edited_info, None, None, chat_activity.getDialogId(), chat_activity.getReplyMessage(), chat_activity.getThreadMessage(), None, chat_activity.getReplyQuote(), entry.entities, entry.ttl, None, True, 0, 0, False, entry.hasSpoiler, entry.caption, chat_activity.quickReplyShortcut, chat_activity.getQuickReplyId(), 0, 0, 0, *suggestion_params)
            else:
                send_helper.prepareSendingVideo(get_account_instance(), entry.path, edited_info, None, None, chat_activity.getDialogId(), chat_activity.getReplyMessage(), chat_activity.getThreadMessage(), None, chat_activity.getReplyQuote(), entry.entities, entry.ttl, None, True, 0, False, entry.hasSpoiler, entry.caption, chat_activity.quickReplyShortcut, chat_activity.getQuickReplyId(), 0, 0, chat_activity.getSendMonoForumPeerId(), *suggestion_params)
        return all_success
    except Exception as e:
        log(e)
        BulletinHelper.show_error(round_video_localizer['VIDEO_ERROR'])
        return False

class plugin_round_video(cls_host_forwarder):
    chat_attach_alert_instance: ChatAttachAlert = None
    send_button: ChatActivityEnterView.SendButton = None
    editor_instance: PhotoViewer = None

    def __init__(self):
        super().__init__()
        self._rp_hooks = []

    def on_plugin_load(self):
        self._rp_hooks = []
        try:
            set_item_options_hook = MessageSendPreview.getClass().getDeclaredMethod('setItemOptions', ItemOptions)
            ref = self.hook_method(set_item_options_hook, hook_send_preview_item_options())
            if ref is not None:
                self._rp_hooks.append(ref)
        except Exception as e:
            log(f'[Rounder] hook setItemOptions error: {e}')
        try:
            refs = self.hook_all_constructors(ChatAttachAlert.getClass(), hook_chat_attach_alert_constructor(self)) or []
            self.chat_attach_alert_hook = refs
            if isinstance(refs, list):
                self._rp_hooks.extend(refs)
        except Exception as e:
            log(f'[Rounder] hook ChatAttachAlert error: {e}')
            self.chat_attach_alert_hook = []
        try:
            show_popup_hook = ActionBarPopupWindow.getClass().getDeclaredMethod('showAtLocation', View, JAVA_INT_TYPE, JAVA_INT_TYPE, JAVA_INT_TYPE)
            ref = self.hook_method(show_popup_hook, hook_popup_add_send_as_round_item())
            if ref is not None:
                self._rp_hooks.append(ref)
        except Exception as e:
            log(f'[Rounder] hook showAtLocation error: {e}')
        try:
            create_photo_viewer_hook = PhotoViewer.getClass().getDeclaredMethod('setParentActivity', Activity, BaseFragment, Theme.ResourcesProvider)
            ref = self.hook_method(create_photo_viewer_hook, hook_photo_viewer_parent_activity(self))
            if ref is not None:
                self._rp_hooks.append(ref)
        except Exception as e:
            log(f'[Rounder] hook setParentActivity error: {e}')

    def on_plugin_unload(self):
        for ref in list(getattr(self, '_rp_hooks', [])):
            try:
                self.unhook_method(ref)
            except Exception:
                pass
        self._rp_hooks = []
        hook_photo_viewer_parent_activity.hook_object = None
        self.chat_attach_alert_hook = []

class hook_chat_attach_alert_constructor(MethodHook):

    def __init__(self, plugin: plugin_round_video):
        self.plugin = plugin

    def after_hooked_method(self, param):
        try:
            long_click_listener_class = get_private_field(get_private_field(get_private_field(param.thisObject, 'writeButton'), 'mListenerInfo'), 'mOnLongClickListener').getClass()
            long_click_method = long_click_listener_class.getDeclaredMethod('onLongClick', View)
            ref = self.plugin.hook_method(long_click_method, hook_attach_button_long_click())
            if ref is not None:
                self.plugin._rp_hooks.append(ref)
            for hook in self.plugin.chat_attach_alert_hook:
                self.plugin.unhook_method(hook)
        except Exception as e:
            log(e)

