NATIVE_SAMPLE_RATE = 48000
SAMPLE_WIDTH_BYTES = 2
BUILTIN_VOICE_EFFECT_IDS = {EFFECT_HIGH_PITCH, EFFECT_LOW_PITCH, EFFECT_ROBOT, EFFECT_ECHO, EFFECT_REVERSE, EFFECT_DEMON, EFFECT_CUSTOM}
