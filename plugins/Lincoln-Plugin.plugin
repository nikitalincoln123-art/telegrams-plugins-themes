        if self._licensed():
            for sub in self._subs:
                try:
                    if not hasattr(type(sub), 'create_settings'):
                        continue
                    extra = sub.create_settings()
                except Exception as e:
                    log(f'[host] sub settings error: {e}')
                    continue
                if extra:
                    items.append(Divider())
                    items.extend(extra)
        return items

    def set_amount(self, value, ignore: bool=False, ton=False):
        setting = SETTING_KEY_STARS_AMOUNT if not ton else SETTING_KEY_TON_AMOUNT
        value = str(value)
        try:
            if ignore:
                self.set_setting(setting, value)
                setattr(self, setting, Decimal(value))
                return
            value = Decimal(value)
            if not ignore and getattr(self, setting) < 10 ** 10 and (value > 10 ** 10):

                def show_alert():
                    alert = AlertDialogBuilder(get_last_fragment().getParentActivity())
                    alert.set_title('Warning')
                    alert.set_message('You are trying to set the value too high. At this value, the application may start to freeze or even crash. Select a lower value. By clicking "OK", you accept the possible risks.')
                    alert.set_positive_button('ОК', lambda a, b: self.set_amount(value, True))
                    alert.set_negative_button('Cancel')
                    alert.show()
                run_on_ui_thread(show_alert)
                self.set_setting(setting, str(getattr(self, setting)))
            else:
                self.set_setting(setting, str(value))
                setattr(self, setting, Decimal(value))
                return
        except ValueError:
            self.set_setting(setting, str(getattr(self, setting)))
            BulletinHelper.show_error('Invalid amount')
        except Exception as e:
            self.log(f'{e.__traceback__.tb_lineno}:Failed to set stars amount: {e}')

    def find_class(self, name):
        try:
            return jclass(name)
        except Exception:
            return None

    def _inject_current_user(self):
        try:
            uc_cls = self.find_class(USER_CONFIG_CLASS)
            if uc_cls is None:
                return
            account = uc_cls.selectedAccount
            uc = uc_cls.getInstance(account)
            user = uc.getCurrentUser()
            if user is not None:
                self.inject_user(user)
        except Exception as e:
            log(f'[FakeNFT] inject_current_user: {e}')

    def get_names(self):
        raw = self.get_setting(SETTING_KEY_FAKE_USERNAMES_JSON, '[]')
        try:
            data = json.loads(raw)
            result = []
            seen = set()
            for x in data:
                s = str(x).strip().lstrip('@')
                if s and s.lower() not in seen:
                    seen.add(s.lower())
                    result.append(s)
            return result
        except Exception:
            return []

    def set_names(self, names, reload=False):
        clean = []
        seen = set()
        for n in names:
            s = str(n).strip().lstrip('@')
            if s and s.lower() not in seen:
                seen.add(s.lower())
                clean.append(s)
        self.set_setting(SETTING_KEY_FAKE_USERNAMES_JSON, json.dumps(clean), reload_settings=reload)

    def get_main_name(self):
        main = (self.get_setting(SETTING_KEY_MAIN_USERNAME, '') or '').strip().lstrip('@')
        if not main:
            return None
        for n in self.get_names():
            if n.lower() == main.lower():
                return n
        return None

    def inject_user(self, user):
        if user is None:
            return
        if not self._licensed():
            return
        try:
            self.inject_profile_fakes(user)
        except Exception as e:
            log(f'[Cool] inject profile fakes: {e}')
        if not self.get_setting('enabled', True):
            return
        try:
            if not bool(user.self):
                return
        except Exception:
            return
        username_cls = self.find_class(TLRPC_USERNAME_CLASS)
        if username_cls is None:
            return
        usernames = user.usernames
        if usernames is None:
            return
        names = self.get_names()
        fake_set = {n.lower() for n in names}
        main_name = self.get_main_name()
        hide_real = bool(self.get_setting('hide_real_username', False))
        try:
            i = usernames.size() - 1
            while i >= 0:
                u = usernames.get(i)
                try:
                    uname = (u.username or '').lower()
                except Exception:
                    uname = ''
                if uname in fake_set:
                    usernames.remove(i)
                i -= 1
        except Exception as e:
            log(f'[FakeNFT] cleanup: {e}')
        try:
            real_main = user.username
        except Exception:
            real_main = None
        if hide_real:
            try:
                i = usernames.size() - 1
                while i >= 0:
                    u = usernames.get(i)
                    try:
                        if bool(u.editable):
                            usernames.remove(i)
                    except Exception:
                        pass
                    i -= 1
            except Exception as e:
                log(f'[FakeNFT] hide real: {e}')
            real_main = None
        if main_name or hide_real:
            try:
                for u in usernames:
                    try:
                        if bool(u.editable):
                            u.editable = False
                            u.flags = 2
                    except Exception:
                        pass
            except Exception:
                pass
        if not hide_real and real_main and (usernames.size() == 0):
            base = username_cls()
            base.username = real_main
            base.editable = True
            base.active = True
            base.flags = 3
            usernames.add(base)
        existing = set()
        try:
            for u in usernames:
                try:
                    if u is not None and u.username:
                        existing.add(str(u.username).lower())
                except Exception:
                    pass
        except Exception:
            pass
        for name in names:
            clean = name.strip().lstrip('@')
            if not clean or clean.lower() in existing:
                continue
            u = username_cls()
            u.username = clean
            is_main = bool(main_name) and clean.lower() == main_name.lower()
            u.editable = is_main
            u.active = True
            u.flags = 3 if is_main else 2
            usernames.add(u)
            existing.add(clean.lower())
        try:
            if main_name:
                user.username = main_name
            elif hide_real:
                user.username = ''
        except Exception as e:
            log(f'[FakeNFT] set main string: {e}')

    def fill_collectible_info(self, info):
        if not self._licensed():
            return
        ton_amount = parse_float_or_default(self.get_setting('ton_amount', '5'), 5.0)
        fiat_amount = parse_float_or_default(self.get_setting('fiat_amount', '25'), 25.0)
        date_unix = parse_date_to_timestamp(self.get_setting('purchase_date', ''))
        url = (self.get_setting('fragment_url', '') or '').strip() or 'https://fragment.com'
        try:
            info.purchase_date = int(date_unix)
            info.crypto_currency = 'TON'
            info.crypto_amount = int(round(ton_amount * NANO_TON_PER_TON))
            info.currency = 'USD'
            info.amount = int(round(fiat_amount * CENTS_PER_USD))
            info.url = url
        except Exception as e:
            log(f'[FakeNFT] fill_collectible_info: {e}')

    def build_collectible_info(self):
        cls = self.find_class(TL_COLLECTIBLE_INFO_CLASS)
        if cls is None:
            return None
        info = cls()
        self.fill_collectible_info(info)
        return info

    def post_request_hook(self, request_name, account, response, error):
        if not self._licensed():
            return HookResult(strategy=HookStrategy.DEFAULT)
        if 'getCollectibleInfo' not in request_name:
            return HookResult(strategy=HookStrategy.DEFAULT)
        if not self.get_setting('enabled', True):
            return HookResult(strategy=HookStrategy.DEFAULT)
        try:
            if response is not None:
                self.fill_collectible_info(response)
                return HookResult(strategy=HookStrategy.MODIFY, response=response)
            info = self.build_collectible_info()
            if info is not None:
                return HookResult(strategy=HookStrategy.MODIFY, response=info)
        except Exception as e:
            log(f'[FakeNFT] post_request_hook: {e}')
        return HookResult(strategy=HookStrategy.DEFAULT)

    def refresh_ui(self):

        def run():
            try:
                nc_cls = self.find_class(NOTIFICATION_CENTER_CLASS)
                uc_cls = self.find_class(USER_CONFIG_CLASS)
                mc_cls = self.find_class(MESSAGES_CONTROLLER_CLASS)
                if nc_cls is None or uc_cls is None or mc_cls is None:
                    return
                account = uc_cls.selectedAccount
                nc = nc_cls.getInstance(account)
                nc.postNotificationName(nc_cls.updateInterfaces, Integer(int(mc_cls.UPDATE_MASK_ALL)))
            except Exception as e:
                log(f'[FakeNFT] refresh_ui: {e}')
        run_on_ui_thread(run)

    def _on_add(self, value):
        clean = (value or '').strip().lstrip('@')
        if clean:
            names = self.get_names()
            if clean.lower() not in [n.lower() for n in names]:
                names.append(clean)
                self.set_names(names)
        self.set_setting('add_username', '', reload_settings=True)
        self.refresh_ui()

    def _make_set_main(self, name):

        def cb(view):
            current = (self.get_setting(SETTING_KEY_MAIN_USERNAME, '') or '').lower()
            if current == name.lower():
                self.set_setting(SETTING_KEY_MAIN_USERNAME, '')
                try:
                    BulletinHelper.show_info(f'@{name} больше не главный')
                except Exception:
                    pass
            else:
                self.set_setting(SETTING_KEY_MAIN_USERNAME, name)
                try:
                    BulletinHelper.show_info(f'@{name} теперь главный')
                except Exception:
                    pass
            if fake_username_list_adapter is not None:
                try:
                    fake_username_list_adapter.notifyDataSetChanged()
                except Exception:
                    pass
            self.refresh_ui()
        return cb

    def _make_remove_name(self, name):

        def cb(view):
            names = [n for n in self.get_names() if n.lower() != name.lower()]
            if (self.get_setting(SETTING_KEY_MAIN_USERNAME, '') or '').lower() == name.lower():
                self.set_setting(SETTING_KEY_MAIN_USERNAME, '')
            self.set_names(names, reload=True)
            self.refresh_ui()
            try:
                BulletinHelper.show_info(f'Удалён @{name}')
            except Exception:
                pass
        return cb

    def _make_move(self, index, delta):

        def cb(view):
            names = self.get_names()
            new_index = index + delta
            if 0 <= index < len(names) and 0 <= new_index < len(names):
                names[index], names[new_index] = (names[new_index], names[index])
                self.set_names(names, reload=True)
                self.refresh_ui()
        return cb

    def _make_remove_index(self, index):

        def cb(view):
            names = self.get_names()
            if 0 <= index < len(names):
                removed = names.pop(index)
                if (self.get_setting(SETTING_KEY_MAIN_USERNAME, '') or '').lower() == removed.lower():
                    self.set_setting(SETTING_KEY_MAIN_USERNAME, '')
                self.set_names(names, reload=True)
                self.refresh_ui()
                try:
                    BulletinHelper.show_info(f'Удалён @{removed}')
                except Exception:
                    pass
        return cb

    def _recalc_fiat(self, ton):
        rate = fetch_ton_usd_rate()
        if rate is None:
            rate = parse_float_or_default(self.get_setting('ton_rate', '0'), 0.0)
        if not rate:
            try:
                BulletinHelper.show_error('Не удалось получить курс TON')
            except Exception:
                pass
            return
        usd = round(ton * rate, 2)
        self.set_setting('ton_rate', str(rate))

        def apply():
            self.set_setting('fiat_amount', str(usd), reload_settings=True)
            try:
                BulletinHelper.show_info(f'{ton:g} TON ≈ {usd:g} $ (курс {rate:g} $)')
            except Exception:
                pass
            self.refresh_ui()
        run_on_ui_thread(apply)

    def _on_ton_change(self, value):
        if self.get_setting('auto_fiat', True):
            ton = parse_float_or_default(value, 0.0)
            if ton > 0:
                run_on_queue(lambda: self._recalc_fiat(ton))

    def _on_refresh_rate(self, view):
        ton = parse_float_or_default(self.get_setting('ton_amount', '5'), 5.0)
        run_on_queue(lambda: self._recalc_fiat(ton))

    def _create_list_page(self):
        names = self.get_names()
        items = [Header(text='Список юзернеймов')]
        view = None
        if names:
            context = None
            try:
                from client_utils import get_last_fragment
                f = get_last_fragment()
                if f is not None:
                    context = f.getParentActivity()
            except Exception:
                context = None
            if context is not None:
                view = build_username_drag_list_view(self, context)
        if view is not None:
            items.append(Custom(view=view))
            items.append(Divider(text='Зажмите строку и перетащите, чтобы изменить порядок. ★ — сделать главным (нажмите повторно, чтобы снять). ✕ — удалить.'))
        elif names:
            total = len(names)
            main = (self.get_setting(SETTING_KEY_MAIN_USERNAME, '') or '').lower()
            for i, name in enumerate(names):
                is_main = name.lower() == main
                items.append(Text(text=('★ ' if is_main else '') + f'{i + 1}. @{name}', icon='msg_mention', accent=is_main, on_click=self._make_set_main(name), on_long_click=self._make_remove_index(i)))
                if i > 0:
                    items.append(Text(text='↑ переместить выше', icon='msg_arrow_up', on_click=self._make_move(i, -1)))
                if i < total - 1:
                    items.append(Text(text='↓ переместить ниже', icon='msg_arrow_down', on_click=self._make_move(i, +1)))
            items.append(Divider(text='Нажатие на ник — сделать главным (★). Стрелки — порядок. Удержание — удалить.'))
        else:
            items.append(Text(text='Список пуст', icon='msg_info'))
            items.append(Divider(text='Вернитесь назад и добавьте юзернейм.'))
        return items

    def _on_test_click(self, view):
        ton = parse_float_or_default(self.get_setting('ton_amount', '5'), 5.0)
        fiat = parse_float_or_default(self.get_setting('fiat_amount', '25'), 25.0)
        date_unix = parse_date_to_timestamp(self.get_setting('purchase_date', ''))
        date_str = datetime.datetime.fromtimestamp(date_unix).strftime('%Y-%m-%d %H:%M')
        main = self.get_main_name() or '—'
        names = ', '.join(('@' + n for n in self.get_names())) or '—'
        BulletinHelper.show_info(f'{names} · главный: @{main} · {ton:g} TON ({fiat:g} $) · {date_str}')
