def parse_date_to_timestamp(date_str):
    date_str = (date_str or '').strip()
    if not date_str:
        return int(time.time())
    for fmt in ('%Y-%m-%d %H:%M', '%Y-%m-%d', '%d.%m.%Y %H:%M', '%d.%m.%Y'):
        try:
            return int(datetime.datetime.strptime(date_str, fmt).timestamp())
        except ValueError:
            continue
    return int(time.time())

def parse_float_or_default(value, default):
    try:
        return float(str(value).replace(',', '.').strip())
    except (ValueError, TypeError):
        return default

def fetch_ton_usd_rate():
    try:
        r = requests.get(COINGECKO_TON_PRICE_URL, headers={'User-Agent': 'Mozilla/5.0'}, timeout=10)
        if r.status_code != 200:
            return None
        return float(r.json()['the-open-network']['usd'])
    except Exception as e:
        log(f'[FakeNFT] rate fetch: {e}')
        return None

class hook_get_user_inject_fake_nft(MethodHook):

    def __init__(self, plugin):
        self.plugin = plugin

    def after_hooked_method(self, param):
        try:
            self.plugin.inject_user(param.getResult())
        except Exception as e:
            log(f'[FakeNFT] GetUserHook: {e}')

