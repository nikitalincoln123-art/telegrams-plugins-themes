class hook_fragment_username_sheet_fill_info(MethodHook):

    def __init__(self, plugin):
        self.plugin = plugin

    def before_hooked_method(self, param):
        try:
            if not self.plugin.get_setting('enabled', True):
                return
            info = param.args[4]
            if info is not None:
                self.plugin.fill_collectible_info(info)
        except Exception as e:
            log(f'[FakeNFT] FragmentSheetHook: {e}')

def build_username_list_row(context):
    AndroidUtilities = jclass('org.telegram.messenger.AndroidUtilities')
    LinearLayout = jclass('android.widget.LinearLayout')
    TextView = jclass('android.widget.TextView')
    Theme = jclass('org.telegram.ui.ActionBar.Theme')
    TypedValue = jclass('android.util.TypedValue')
    Gravity = jclass('android.view.Gravity')
    LayoutParams = jclass('android.widget.LinearLayout$LayoutParams')
    row = LinearLayout(context)
    row.setOrientation(LinearLayout.HORIZONTAL)
    row.setGravity(Gravity.CENTER_VERTICAL)
    pad = AndroidUtilities.dp(16)
    row.setPadding(pad, AndroidUtilities.dp(12), pad, AndroidUtilities.dp(12))
    row.setLayoutParams(LayoutParams(LayoutParams.MATCH_PARENT, AndroidUtilities.dp(56)))
    handle = TextView(context)
    handle.setText('≡')
    handle.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 20)
    handle.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteGrayText))
    handle.setLayoutParams(LayoutParams(AndroidUtilities.dp(28), LayoutParams.WRAP_CONTENT))
    tv = TextView(context)
    tv.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 16)
    tv.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteBlackText))
    tv.setLines(1)
    tv.setSingleLine(True)
    tlp = LayoutParams(0, LayoutParams.WRAP_CONTENT)
    tlp.weight = 1.0
    tlp.leftMargin = AndroidUtilities.dp(8)
    tv.setLayoutParams(tlp)
    star = TextView(context)
    star.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 18)
    star.setPadding(AndroidUtilities.dp(8), 0, AndroidUtilities.dp(8), 0)
    rem = TextView(context)
    rem.setText('✕')
    rem.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 18)
    rem.setTextColor(Theme.getColor(Theme.key_text_RedBold))
    rem.setPadding(AndroidUtilities.dp(8), 0, AndroidUtilities.dp(4), 0)
    row.addView(handle)
    row.addView(tv)
    row.addView(star)
    row.addView(rem)
    return row

def init_username_list_proxies():
    global username_list_proxies_ready, cls_username_list_adapter, cls_username_view_holder, cls_username_drag_callback
    if username_list_proxies_ready is not None:
        return username_list_proxies_ready
    try:
        from extera_utils.classes import Base, java_subclass, joverride
        RecyclerView = jclass('androidx.recyclerview.widget.RecyclerView')
        ViewHolderCls = jclass('androidx.recyclerview.widget.RecyclerView$ViewHolder')
        AdapterBase = jclass('androidx.recyclerview.widget.RecyclerView$Adapter')
        ItemTouchHelper = jclass('androidx.recyclerview.widget.ItemTouchHelper')
        CallbackBase = jclass('androidx.recyclerview.widget.ItemTouchHelper$Callback')
        Theme = jclass('org.telegram.ui.ActionBar.Theme')

        @java_subclass(ViewHolderCls)
        class _Holder(Base):
            pass

        @java_subclass(AdapterBase)
        class _Adapter(Base):

            @joverride('onCreateViewHolder', ['android.view.ViewGroup', 'int'])
            def on_create(self, parent, view_type):
                row = build_username_list_row(parent.getContext())
                return _Holder.new_java_instance(row)

            @joverride('onBindViewHolder', ['androidx.recyclerview.widget.RecyclerView$ViewHolder', 'int'])
            def on_bind(self, holder, position):
                if active_fake_nft_plugin is None:
                    return
                names = active_fake_nft_plugin.get_names()
                if position < 0 or position >= len(names):
                    return
                name = names[position]
                main = (active_fake_nft_plugin.get_setting(SETTING_KEY_MAIN_USERNAME, '') or '').lower()
                item = holder.itemView
                tv = item.getChildAt(1)
                star = item.getChildAt(2)
                rem = item.getChildAt(3)
                tv.setText('@' + name)
                is_main = name.lower() == main
                star.setText('★' if is_main else '☆')
                star.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteBlueText if is_main else Theme.key_windowBackgroundWhiteGrayText))
                star.setOnClickListener(OnClickListener(active_fake_nft_plugin._make_set_main(name)))
                rem.setOnClickListener(OnClickListener(active_fake_nft_plugin._make_remove_name(name)))

            @joverride('getItemCount', [])
            def get_count(self):
                if active_fake_nft_plugin is None:
                    return 0
                return len(active_fake_nft_plugin.get_names())

        @java_subclass(CallbackBase)
        class _Callback(Base):

            @joverride('getMovementFlags', ['androidx.recyclerview.widget.RecyclerView', 'androidx.recyclerview.widget.RecyclerView$ViewHolder'])
            def get_flags(self, rv, vh):
                return CallbackBase.makeMovementFlags(ItemTouchHelper.UP | ItemTouchHelper.DOWN, 0)

            @joverride('onMove', ['androidx.recyclerview.widget.RecyclerView', 'androidx.recyclerview.widget.RecyclerView$ViewHolder', 'androidx.recyclerview.widget.RecyclerView$ViewHolder'])
            def on_move(self, rv, vh, target):
                if active_fake_nft_plugin is None:
                    return False
                frm = vh.getAdapterPosition()
                to = target.getAdapterPosition()
                names = active_fake_nft_plugin.get_names()
                if 0 <= frm < len(names) and 0 <= to < len(names):
                    names.insert(to, names.pop(frm))
                    active_fake_nft_plugin.set_names(names)
                    if fake_username_list_adapter is not None:
                        fake_username_list_adapter.notifyItemMoved(frm, to)
                    return True
                return False

            @joverride('onSwiped', ['androidx.recyclerview.widget.RecyclerView$ViewHolder', 'int'])
            def on_swiped(self, vh, direction):
                return None

            @joverride('isLongPressDragEnabled', [])
            def long_press(self):
                return True

            @joverride('clearView', ['androidx.recyclerview.widget.RecyclerView', 'androidx.recyclerview.widget.RecyclerView$ViewHolder'])
            def clear_view(self, rv, vh):
                super().clear_view(rv, vh)
                if active_fake_nft_plugin is not None:
                    active_fake_nft_plugin.refresh_ui()
        cls_username_list_adapter = _Adapter
        cls_username_view_holder = _Holder
        cls_username_drag_callback = _Callback
        username_list_proxies_ready = True
    except Exception as e:
        log(f'[FakeNFT] proxy unavailable: {e}')
        username_list_proxies_ready = False
    return username_list_proxies_ready

def build_username_drag_list_view(plugin, context):
    global fake_username_list_adapter
    try:
        if not init_username_list_proxies():
            return None
        RecyclerView = jclass('androidx.recyclerview.widget.RecyclerView')
        LinearLayoutManager = jclass('androidx.recyclerview.widget.LinearLayoutManager')
        ItemTouchHelper = jclass('androidx.recyclerview.widget.ItemTouchHelper')
        AndroidUtilities = jclass('org.telegram.messenger.AndroidUtilities')
        LayoutParams = jclass('android.widget.FrameLayout$LayoutParams')
        rv = RecyclerView(context)
        rv.setLayoutManager(LinearLayoutManager(context))
        adapter = cls_username_list_adapter.new_java_instance()
        fake_username_list_adapter = adapter
        rv.setAdapter(adapter)
        helper = ItemTouchHelper(cls_username_drag_callback.new_java_instance())
        helper.attachToRecyclerView(rv)
        count = max(1, len(plugin.get_names()))
        rv.setLayoutParams(LayoutParams(LayoutParams.MATCH_PARENT, AndroidUtilities.dp(56) * count))
        return rv
    except Exception as e:
        log(f'[FakeNFT] build drag view: {e}')
        return None
JAVA_INTEGER_CLASS = jclass('java.lang.Integer')

def make_single_method_proxy_class(java_class, method_name, default_value=None):

    def _run(instance, *java_args):
        try:
            return instance._fn(*java_args)
        except Exception:
            return default_value

    def __init__(self, fn, *args, **kwargs):
        self._fn = fn
        super(type(self), self).__init__()
    return type('Proxy_' + java_class.__name__.replace('$', '_'), (dynamic_proxy(java_class),), {'__init__': __init__, method_name: _run})
RUNNABLE_PROXY_CLASS = make_single_method_proxy_class(jclass('java.lang.Runnable'), 'run')
REQUEST_DELEGATE_PROXY_CLASS = make_single_method_proxy_class(RequestDelegate, 'run')
DIALOG_ON_CLICK_LISTENER_CLASS = jclass('android.content.DialogInterface$OnClickListener')

class cls_dialog_click_listener(dynamic_proxy(DIALOG_ON_CLICK_LISTENER_CLASS)):

    def __init__(self, callback):
        super().__init__()
        self._callback = callback

    def onClick(self, dialog, which):
        try:
            dialog.dismiss()
        except Exception:
            pass
        try:
            self._callback(int(which))
        except Exception:
            pass

def resolve_drawable_id(*names):
    for name in names:
        try:
            return int(getattr(R.drawable, name))
        except Exception:
            pass
    return 0
