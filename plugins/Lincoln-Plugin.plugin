class hook_picker_send_button_long_click(MethodHook):

    def before_hooked_method(self, param):
        plugin_round_video.send_button = param.thisObject
        plugin_round_video.editor_instance = get_attach_alert_from_button(param.thisObject)

    def after_hooked_method(self, param):
        plugin_round_video.send_button = None
        plugin_round_video.editor_instance = None

class hook_popup_add_send_as_round_item(MethodHook):

    def before_hooked_method(self, param):
        try:
            popup: ActionBarPopupWindow = param.thisObject
            editor_instance: PhotoViewer = plugin_round_video.editor_instance
            if not popup or not editor_instance:
                return
            images_arr_locals = get_private_field(editor_instance, 'imagesArrLocals')
            current_index = get_private_field(editor_instance, 'currentIndex')
            if not images_arr_locals or current_index < 0 or current_index >= images_arr_locals.size():
                return
            entry = images_arr_locals.get(current_index)
            if not hasattr(entry, 'isVideo') or not entry.isVideo:
                return
            cell = ActionBarMenuSubItem(get_last_fragment().getContext(), False, True, None)
            cell.setTextAndIcon(round_video_localizer['SEND_AS'], cls_app_resource_helpers.get_icon_id('input_video'))
            cell.setMinimumWidth(AndroidUtilities.dp(196))
            try:
                fCell = popup.getContentView().getChildAt(0).getChildAt(0).getChildAt(0)
                if fCell and isinstance(fCell, ActionBarMenuSubItem):
                    cell.setColors(fCell.getTextView().getTextColors().getColors()[0], fCell.getImageView().getColorFilter().getColor())
            except:
                pass
            popup.getContentView().addView(cell, LayoutHelper.createLinear(-1, 48))
            cell.setOnClickListener(OnClickListener(lambda *_: self.on_send_as_round_click(editor_instance, popup, entry)))
        except Exception as e:
            log(e)

    def on_send_as_round_click(self, editor: PhotoViewer, popup: ActionBarPopupWindow, entry: MediaController.PhotoEntry):
        popup.dismiss()
        try:
            apply_caption_method = editor.getClass().getDeclaredMethod('applyCaption')
            apply_caption_method.setAccessible(True)
            apply_caption_method.invoke(editor)
            get_vei_method = editor.getClass().getDeclaredMethod('getCurrentVideoEditedInfo')
            get_vei_method.setAccessible(True)
            edited_info = get_vei_method.invoke(editor)
            chat_activity = get_private_field(editor, 'parentChatActivity')
            if not chat_activity:
                return
            if send_entries_as_round_video(chat_activity, [(entry, edited_info)]):
                chat_attach_alert = get_private_field(chat_activity, 'chatAttachAlert')
                if chat_attach_alert:
                    chat_attach_alert.dismiss(True)
                editor.closePhoto(False, False)
        except Exception as e:
            log(e)
            BulletinHelper.show_error(round_video_localizer['VIDEO_ERROR'])

class hook_attach_button_long_click(MethodHook):

    def before_hooked_method(self, param):
        plugin_round_video.send_button = param.thisObject
        plugin_round_video.chat_attach_alert_instance = get_attach_alert_from_button(param.thisObject)

    def after_hooked_method(self, param):
        plugin_round_video.chat_attach_alert_instance = None
        plugin_round_video.send_button = None

class hook_send_preview_item_options(MethodHook):

    def before_hooked_method(self, param):
        try:
            options: ItemOptions = param.args[0]
            chat_attach_alert: ChatAttachAlert = plugin_round_video.chat_attach_alert_instance
            if not options or not chat_attach_alert:
                return
            current_layout = get_private_field(chat_attach_alert, 'currentAttachLayout')
            entries = None
            if isinstance(current_layout, ChatAttachAlertPhotoLayout):
                photo_layout = current_layout
                selected_photos = photo_layout.getSelectedPhotos()
                if selected_photos:
                    entries = selected_photos.values()
            elif isinstance(current_layout, ChatAttachAlertPhotoLayoutPreview):
                preview_layout = current_layout
                groups_view = get_private_field(preview_layout, 'groupsView')
                if groups_view:
                    entries = groups_view.getPhotos()
            if entries and (not entries.isEmpty()):
                values = entries.toArray()
                if not all((x and x.isVideo for x in values)):
                    return
                entries = values
            if entries and len(entries) > 0:
                entries = [(x, None) for x in entries]
                options.add(cls_app_resource_helpers.get_icon_id('input_video'), round_video_localizer['SEND_AS'], cls_runnable_callback(lambda: self.on_send_as_round_click(param.thisObject, chat_attach_alert, entries)))
        except Exception as e:
            log(e)

    def on_send_as_round_click(self, preview: Optional[MessageSendPreview], alert: ChatAttachAlert, entries: List[Tuple[MediaController.PhotoEntry, Optional[VideoEditedInfo]]]):
        try:
            chat_activity = alert.baseFragment
            if not chat_activity:
                if preview:
                    preview.dismiss(False)
                return
            if send_entries_as_round_video(chat_activity, entries):
                alert.dismiss(True)
                if preview:
                    preview.dismiss(True)
        except Exception as e:
            log(e)
            BulletinHelper.show_error(round_video_localizer['VIDEO_ERROR'])

class cls_runnable_callback(dynamic_proxy(Runnable)):

    def __init__(self, fn: Callable):
        super().__init__()
        self.fn = fn

    def run(self):
        self.fn()

class cls_app_resource_helpers:

    @staticmethod
    def get_icon_id(name: str) -> int:
        context = get_last_fragment().getContext()
        return context.getResources().getIdentifier(name, 'drawable', context.getPackageName())

    @staticmethod
    def get_version_code() -> int:
        context = get_last_fragment().getContext()
        return context.getPackageManager().getPackageInfo(context.getPackageName(), 0).versionCode
DEFAULT_PINNED_LIMIT = 100000
PINNED_STATE_FILE_NAME = 'unlimited_pins_state.json'
PIN_RESTORE_RETRY_LIMIT = 20

class plugin_unlimited_pins(cls_host_forwarder):

    def __init__(self):
        super().__init__()
        self._original_limits: List[int] = []
        self._restore_attempts: int = 0
        self._hook_refs: List[Any] = []
        self._restored_folders: Dict[str, bool] = {}
        self._in_restore: bool = False
        self._save_debounce_pending: bool = False

    def _get_cache_dir(self) -> str:
        try:
            from com.exteragram.messenger.plugins import PluginsController
            plugins_dir = PluginsController.getInstance().pluginsDir.getAbsolutePath()
            import os
            cache_dir = os.path.join(plugins_dir, 'cache')
            os.makedirs(cache_dir, exist_ok=True)
            return cache_dir
        except Exception:
            import os
            fallback = os.path.join(os.getcwd(), 'cache')
            os.makedirs(fallback, exist_ok=True)
            return fallback

    def _read_json_file(self, file_name: str, default: Any):
        try:
            import os, json
            path = os.path.join(self._get_cache_dir(), file_name)
            if not os.path.exists(path):
                import json as _json
                return _json.loads(_json.dumps(default))
            with open(path, 'r', encoding='utf-8') as f:
                return json.load(f)
        except Exception as e:
            log(f'[UnlimitedPins] JSON read error for {file_name}: {e}')
            import json as _json
            return _json.loads(_json.dumps(default))

    def _write_json_file(self, file_name: str, data: Any):
        try:
            import os, json
            path = os.path.join(self._get_cache_dir(), file_name)
            with open(path, 'w', encoding='utf-8') as f:
                json.dump(data, f, ensure_ascii=False)
        except Exception as e:
            log(f'[UnlimitedPins] JSON write error for {file_name}: {e}')

    def _list_active_accounts(self) -> List[int]:
        accounts: List[int] = []
        try:
            for account_id in range(UserConfig.MAX_ACCOUNT_COUNT):
                try:
                    uc = UserConfig.getInstance(account_id)
                    if uc.isClientActivated():
                        accounts.append(account_id)
                except Exception:
                    pass
        except Exception:
            pass
        if not accounts:
            try:
                accounts = [UserConfig.selectedAccount]
            except Exception:
                accounts = [0]
        return accounts

    def _list_folder_ids(self, account_id: int) -> List[int]:
        folder_ids: List[int] = [0]
        try:
            mc = MessagesController.getInstance(account_id)
            filters = getattr(mc, 'dialogFilters', None)
            if filters is not None:
                try:
                    size = filters.size() if hasattr(filters, 'size') else len(filters)
                    for i in range(size):
                        try:
                            folder_id = int(filters.get(i).id if hasattr(filters, 'get') else filters[i].id)
                            if folder_id not in folder_ids:
                                folder_ids.append(folder_id)
                        except Exception:
                            pass
                except Exception:
                    pass
        except Exception:
            pass
        return folder_ids

    def _collect_pinned_for_folder(self, account_id: int, folder_id: int) -> List[int]:
        result: List[int] = []
        try:
            mc = MessagesController.getInstance(account_id)
            dialogs = mc.getDialogs(folder_id)
            size = dialogs.size() if hasattr(dialogs, 'size') else len(dialogs)
            for i in range(size):
                d = dialogs.get(i) if hasattr(dialogs, 'get') else dialogs[i]
                if getattr(d, 'isFolder', False):
                    continue
                if getattr(d, 'pinned', False):
                    try:
                        result.append(int(d.id))
                    except Exception:
                        pass
                else:
                    break
        except Exception as e:
            log(f'[UnlimitedPins] collect pinned error a={account_id} f={folder_id}: {e}')
        return result

    def _collect_all_pins(self) -> Dict[str, Dict[str, List[int]]]:
        data: Dict[str, Dict[str, List[int]]] = {}
        try:
            for acc in self._list_active_accounts():
                folders = self._list_folder_ids(acc)
                per_acc: Dict[str, List[int]] = {}
                for fid in folders:
                    per_acc[str(fid)] = self._collect_pinned_for_folder(acc, fid)
                data[str(acc)] = per_acc
        except Exception as e:
            log(f'[UnlimitedPins] collect all pins error: {e}')
        return data

    def _save_pinned_state(self) -> None:
        if not self.get_setting('up_persist_pins', True):
            return
        try:
            state = {'version': 1, 'accounts': self._collect_all_pins()}
            self._write_json_file(PINNED_STATE_FILE_NAME, state)
            log('[UnlimitedPins] Saved pinned chats state')
        except Exception as e:
            log(f'[UnlimitedPins] save pinned state error: {e}')

    def _schedule_save(self, delay: int=600) -> None:
        try:
            if self._in_restore or not self.get_setting('up_persist_pins', True):
                return
            if self._save_debounce_pending:
                return
            self._save_debounce_pending = True

            def _do_save():
                try:
                    self._save_pinned_state()
                finally:
                    self._save_debounce_pending = False
            run_on_ui_thread(_do_save, delay=delay)
        except Exception:
            pass

    def _restore_folder_from_state(self, account_id: int, folder_id: int, desired_ids: List[int]) -> None:
        try:
            if len(desired_ids) > 300:
                desired_ids = desired_ids[:300]
            mc = MessagesController.getInstance(account_id)
            current_ids = self._collect_pinned_for_folder(account_id, folder_id)
            if current_ids == desired_ids:
                return

            def _batch_restore():
                self._in_restore = True
                try:
                    current_set = set(current_ids)
                    desired_set = set(desired_ids)
                    to_unpin = [did for did in current_ids if did not in desired_set]
                    for did in to_unpin:
                        try:
                            mc.pinDialog(JLong(did), False, None, JLong(-1))
                        except Exception:
                            try:
                                mc.pinDialog(did, False, None, -1)
                            except Exception:
                                pass
                    if [d for d in current_ids if d in desired_set] != [d for d in desired_ids if d in current_set]:
                        shared = [d for d in current_ids if d in desired_set]
                        for did in shared:
                            try:
                                mc.pinDialog(JLong(did), False, None, JLong(-1))
                            except Exception:
                                try:
                                    mc.pinDialog(did, False, None, -1)
                                except Exception:
                                    pass
                    for did in desired_ids:
                        try:
                            mc.pinDialog(JLong(did), True, None, JLong(-1))
                        except Exception:
                            try:
                                mc.pinDialog(did, True, None, -1)
                            except Exception:
                                pass
                finally:
                    self._in_restore = False
                log(f'[UnlimitedPins] Restored pinned order for acc={account_id} folder={folder_id} count={len(desired_ids)}')
            run_on_ui_thread(_batch_restore)
        except Exception as e:
            log(f'[UnlimitedPins] restore folder error a={account_id} f={folder_id}: {e}')

    def _restore_from_saved_state(self) -> None:
        try:
            if not self.get_setting('up_restore_pins_on_start', True):
                return
            data = self._read_json_file(PINNED_STATE_FILE_NAME, {'accounts': {}})
            accounts_map = data.get('accounts', {}) or {}
            for acc_key, folders_map in accounts_map.items():
                try:
                    acc_id = int(acc_key)
                except Exception:
                    continue
                if not isinstance(folders_map, dict):
                    continue
                for folder_key, dialog_ids in folders_map.items():
                    try:
                        fid = int(folder_key)
                        key = f'{acc_id}:{fid}'
                        if self._restored_folders.get(key):
                            continue
                        self._restore_folder_from_state(acc_id, fid, list(dialog_ids or []))
                        self._restored_folders[key] = True
                    except Exception:
                        pass
        except Exception as e:
            log(f'[UnlimitedPins] restore pins error: {e}')

    class _PinDialogHook(MethodHook):

        def __init__(self, plugin: 'UnlimitedPins'):
            self.plugin = plugin

        def after_hooked_method(self, param):
            try:
                if self.plugin.get_setting('up_persist_pins', True) and (not self.plugin._in_restore):
                    self.plugin._schedule_save()
            except Exception:
                pass

    class _ReorderPinnedHook(MethodHook):

        def __init__(self, plugin: 'UnlimitedPins'):
            self.plugin = plugin

        def after_hooked_method(self, param):
            try:
                if self.plugin.get_setting('up_persist_pins', True) and (not self.plugin._in_restore):
                    self.plugin._schedule_save()
            except Exception:
                pass

    class _GetDialogsHook(MethodHook):

        def __init__(self, plugin: 'UnlimitedPins'):
            self.plugin = plugin

        def after_hooked_method(self, param):
            try:
                if not self.plugin.get_setting('up_restore_pins_on_start', True):
                    return
                mc_instance = param.thisObject
                try:
                    account_id = int(get_private_field(mc_instance, 'currentAccount'))
                except Exception:
                    account_id = UserConfig.selectedAccount
                try:
                    folder_id = int(param.args[0])
                except Exception:
                    folder_id = 0
                key = f'{account_id}:{folder_id}'
                if self.plugin._restored_folders.get(key):
                    return
                data = self.plugin._read_json_file(PINNED_STATE_FILE_NAME, {'accounts': {}})
                acc_map = (data.get('accounts', {}) or {}).get(str(account_id)) or {}
                desired = acc_map.get(str(folder_id))
                if isinstance(desired, list) and desired:
                    self.plugin._restore_folder_from_state(account_id, folder_id, list(desired))
                self.plugin._restored_folders[key] = True
            except Exception:
                pass

    def _install_hooks(self) -> None:
        try:
            MC = jclass('org.telegram.messenger.MessagesController')
            try:
                pin_method = MC.getClass().getDeclaredMethod('pinDialog', JLong.TYPE, JBoolean.TYPE, jclass('org.telegram.tgnet.TLRPC$InputPeer'), JLong.TYPE)
                pin_method.setAccessible(True)
                self._hook_refs.append(self.hook_method(pin_method, plugin_unlimited_pins._PinDialogHook(self)))
            except Exception as e:
                log(f'[UnlimitedPins] hook pinDialog failed: {e}')
            try:
                reorder_method = MC.getClass().getDeclaredMethod('reorderPinnedDialogs', Integer.TYPE, jclass('java.util.ArrayList'), JLong.TYPE)
                reorder_method.setAccessible(True)
                self._hook_refs.append(self.hook_method(reorder_method, plugin_unlimited_pins._ReorderPinnedHook(self)))
            except Exception as e:
                log(f'[UnlimitedPins] hook reorderPinnedDialogs failed: {e}')
            try:
                get_dialogs_method = MC.getClass().getDeclaredMethod('getDialogs', Integer.TYPE)
                get_dialogs_method.setAccessible(True)
                self._hook_refs.append(self.hook_method(get_dialogs_method, plugin_unlimited_pins._GetDialogsHook(self)))
            except Exception as e:
                log(f'[UnlimitedPins] hook getDialogs failed: {e}')
        except Exception as e:
            log(f'[UnlimitedPins] install hooks error: {e}')

    def _read_current_limits(self) -> List[int]:
        controller = get_messages_controller()
        if controller is None:
            return []
        return [int(getattr(controller, 'maxPinnedDialogsCountDefault', 0) or 0), int(getattr(controller, 'maxPinnedDialogsCountPremium', 0) or 0), int(getattr(controller, 'maxFolderPinnedDialogsCountDefault', 0) or 0), int(getattr(controller, 'maxFolderPinnedDialogsCountPremium', 0) or 0), int(getattr(controller, 'dialogFiltersPinnedLimitDefault', 0) or 0), int(getattr(controller, 'dialogFiltersPinnedLimitPremium', 0) or 0)]

    def _apply_limits(self, value: int) -> None:
        controller = get_messages_controller()
        if controller is None:
            log('[UnlimitedPins] MessagesController is None, cannot apply limits')
            return
        try:
            set_private_field(controller, 'maxPinnedDialogsCountDefault', Integer(value))
            set_private_field(controller, 'maxPinnedDialogsCountPremium', Integer(value))
            set_private_field(controller, 'maxFolderPinnedDialogsCountDefault', Integer(value))
            set_private_field(controller, 'maxFolderPinnedDialogsCountPremium', Integer(value))
            set_private_field(controller, 'dialogFiltersPinnedLimitDefault', Integer(value))
            set_private_field(controller, 'dialogFiltersPinnedLimitPremium', Integer(value))
            log(f'[UnlimitedPins] Applied max pinned limits = {value}')
        except Exception as e:
            log(f'[UnlimitedPins] Failed to apply limits: {e}')

    def _restore_limits(self) -> None:
        if not self._original_limits:
            return
        controller = get_messages_controller()
        if controller is None:
            return
        try:
            d_def, d_pre, f_def, f_pre, df_def, df_pre = self._original_limits
            set_private_field(controller, 'maxPinnedDialogsCountDefault', Integer(d_def))
            set_private_field(controller, 'maxPinnedDialogsCountPremium', Integer(d_pre))
            set_private_field(controller, 'maxFolderPinnedDialogsCountDefault', Integer(f_def))
            set_private_field(controller, 'maxFolderPinnedDialogsCountPremium', Integer(f_pre))
            set_private_field(controller, 'dialogFiltersPinnedLimitDefault', Integer(df_def))
            set_private_field(controller, 'dialogFiltersPinnedLimitPremium', Integer(df_pre))
            log('[UnlimitedPins] Restored original pinned limits')
        except Exception as e:
            log(f'[UnlimitedPins] Failed to restore limits: {e}')

    def on_plugin_load(self):
        try:
            self._original_limits = self._read_current_limits()
            max_value = int(self.get_setting('up_max_value', str(DEFAULT_PINNED_LIMIT))) if isinstance(self.get_setting('up_max_value', DEFAULT_PINNED_LIMIT), str) else int(self.get_setting('up_max_value', DEFAULT_PINNED_LIMIT))
            if self.get_setting('up_enabled', True):
                self._apply_limits(max_value)
            self._install_hooks()
            log('[UnlimitedPins] Loaded')
        except Exception as e:
            log(f'[UnlimitedPins] on_plugin_load error: {e}')

    def on_plugin_unload(self):
        try:
            for ref in list(getattr(self, '_hook_refs', [])):
                try:
                    self.unhook_method(ref)
                except Exception:
                    pass
            self._hook_refs = []
        except Exception as e:
            log(f'[UnlimitedPins] unhook refs error: {e}')
        try:
            if self.get_setting('up_persist_pins', True):
                self._save_pinned_state()
            if self.get_setting('up_restore_on_unload', True):
                self._restore_limits()
            log('[UnlimitedPins] Unloaded')
        except Exception as e:
            log(f'[UnlimitedPins] on_plugin_unload error: {e}')

    def _on_enabled_change(self, new_value: bool):
        try:
            if new_value:
                max_value = int(self.get_setting('up_max_value', DEFAULT_PINNED_LIMIT))
                self._apply_limits(max_value)
            else:
                self._restore_limits()
        except Exception as e:
            log(f'[UnlimitedPins] enabled change error: {e}')

    def _on_max_value_change(self, new_value: str):
        try:
            value = int(new_value)
            if value < 1:
                value = DEFAULT_PINNED_LIMIT
            if self.get_setting('up_enabled', True):
                self._apply_limits(value)
        except Exception as e:
            log(f'[UnlimitedPins] max_value change error: {e}')

    def create_settings(self):
        return [Header(text='Безлимитные закреплённые'), Switch(key='up_enabled', text='Безлимитные закреплённые чаты', icon='msg_pin', default=True, on_change=self._on_enabled_change), Input(key='up_max_value', text='Свой лимит закреплённых', icon='msg_stats', default=str(DEFAULT_PINNED_LIMIT), subtext='Действует для диалогов и папок, пока плагин включён', on_change=self._on_max_value_change), Switch(key='up_persist_pins', text='Запоминать закреплённые и их порядок', subtext='Сохраняет закреплённые для каждого аккаунта/папки и восстанавливает при запуске', icon='msg_pin', default=True), Switch(key='up_restore_pins_on_start', text='Восстанавливать при запуске приложения', icon='msg_pin', default=True), Switch(key='up_block_server_updates', text='Блокировать обновления с сервера', subtext='Сервер не сможет перезаписать локальные безлимитные закрепления', icon='msg_limit_channels', default=False), Switch(key='up_restore_on_unload', text='Восстанавливать исходные лимиты при выгрузке', icon='msg_revert', default=True), Divider(), Text(text='Изменения вступают в силу сразу, пока плагин включён.', icon='msg_info'), Text(text='Восстановить закреплённые сейчас', icon='msg_pin', on_click=lambda: self._restore_from_saved_state())]

    def on_update_hook(self, update_name: str, account: int, update: Any) -> HookResult:
        try:
            if update_name in ('TL_updatePinnedDialogs', 'TL_updateDialogPinned'):
                if self.get_setting('up_persist_pins', True) and (not self._in_restore):
                    try:
                        self._schedule_save()
                    except Exception:
                        pass
                if self.get_setting('up_block_server_updates', False):
                    log(f'[UnlimitedPins] Blocking update {update_name}')
                    return HookResult(strategy=HookStrategy.CANCEL)
        except Exception as e:
            log(f'[UnlimitedPins] on_update_hook error: {e}')
        return HookResult()
WINDOW_FLAG_SECURE = int(WindowManager.LayoutParams.FLAG_SECURE)

class replace_is_secured_now_false(MethodReplacement):

    def replace_hooked_method(self, param):
        return Boolean(False)

class replace_update_window_secure_clear(MethodReplacement):

    def replace_hooked_method(self, param):
        try:
            window = param.args[0] if param.args else None
            if window is not None:
                window.clearFlags(WINDOW_FLAG_SECURE)
        except Exception:
            pass
        return None

class plugin_allow_screenshots(cls_host_forwarder):

    def __init__(self):
        super().__init__()
        self.unhook_objects = []

    def on_plugin_load(self):
        self.on_plugin_unload()
        Window = self.cls('android.view.Window')
        LayoutParams = self.cls('android.view.WindowManager$LayoutParams')
        View = self.cls('android.view.View')
        ViewGroupParams = self.cls('android.view.ViewGroup$LayoutParams')
        WindowManagerImpl = self.cls('android.view.WindowManagerImpl')
        WindowManagerGlobal = self.cls('android.view.WindowManagerGlobal')
        FlagSecureReason = self.cls('org.telegram.messenger.FlagSecureReason')
        StoryViewer = self.cls('org.telegram.ui.Stories.StoryViewer')
        SurfaceView = self.cls('android.view.SurfaceView')
        self.hook(Window, 'setFlags', Integer.TYPE, Integer.TYPE, before=self.clean_set_flags)
        self.hook(Window, 'addFlags', Integer.TYPE, before=self.clean_flags_arg)
        self.hook(Window, 'setAttributes', LayoutParams, before=self.clean_layout_params)
        self.hook(WindowManagerImpl, 'addView', View, ViewGroupParams, before=self.clean_layout_params)
        self.hook(WindowManagerImpl, 'updateViewLayout', View, ViewGroupParams, before=self.clean_layout_params)
        self.hook_all(WindowManagerGlobal, 'addView', before=self.clean_layout_params)
        self.hook_all(WindowManagerGlobal, 'updateViewLayout', before=self.clean_layout_params)
        self.hook(FlagSecureReason, 'updateWindowSecure', Window, replacement=replace_update_window_secure_clear())
        self.hook(FlagSecureReason, 'isSecuredNow', Window, replacement=replace_is_secured_now_false())
        self.hook(StoryViewer, 'allowScreenshots', Boolean.TYPE, before=self.force_allow_screenshots)
        self.hook(SurfaceView, 'setSecure', Boolean.TYPE, before=self.force_surface_public)
        run_on_ui_thread(self.clear_existing_windows)

    def on_plugin_unload(self):
        for unhook in list(reversed(getattr(self, 'unhook_objects', []))):
            try:
                self.unhook_method(unhook)
            except Exception:
                pass
        self.unhook_objects.clear()

    def cls(self, class_name):
        try:
            return find_class(class_name)
        except Exception:
            return None

    def hook(self, clazz, method_name, *arg_types, before=None, replacement=None):
        if clazz is None or any((arg is None for arg in arg_types)):
            return False
        try:
            method = self.reflection_class(clazz).getDeclaredMethod(method_name, *[self.reflection_class(arg) for arg in arg_types])
            method.setAccessible(True)
            unhook = self.hook_method(method, replacement, priority=100, before=before)
            self.keep(unhook)
            return unhook is not None
        except Exception as e:
            self.log(f'hook skipped: {method_name}: {e}')
        return False

    def hook_all(self, clazz, method_name, before=None):
        if clazz is None:
            return False
        try:
            self.keep(self.hook_all_methods(self.reflection_class(clazz), method_name, priority=100, before=before))
            return True
        except Exception as e:
            self.log(f'hook skipped: {method_name}: {e}')
        return False

    def reflection_class(self, clazz):
        try:
            getattr(clazz, 'getDeclaredMethod')
            return clazz
        except Exception:
            pass
        try:
            return clazz.getClass()
        except Exception:
            return clazz

    def keep(self, unhooks):
        if unhooks is None:
            return
        if isinstance(unhooks, dict):
            items = [unhooks]
        else:
            try:
                items = list(unhooks)
            except Exception:
                items = [unhooks]
        self.unhook_objects.extend((item for item in items if item is not None))

    def clear_existing_windows(self):
        try:
            views = AndroidUtilities.allGlobalViews()
            for index in range(int(views.size())):
                view = views.get(index)
                self.clean_layout_params_obj(view.getLayoutParams())
                try:
                    activity = AndroidUtilities.findActivity(view.getContext())
                    if activity is not None:
                        activity.getWindow().clearFlags(WINDOW_FLAG_SECURE)
                except Exception:
                    pass
        except Exception:
            pass

    def clean_set_flags(self, param):
        try:
            flags = int(param.args[0])
            mask = int(param.args[1])
            if mask & WINDOW_FLAG_SECURE != 0:
                param.args[0] = Integer(flags & ~WINDOW_FLAG_SECURE)
        except Exception:
            pass

    def clean_flags_arg(self, param):
        try:
            flags = int(param.args[0])
            if flags & WINDOW_FLAG_SECURE != 0:
                param.args[0] = Integer(flags & ~WINDOW_FLAG_SECURE)
        except Exception:
            pass

    def clean_layout_params(self, param):
        try:
            for arg in param.args:
                self.clean_layout_params_obj(arg)
        except Exception:
            pass

    def clean_layout_params_obj(self, params):
        try:
            flags = int(params.flags)
            if flags & WINDOW_FLAG_SECURE != 0:
                params.flags = flags & ~WINDOW_FLAG_SECURE
                return True
        except Exception:
            pass
        return False

    def force_surface_public(self, param):
        try:
            if bool(param.args[0]):
                param.args[0] = Boolean(False)
        except Exception:
            pass

    def force_allow_screenshots(self, param):
        try:
            if not bool(param.args[0]):
                param.args[0] = Boolean(True)
        except Exception:
            pass
PROMO_REQUEST_NAMES: Set[str] = {'TL_help_getPromoData'}
PROMO_RECHECK_INTERVAL_SECONDS = 365 * 24 * 60 * 60

class hook_return_fixed_value(MethodHook):

    def __init__(self, plugin: 'AbsoluteAdBlockPlugin', value: Any):
        self.plugin = plugin
        self.value = value

    def before_hooked_method(self, param: Any):
        try:
            param.setResult(self.value)
        except Exception as e:
            self.plugin.log(f'ReturnValueHook error: {e}')

class hook_suppress_promo_check(MethodHook):

    def __init__(self, plugin: 'AbsoluteAdBlockPlugin'):
        self.plugin = plugin

    def before_hooked_method(self, param: Any):
        try:
            param.setResult(None)
        except Exception as e:
            self.plugin.log(f'Promo hook suppress error: {e}')
            return
        try:
            controller = param.thisObject
            self.plugin._run_on_stage_queue(lambda: self.plugin._cleanup_messages_controller(controller))
        except Exception as e:
            self.plugin.log(f'Promo cleanup schedule error: {e}')

class hook_video_ads_load_cleanup(MethodHook):

    def __init__(self, plugin: 'AbsoluteAdBlockPlugin'):
        self.plugin = plugin

    def before_hooked_method(self, param: Any):
        video_ads = param.thisObject
        try:
            self.plugin._set_private_field(video_ads, 'loading', False)
            self.plugin._set_private_field(video_ads, 'loaded', True)
            ads = self.plugin._get_private_field(video_ads, 'ads')
            if ads is not None:
                try:
                    ads.clear()
                except Exception:
                    pass
        except Exception as e:
            self.plugin.log(f'VideoAds load cleanup error: {e}')
        try:
            param.setResult(None)
        except Exception as e:
            self.plugin.log(f'VideoAds load suppress error: {e}')

class plugin_ad_block(cls_host_forwarder):

    def __init__(self):
        super().__init__()
        self._unhooks: List[Any] = []
        self.installed_hooks = 0
        self._field_cache = {}

    def on_plugin_load(self):
        self.on_plugin_unload()
        self.installed_hooks = 0
        for name in PROMO_REQUEST_NAMES:
            self.add_hook(name, priority=10000)
        self._install_method_hooks()
        self._cleanup_all_accounts_soon()
        self.log(f'{__name__} loaded: {self.installed_hooks} hooks installed')

    def on_plugin_unload(self):
        for unhook in list(self._unhooks):
            try:
                self.unhook_method(unhook)
            except Exception:
                pass
        self._unhooks.clear()
        self.installed_hooks = 0

    def on_app_event(self, event_type: AppEvent):
        if event_type in (AppEvent.START, AppEvent.RESUME):
            self._cleanup_all_accounts_soon()

    def pre_request_hook(self, request_name: str, account: int, request: Any) -> HookResult:
        if request_name in PROMO_REQUEST_NAMES:
            return HookResult(strategy=HookStrategy.CANCEL)
        return HookResult(strategy=HookStrategy.DEFAULT)

    def _install_method_hooks(self):
        self._hook_method('org.telegram.messenger.MessagesController', 'checkPromoInfo', 1, hook_suppress_promo_check(self))
        self._hook_method('org.telegram.messenger.MessagesController', 'checkPromoInfoInternal', 1, hook_suppress_promo_check(self))
        self._hook_method('org.telegram.messenger.MessagesController', 'isPromoDialog', 2, hook_return_fixed_value(self, Boolean(False)))
        video_noop = hook_return_fixed_value(self, None)
        self._hook_method('org.telegram.messenger.video.VideoAds', 'load', 0, hook_video_ads_load_cleanup(self))
        self._hook_method('org.telegram.messenger.video.VideoAds', 'schedule', 0, video_noop)
        self._hook_method('org.telegram.messenger.video.VideoAds', 'show', 0, video_noop)
        self._hook_method('org.telegram.messenger.video.VideoAds', 'isPopupShown', 0, hook_return_fixed_value(self, Boolean(False)))

    def _hook_method(self, class_name: str, method_name: str, param_count: int, hook: Any):
        try:
            method = self._find_method(class_name, method_name, param_count)
            if method is None:
                self.log(f'Method not found: {class_name}.{method_name}/{param_count}')
                return
            unhook = self.hook_method(method, hook, priority=10000)
            if unhook is not None:
                self._unhooks.append(unhook)
                self.installed_hooks += 1
        except Exception as e:
            self.log(f'Hook install failed for {class_name}.{method_name}: {e}')

    def _find_method(self, class_name: str, method_name: str, param_count: int) -> Optional[Any]:
        clazz = find_class(class_name)
        if clazz is None:
            self.log(f'Class not found: {class_name}')
            return None
        for candidate in self._class_candidates(clazz):
            current = candidate
            while current is not None:
                try:
                    methods = current.getDeclaredMethods()
                except Exception:
                    methods = []
                for method in methods:
                    try:
                        if str(method.getName()) != method_name:
                            continue
                        types = method.getParameterTypes()
                        if self._java_array_len(types) != param_count:
                            continue
                        method.setAccessible(True)
                        return method
                    except Exception:
                        continue
                try:
                    current = current.getSuperclass()
                except Exception:
                    current = None
        return None

    def _class_candidates(self, clazz: Any) -> List[Any]:
        candidates: List[Any] = []
        seen = set()
        for candidate in (clazz, self._safe_get_class(clazz)):
            if candidate is None:
                continue
            try:
                key = str(candidate.getName())
            except Exception:
                key = str(candidate)
            if key in seen:
                continue
            seen.add(key)
            candidates.append(candidate)
        return candidates

    def _safe_get_class(self, obj: Any) -> Optional[Any]:
        try:
            return obj.getClass()
        except Exception:
            return None

    def _java_array_len(self, value: Any) -> int:
        try:
            return len(value)
        except Exception:
            pass
        try:
            return int(value.length)
        except Exception:
            return -1

    def _cleanup_all_accounts_soon(self):
        for delay in (0, 500, 2000):
            try:
                run_on_ui_thread(lambda: self._run_on_stage_queue(self._cleanup_all_accounts), delay)
            except Exception:
                pass

    def _cleanup_all_accounts(self):
        try:
            max_accounts = int(UserConfig.MAX_ACCOUNT_COUNT)
        except Exception:
            max_accounts = 4
        for account in range(max_accounts):
            try:
                controller = MessagesController.getInstance(account)
                if controller is not None:
                    self._cleanup_messages_controller(controller)
            except Exception:
                continue

    def _cleanup_messages_controller(self, controller: Any):
        if controller is None:
            return
        should_remove_dialog = False
        try:
            promo_dialog = self._get_private_field(controller, 'promoDialog')
            promo_dialog_id = self._to_int(self._get_private_field(controller, 'promoDialogId'), 0)
            should_remove_dialog = promo_dialog is not None or bool(promo_dialog_id)
        except Exception:
            pass
        try:
            request_id = self._to_int(self._get_private_field(controller, 'checkingPromoInfoRequestId'), 0)
            if request_id:
                try:
                    controller.getConnectionsManager().cancelRequest(request_id, True)
                except Exception:
                    pass
            self._set_private_field(controller, 'checkingPromoInfoRequestId', 0)
        except Exception:
            pass
        try:
            current_time = int(controller.getConnectionsManager().getCurrentTime())
            next_check_time = current_time + PROMO_RECHECK_INTERVAL_SECONDS
            self._set_private_field(controller, 'checkingPromoInfo', False)
            self._set_private_field(controller, 'nextPromoInfoCheckTime', next_check_time)
            self._set_private_field(controller, 'promoDialogId', 0)
            self._set_private_field(controller, 'promoDialogType', 0)
            self._set_private_field(controller, 'proxyDialogAddress', None)
            self._clear_promo_preferences(controller, next_check_time)
        except Exception:
            pass
        if should_remove_dialog:
            try:
                run_on_ui_thread(lambda: self._cleanup_promo_dialog_on_ui(controller))
            except Exception:
                pass

    def _cleanup_promo_dialog_on_ui(self, controller: Any):
        if controller is None:
            return
        try:
            self._invoke_no_arg(controller, 'removePromoDialog')
        except Exception:
            pass
        try:
            self._set_private_field(controller, 'promoDialog', None)
            self._set_private_field(controller, 'promoDialogId', 0)
            self._set_private_field(controller, 'promoDialogType', 0)
            self._set_private_field(controller, 'checkingPromoInfo', False)
            self._set_private_field(controller, 'checkingPromoInfoRequestId', 0)
            self._set_private_field(controller, 'proxyDialogAddress', None)
        except Exception:
            pass

    def _clear_promo_preferences(self, controller: Any, next_check_time: int):
        seen = set()
        try:
            self._clear_promo_preferences_in(controller.getMainSettings(), next_check_time, seen)
        except Exception:
            pass
        try:
            self._clear_promo_preferences_in(MessagesController.getGlobalMainSettings(), next_check_time, seen)
        except Exception:
            pass

    def _clear_promo_preferences_in(self, preferences: Any, next_check_time: int, seen: Set[str]):
        if preferences is None:
            return
        key = self._object_identity_key(preferences)
        if key in seen:
            return
        seen.add(key)
        editor = preferences.edit()
        editor.putLong('proxy_dialog', 0)
        editor.putInt('promo_dialog_type', 0)
        editor.putInt('nextPromoInfoCheckTime', int(next_check_time))
        editor.remove('proxyDialogAddress')
        try:
            editor.commit()
        except Exception:
            editor.apply()

    def _object_identity_key(self, obj: Any) -> str:
        try:
            return f'{obj.getClass().getName()}:{obj.hashCode()}'
        except Exception:
            return str(id(obj))

    def _run_on_stage_queue(self, fn: Any):
        try:
            Utilities.stageQueue.postRunnable(lambda: fn())
        except Exception:
            try:
                fn()
            except Exception:
                pass

    def _get_private_field(self, obj: Any, name: str, default: Any=None) -> Any:
        field = self._find_field(obj, name)
        if field is None:
            return default
        try:
            return field.get(obj)
        except Exception:
            return default

    def _set_private_field(self, obj: Any, name: str, value: Any) -> bool:
        field = self._find_field(obj, name)
        if field is None:
            return False
        try:
            type_name = str(field.getType().getName())
            if type_name == 'int':
                field.setInt(obj, int(value))
            elif type_name == 'long':
                field.setLong(obj, int(value))
            elif type_name == 'boolean':
                field.setBoolean(obj, bool(value))
            else:
                field.set(obj, value)
            return True
        except Exception:
            return False

    def _find_field(self, obj: Any, name: str) -> Optional[Any]:
        if obj is None:
            return None
        try:
            current = obj.getClass()
        except Exception:
            return None
        while current is not None:
            try:
                key = (str(current.getName()), name)
                cached = self._field_cache.get(key, None)
                if cached is not None:
                    return cached
                field = current.getDeclaredField(name)
                field.setAccessible(True)
                self._field_cache[key] = field
                return field
            except Exception:
                try:
                    current = current.getSuperclass()
                except Exception:
                    current = None
        return None

    def _to_int(self, value: Any, default: Any=0) -> Any:
        if value is None:
            return default
        try:
            return int(value)
        except Exception:
            pass
        try:
            return int(value.intValue())
        except Exception:
            return default

    def _invoke_no_arg(self, obj: Any, method_name: str):
        method = self._find_method_on_object(obj, method_name, 0)
        if method is not None:
            return method.invoke(obj)
        return None

    def _find_method_on_object(self, obj: Any, method_name: str, param_count: int) -> Optional[Any]:
        if obj is None:
            return None
        try:
            current = obj.getClass()
        except Exception:
            return None
        while current is not None:
            try:
                methods = current.getDeclaredMethods()
            except Exception:
                methods = []
            for method in methods:
                try:
                    if str(method.getName()) != method_name:
                        continue
                    if self._java_array_len(method.getParameterTypes()) != param_count:
                        continue
                    method.setAccessible(True)
                    return method
                except Exception:
                    continue
            try:
                current = current.getSuperclass()
            except Exception:
                current = None
        return None

class cls_protect_filter_check_runnable(dynamic_proxy(Runnable)):

    def __init__(self, plugin, account, dialog_id, sender_id, text_lower, keywords):
        self.plugin = plugin
        self.account = account
        self.dialog_id = dialog_id
        self.sender_id = sender_id
        self.text_lower = text_lower
        self.keywords = keywords

    def run(self):
        triggered = False
        add_to_old = False
        try:
            messages_storage = MessagesStorage.getInstance(self.account)
            db = messages_storage.getDatabase()
            cursor = db.queryFinalized('SELECT COUNT(*) FROM messages WHERE uid = ?', Long(self.dialog_id))
            count = 0
            if cursor.next():
                count = cursor.intValue(0)
            cursor.dispose()
            if count <= 1:
                matched = False
                for keyword in self.keywords:
                    if keyword in self.text_lower:
                        matched = True
                        break
                if matched:
                    triggered = True
                    run_on_queue(lambda: self.plugin._handle_trigger(self.account, self.dialog_id, self.sender_id))
            else:
                add_to_old = True
        except Exception as e:
            log(f'ProtectFilter CheckRunnable error: {e}')
        finally:
            if not triggered:
                self.plugin._processing.discard(self.dialog_id)
                if add_to_old:
                    self.plugin._old_dialogs.add(self.dialog_id)

class plugin_protect_filter(cls_host_forwarder):

    def on_plugin_load(self):
        self.add_hook('TL_updateNewMessage')
        self._processing = set()
        self._old_dialogs = set()
        self._cache = {}
        self._welcome_shown = False

    def on_plugin_unload(self):
        self._processing = set()
        self._old_dialogs = set()
        self._cache = {}
        self._welcome_shown = False

    def _get_cached_field(self, obj, name):
        key = f'{obj.getClass().getName()}.{name}'
        if key not in self._cache:
            field = obj.getClass().getDeclaredField(name)
            field.setAccessible(True)
            self._cache[key] = field
        return self._cache[key]

    def _get_cached_method(self, cls, name, *types):
        types_str = ','.join((t.getName() for t in types))
        key = f'{cls.getName()}.{name}({types_str})'
        if key not in self._cache:
            method = cls.getDeclaredMethod(name, *types)
            method.setAccessible(True)
            self._cache[key] = method
        return self._cache[key]

    def on_update_hook(self, update_name: str, account: int, update: Any) -> HookResult:
        if update_name != 'TL_updateNewMessage':
            return HookResult()
        try:
            if not self.get_setting('pf_enabled', True):
                return HookResult()
            message = update.message
            if message is None:
                return HookResult()
            if message.out:
                return HookResult()
            text = message.message
            if not text or not isinstance(text, str):
                return HookResult()
            peer_id = message.peer_id
            from_id = message.from_id
            if peer_id is None or from_id is None:
                return HookResult()
            if not hasattr(peer_id, 'user_id') or not hasattr(from_id, 'user_id'):
                return HookResult()
            sender_id = from_id.user_id
            dialog_id = sender_id
            user_config = UserConfig.getInstance(account)
            current_user = user_config.getCurrentUser()
            if current_user and sender_id == current_user.id:
                return HookResult()
            if dialog_id in self._old_dialogs:
                return HookResult()
            if dialog_id in self._processing:
                return HookResult()
            keywords_str = self.get_setting('pf_keywords', 'докс, деанон, сват, откуп')
            keywords = [k.strip().lower() for k in keywords_str.split(',') if k.strip()]
            text_lower = text.lower()
            matched = False
            for keyword in keywords:
                if keyword in text_lower:
                    matched = True
                    break
            if not matched:
                return HookResult()
            account_instance = AccountInstance.getInstance(account)
            messages_controller = account_instance.getMessagesController()
            dialogs_dict_field = self._get_cached_field(messages_controller, 'dialogs_dict')
            dialogs_dict = dialogs_dict_field.get(messages_controller)
            dialog = dialogs_dict.get(dialog_id) if dialogs_dict else None
            if dialog is None:
                self._processing.add(dialog_id)
                run_on_queue(lambda: self._handle_trigger(account, dialog_id, sender_id))
                return HookResult()
            top_message_field = self._get_cached_field(dialog, 'top_message')
            top_message = top_message_field.get(dialog)
            if top_message == 0:
                self._processing.add(dialog_id)
                run_on_queue(lambda: self._handle_trigger(account, dialog_id, sender_id))
                return HookResult()
            self._processing.add(dialog_id)
            messages_storage = MessagesStorage.getInstance(account)
            storage_queue = messages_storage.getStorageQueue()
            storage_queue.postRunnable(cls_protect_filter_check_runnable(self, account, dialog_id, sender_id, text_lower, keywords))
        except Exception as e:
            log(f'ProtectFilter error: {e}')
        return HookResult()

    def _handle_trigger(self, account: int, dialog_id: int, user_id: int):
        try:
            if self.get_setting('pf_block_user', True):
                self._block_user(account, dialog_id)
            if self.get_setting('pf_delete_chat', True):
                self._delete_chat(account, dialog_id)
            if self.get_setting('pf_notify_trigger', True):
                self._send_notification(user_id)
        except Exception as e:
            log(f'ProtectFilter _handle_trigger error: {e}')
        finally:
            self._processing.discard(dialog_id)

    def _block_user(self, account: int, dialog_id: int):
        try:
            account_instance = AccountInstance.getInstance(account)
            messages_controller = account_instance.getMessagesController()
            block_method = self._get_cached_method(messages_controller.getClass(), 'blockPeer', Long.TYPE)
            block_method.invoke(messages_controller, Long(dialog_id))
        except Exception as e:
            log(f'ProtectFilter block_user error: {e}')

    def _delete_chat(self, account: int, dialog_id: int):
        try:
            account_instance = AccountInstance.getInstance(account)
            messages_controller = account_instance.getMessagesController()
            delete_method = self._get_cached_method(messages_controller.getClass(), 'deleteDialog', Long.TYPE, Integer.TYPE, Boolean.TYPE)
            delete_method.invoke(messages_controller, Long(dialog_id), Integer(0), Boolean(False))
        except Exception as e:
            log(f'ProtectFilter delete_chat error: {e}')

    def _send_notification(self, user_id: int):
        try:
            context = ApplicationLoader.applicationContext
            notification_manager = context.getSystemService(Context.NOTIFICATION_SERVICE)
            channel_id = 'protect_filter_channel'
            if Build.VERSION.SDK_INT >= Build.VERSION_CODES.O:
                channel = NotificationChannel(channel_id, 'Protect Filter', NotificationManager.IMPORTANCE_HIGH)
                notification_manager.createNotificationChannel(channel)
            intent = context.getPackageManager().getLaunchIntentForPackage(context.getPackageName())
            pending = None
            if intent:
                flags = PendingIntent.FLAG_UPDATE_CURRENT
                if Build.VERSION.SDK_INT >= Build.VERSION_CODES.M:
                    flags |= PendingIntent.FLAG_IMMUTABLE
                pending = PendingIntent.getActivity(context, 0, intent, flags)
            if Build.VERSION.SDK_INT >= Build.VERSION_CODES.O:
                builder = Notification.Builder(context, channel_id)
            else:
                builder = Notification.Builder(context)
            builder.setContentTitle('Protect Filter')
            builder.setContentText(f'Сработал защитный фильтр! ID: {user_id}. Пользователь успешно обезврежен')
            builder.setAutoCancel(True)
            if pending:
                builder.setContentIntent(pending)
            app_icon = context.getApplicationInfo().icon
            if app_icon != 0:
                builder.setSmallIcon(app_icon)
            else:
                builder.setSmallIcon(17301648)
            notification_id = hash((user_id, 'protect_filter')) & 2147483647
            notification_manager.notify(notification_id, builder.build())
        except Exception as e:
            log(f'ProtectFilter notification error: {e}')

    def _on_keywords_click(self, view):
        try:
            current_fragment = get_last_fragment()
            if not current_fragment:
                return
            activity = current_fragment.getParentActivity()
            if not activity:
                return
            from android.widget import LinearLayout, EditText
            layout = LinearLayout(activity)
            layout.setOrientation(LinearLayout.VERTICAL)
            layout.setGravity(Gravity.CENTER_HORIZONTAL)
            layout.setPadding(AndroidUtilities.dp(24), AndroidUtilities.dp(16), AndroidUtilities.dp(24), AndroidUtilities.dp(16))
            edit = EditText(activity)
            edit.setText(self.get_setting('pf_keywords', 'докс, деанон, сват, откуп'))
            edit.setHint('докс, деанон, сват, откуп')
            layout.addView(edit, -1, -2)

            def on_save(bld, which):
                self.set_setting('pf_keywords', str(edit.getText()), reload_settings=True)
                bld.dismiss()

            def on_cancel(bld, which):
                bld.dismiss()
            builder = AlertDialogBuilder(activity)
            builder.set_title('Фильтр ключевых слов')
            builder.set_message('Каждое слово отделяйте запятой')
            builder.set_view(layout)
            builder.set_positive_button('Сохранить', on_save)
            builder.set_negative_button('Отмена', on_cancel)
            builder.show()
        except Exception as e:
            log(f'ProtectFilter keywords dialog error: {e}')

    def _get_keywords_subtext(self) -> str:
        keywords = self.get_setting('pf_keywords', 'докс, деанон, сват, откуп')
        if len(keywords) > 30:
            return keywords[:30] + '...'
        return keywords

    def create_settings(self) -> List[Any]:
        return [Header(text='Основные настройки'), Switch(key='pf_enabled', text='Включить фильтр', default=True), Divider(text='ᅠ'), Switch(key='pf_block_user', text='Блокировать пользователя', default=True), Switch(key='pf_delete_chat', text='Удалять чат (локально)', default=True), Divider(text='ᅠ'), Text(text='Фильтр ключевых слов', subtext=self._get_keywords_subtext(), icon='msg_filter', on_click=self._on_keywords_click, link_alias='keywords_filter'), Divider(text='ᅠ'), Switch(key='pf_notify_trigger', text='Уведомлять о срабатывании', default=True)]

class hook_profile_update_rows_special:

    def __init__(self, plugin):
        self._plugin_ref = weakref.ref(plugin)

    def before_hooked_method(self, param):
        plugin = self._plugin_ref()
        if not plugin:
            return
        activity = param.thisObject
        if not hasattr(plugin, 'special_status_state'):
            plugin.special_status_state = {}
        state = plugin.special_status_state.setdefault(activity, {'specialRow': -1})
        state['shouldInsertSpecial'] = False
        try:
            uid = str(plugin._get_long_field(activity, 'userId'))
            special_ids = plugin.get_setting('sc_special_ids', {})
            if uid in special_ids:
                state['shouldInsertSpecial'] = True
        except Exception:
            pass

    def after_hooked_method(self, param):
        plugin = self._plugin_ref()
        if not plugin:
            return
        activity = param.thisObject
        state = plugin.special_status_state.get(activity)
        if not state:
            return
        if not state.get('shouldInsertSpecial'):
            state['specialRow'] = -1
            state.pop('shouldInsertSpecial', None)
            return
        insert_position = plugin._calculate_insert_position(activity)
        if insert_position == -1:
            state['specialRow'] = -1
            state.pop('shouldInsertSpecial', None)
            return
        state['specialRow'] = insert_position
        state.pop('shouldInsertSpecial', None)
        row_count = plugin._get_int_field(activity, 'rowCount')
        if row_count != -1:
            plugin._set_int_field(activity, 'rowCount', row_count + 1)
        try:
            INTEGER_CLASS = jclass('java.lang.Integer')
            fields = activity.getClass().getDeclaredFields()
            for i in range(len(fields)):
                field = fields[i]
                name = field.getName()
                if 'Row' not in name and 'row' not in name:
                    continue
                if name in ('rowCount', 'phoneRow', 'mutualRow', 'specialRow'):
                    continue
                field_type = field.getType()
                if field_type != INTEGER_CLASS.TYPE and field_type != INTEGER_CLASS:
                    continue
                field.setAccessible(True)
                val_obj = field.get(activity)
                if val_obj is None:
                    continue
                try:
                    val = int(val_obj)
                except Exception:
                    continue
                if val >= state['specialRow'] and val != -1:
                    try:
                        if field_type == INTEGER_CLASS.TYPE:
                            field.setInt(activity, val + 1)
                        else:
                            field.set(activity, INTEGER_CLASS(val + 1))
                    except Exception:
                        pass
        except Exception:
            pass

class hook_profile_get_special_item_type:

    def __init__(self, plugin):
        self._plugin_ref = weakref.ref(plugin)

    def before_hooked_method(self, param):
        plugin = self._plugin_ref()
        if not plugin:
            return
        adapter = param.thisObject
        activity = plugin._get_activity_from_adapter(adapter)
        state = getattr(plugin, 'special_status_state', {}).get(activity)
        if not state:
            return
        try:
            pos = int(param.args[0])
            if pos == state.get('specialRow', -1):
                try:
                    param.setResult(jclass('java.lang.Integer')(2))
                except Exception:
                    param.setResult(2)
        except Exception:
            pass

class hook_profile_bind_special_row:

    def __init__(self, plugin):
        self._plugin_ref = weakref.ref(plugin)

    def after_hooked_method(self, param):
        plugin = self._plugin_ref()
        if not plugin:
            return
        adapter = param.thisObject
        activity = plugin._get_activity_from_adapter(adapter)
        state = getattr(plugin, 'special_status_state', {}).get(activity)
        if not state:
            return
        try:
            pos = int(param.args[1])
            if pos != state.get('specialRow', -1):
                return
            holder = param.args[0]
            item_view = holder.itemView
            TextDetailCell = jclass('org.telegram.ui.Cells.TextDetailCell')
            if isinstance(item_view, TextDetailCell):
                item_view.setTextAndValue('Особый контакт', 'Отслеживается статус', True)
        except Exception:
            pass

class plugin_special_contacts(cls_host_forwarder):
    CH_STATUS = 'special_contacts_status'
    CH_READ = 'special_contacts_read'

    def on_plugin_load(self):
        self.special_status_state = {}
        self._sc_hooks = []
        self.add_hook('TL_updateUserStatus')
        self.add_hook('TL_updateReadHistoryOutbox')
        self.add_hook('TL_updates')
        self.add_hook('TL_updatesCombined')
        self.profile_menu_id = self.add_menu_item(MenuItemData(menu_type=MenuItemType.PROFILE_ACTION_MENU, text='⭐ Особый контакт', on_click=self._on_profile_menu_click, icon='msg_favorite', priority=5))
        self.drawer_menu_id = self.add_menu_item(MenuItemData(menu_type=MenuItemType.DRAWER_MENU, text='⭐ Особые контакты', icon='msg_favorite', on_click=self._open_own_settings))
        self._init_profile_hooks()
        self._create_channels()
        self._init_storage()

    def on_plugin_unload(self):
        if getattr(self, 'profile_menu_id', None):
            self.remove_menu_item(self.profile_menu_id)
        if getattr(self, 'drawer_menu_id', None):
            self.remove_menu_item(self.drawer_menu_id)
        if hasattr(self, 'special_status_state'):
            self.special_status_state.clear()
        for ref in list(getattr(self, '_sc_hooks', [])):
            try:
                self.unhook_method(ref)
            except Exception:
                pass
        self._sc_hooks = []

    def _init_profile_hooks(self):
        try:
            profile_class = jclass('org.telegram.ui.ProfileActivity')
            update_rows = profile_class.getClass().getDeclaredMethod('updateRowsIds')
            update_rows.setAccessible(True)
            ref = self.hook_method(update_rows, hook_profile_update_rows_special(self))
            if ref is not None:
                self._sc_hooks.append(ref)
            list_adapter = jclass('org.telegram.ui.ProfileActivity$ListAdapter')
            int_type = jclass('java.lang.Integer').TYPE
            view_holder = jclass('androidx.recyclerview.widget.RecyclerView$ViewHolder')
            get_item_type = list_adapter.getClass().getDeclaredMethod('getItemViewType', int_type)
            get_item_type.setAccessible(True)
            ref = self.hook_method(get_item_type, hook_profile_get_special_item_type(self))
            if ref is not None:
                self._sc_hooks.append(ref)
            bind_view = list_adapter.getClass().getDeclaredMethod('onBindViewHolder', view_holder, int_type)
            bind_view.setAccessible(True)
            ref = self.hook_method(bind_view, hook_profile_bind_special_row(self))
            if ref is not None:
                self._sc_hooks.append(ref)
        except Exception:
            pass

    def create_settings(self) -> List[Any]:
        count = len(self.get_setting('sc_special_ids', {}))
        settings = [Header(text='Глобальное наблюдение'), Switch(key='sc_watch_status', text='Следить за онлайном', default=True), Switch(key='sc_watch_read', text='Следить за прочтением', default=True), Header(text='Системные уведомления'), Switch(key='sc_notify_online', text='Уведомлять, когда в сети', default=True), Switch(key='sc_notify_offline', text='Уведомлять, когда не в сети', default=False), Switch(key='sc_notify_read', text='Уведомлять о прочтении', default=True), Switch(key='sc_fake_progress', text='Совместимость HyperBridge', default=False), Divider(text='⚙️ Настройки звука/вибрации: Настройки Android → Приложения → ExteraGram / Ayugram → Уведомления → Прочее → Особые контакты'), Header(text='Инфо'), Text(text=f'Особых контактов: {count}', create_sub_fragment=self._create_contacts_list_page), Divider(text='Добавляй и удаляй пользователей через их профиль (три точки в правом верхнем углу ➝ ⭐ Особый контакт)')]
        special = self.get_setting('sc_special_ids', {})
        if special:
            settings.append(Header(text='📊 Статистика и настройки контактов'))
            for uid, data in special.items():
                name = data.get('name') or data.get('username') or f'User #{uid}'
                settings.append(Text(text=f'👤 {name}', subtext='Настройки уведомлений и история событий', icon='msg_user', create_sub_fragment=lambda u=uid: self._create_stats_sub_page(u)))
        return settings

    def _create_contacts_list_page(self):
        special = self.get_setting('sc_special_ids', {})
        items = [Header(text='Список контактов')]
        if not special:
            items.append(Text(text='Список пуст'))
            return items
        for uid, data in special.items():
            name = data.get('name') or data.get('username') or f'User #{uid}'
            items.append(Text(text=name, subtext=f'ID: {uid}', create_sub_fragment=lambda u=uid: self._create_stats_sub_page(u)))
        return items

    def _create_stats_sub_page(self, uid):
        name = self._get_display_name(uid)
        items = [Header(text=f'Уведомления: {name}'), Switch(key=f'sc_notify_online_{uid}', text='🔔 В сети', default=True), Switch(key=f'sc_notify_offline_{uid}', text='🔕 Не в сети', default=False), Switch(key=f'sc_notify_read_{uid}', text='👁 Прочтение', default=True), Divider(), Header(text='📊 История событий')]
        days_dict = self._build_days_dict(uid)
        if not days_dict:
            items.append(Text(text='Нет данных для статистики'))
            return items
        today_str = time.strftime('%d.%m.%Y', time.localtime())
        sorted_dates = sorted(days_dict.keys(), reverse=True)
        for date_str in sorted_dates:
            label = f'{date_str} (сегодня)' if date_str == today_str else date_str
            count = len(days_dict[date_str])
            items.append(Text(text=f'📅 {label}', subtext=f'Событий: {count}', create_sub_fragment=lambda u=uid, d=date_str: self._create_day_sub_page(u, d)))
        return items

    def _create_day_sub_page(self, uid, day_str):
        name = self._get_display_name(uid)
        events = self._build_days_dict(uid).get(day_str, [])
        items = [Header(text=f'{name} — {day_str}'), Text(text='Компактный вид', subtext='Показать статистику в виде диалогового окна', icon='msg_open', on_click=lambda v, u=uid, d=day_str: self._show_compact_alert(u, d)), Divider()]
        if not events:
            items.append(Text(text='Нет событий'))
            return items
        for t_str, icon, desc in sorted(events, key=lambda x: x[0], reverse=True):
            items.append(Text(text=f'{icon} {t_str}', subtext=desc))
        return items

    def _show_compact_alert(self, uid, day_str):
        try:
            days_dict = self._build_days_dict(uid)
            events = days_dict.get(day_str, [])
            name = self._get_display_name(uid)
            lines = [f'📊 {name}', '', f'📅 {day_str}', '']
            if not events:
                lines.append('Нет событий')
            else:
                for t_str, icon, desc in sorted(events, key=lambda x: x[0], reverse=True):
                    lines.append(f'{icon} {t_str} — {desc}')
            text = '\n'.join(lines)
            fragment = get_last_fragment()
            if not fragment:
                BulletinHelper.show_info(text[:300])
                return
            activity = fragment.getParentActivity()
            if not activity:
                BulletinHelper.show_info(text[:300])
                return
            dlg = AlertDialogBuilder(activity)
            dlg.set_title('Статистика')
            dlg.set_message(text)
            dlg.set_positive_button('OK', lambda b, w: b.dismiss())
            dlg.show()
        except Exception:
            pass

    def _on_profile_menu_click(self, context: Dict[str, Any]):
        user = context.get('user')
        if not user:
            return
        uid = str(user.id)
        special = self.get_setting('sc_special_ids', {})
        is_special = uid in special
        fragment = get_last_fragment()
        if not fragment:
            return
        activity = fragment.getParentActivity()
        if not activity:
            return
        bld = AlertDialogBuilder(activity)
        bld.set_title(user.first_name)
        if is_special:
            bld.set_message('⭐ Контакт находится в списке особых.')
            bld.set_positive_button('Удалить', lambda b, w: self._toggle_special(user, False, b))
            bld.set_neutral_button('Статистика', lambda b, w: self._go_to_stats(b, uid))
        else:
            bld.set_message('Контакт не отслеживается.')
            bld.set_positive_button('Добавить', lambda b, w: self._toggle_special(user, True, b))
        bld.set_negative_button('Отмена', lambda b, w: b.dismiss())
        bld.show()

    def _toggle_special(self, user, add, dialog):
        dialog.dismiss()
        uid = str(user.id)
        special = self.get_setting('sc_special_ids', {})
        if add:
            special[uid] = {'name': user.first_name, 'last_name': getattr(user, 'last_name', ''), 'username': getattr(user, 'username', '')}
            msg = f'⭐ {user.first_name} добавлен в особые'
        else:
            if uid in special:
                del special[uid]
            msg = f'❌ {user.first_name} удалён из особых'
        self.set_setting('sc_special_ids', special, reload_settings=True)
        try:
            fragment = get_last_fragment()
            if fragment and fragment.getClass().getSimpleName() == 'ProfileActivity':
                list_adapter = self._get_object_field(fragment, 'listView')
                if list_adapter and list_adapter.getAdapter():
                    list_adapter.getAdapter().notifyDataSetChanged()
        except Exception:
            pass
        BulletinHelper.show_success(msg)

    def _go_to_stats(self, dialog, uid):
        dialog.dismiss()
        today = time.strftime('%d.%m.%Y', time.localtime())
        self._show_compact_alert(uid, today)

    def _open_own_settings(self, *args, **kwargs):

        def do_open():
            try:
                from com.exteragram.messenger.plugins import PluginsController
                pc = PluginsController.getInstance()
                try:
                    pc.openPluginSettings(self.id)
                except TypeError:
                    pc.openPluginSettings(self.id, '')
            except Exception:
                pass
        try:
            run_on_ui_thread(do_open)
        except Exception:
            do_open()

    def _init_storage(self):
        self.data_dir = self._get_data_dir()
        self.online_file = os.path.join(self.data_dir, 'online_log.json')
        self.read_file = os.path.join(self.data_dir, 'read_log.json')
        os.makedirs(self.data_dir, exist_ok=True)

    def _get_data_dir(self):
        try:
            ctx = self._get_app_context()
            if ctx:
                base_dir = str(ctx.getFilesDir().getAbsolutePath())
            else:
                base_dir = os.environ.get('HOME', '/data/data/com.exteragram.messenger/files')
            path = os.path.join(base_dir, 'special_contacts')
            os.makedirs(path, exist_ok=True)
            return path
        except Exception:
            return '/data/data/com.exteragram.messenger/files/special_contacts'

    def _get_app_context(self):
        try:
            from android.app import ActivityThread
            return ActivityThread.currentApplication()
        except Exception:
            return None

    def _get_drawable_id(self, ctx, name):
        try:
            res = ctx.getResources()
            pkg = ctx.getPackageName()
            return res.getIdentifier(name, 'drawable', pkg)
        except Exception:
            return 0

    def _get_display_name(self, uid):
        special = self.get_setting('sc_special_ids', {})
        contact = special.get(str(uid), {})
        return contact.get('name') or contact.get('username') or f'User #{uid}'

    def _get_int_field(self, obj, name):
        try:
            field = obj.getClass().getDeclaredField(name)
            field.setAccessible(True)
            return field.getInt(obj)
        except Exception:
            return -1

    def _set_int_field(self, obj, name, value):
        try:
            field = obj.getClass().getDeclaredField(name)
            field.setAccessible(True)
            field.setInt(obj, value)
        except Exception:
            pass

    def _get_long_field(self, obj, name):
        try:
            field = obj.getClass().getDeclaredField(name)
            field.setAccessible(True)
            return field.getLong(obj)
        except Exception:
            return 0

    def _get_object_field(self, obj, name):
        try:
            field = obj.getClass().getDeclaredField(name)
            field.setAccessible(True)
            return field.get(obj)
        except Exception:
            return None

    def _get_activity_from_adapter(self, adapter):
        try:
            field = adapter.getClass().getDeclaredField('this$0')
            field.setAccessible(True)
            return field.get(adapter)
        except Exception:
            return None

    def _calculate_insert_position(self, activity):
        anchors = ['mutualRow', 'phoneRow', 'bizHoursRow', 'bizLocationRow', 'usernameRow', 'userInfoRow', 'birthdayRow', 'infoHeaderRow', 'infoHeaderRowEmpty']
        for name in anchors:
            val = self._get_int_field(activity, name)
            if val != -1:
                return val + 1
        info_end = self._get_int_field(activity, 'infoEndRow')
        if info_end != -1:
            return info_end + 1
        return -1

    def _create_channels(self):
        try:
            if Build.VERSION.SDK_INT >= Build.VERSION_CODES.O:
                ctx = self._get_app_context()
                if not ctx:
                    return
                nm = ctx.getSystemService(Context.NOTIFICATION_SERVICE)
                ch1 = NotificationChannel(self.CH_STATUS, 'Особые контакты — статус', NotificationManager.IMPORTANCE_DEFAULT)
                ch1.setDescription('Вход/выход в сеть')
                ch1.setShowBadge(False)
                nm.createNotificationChannel(ch1)
                ch2 = NotificationChannel(self.CH_READ, 'Особые контакты — прочтение', NotificationManager.IMPORTANCE_DEFAULT)
                ch2.setDescription('Прочтение сообщений')
                ch2.setShowBadge(False)
                nm.createNotificationChannel(ch2)
        except Exception:
            pass

    def on_update_hook(self, update_name, account, update):
        if update_name == 'TL_updateUserStatus':
            self._handle_status(update)
        elif update_name == 'TL_updateReadHistoryOutbox':
            self._handle_read(update)
        return HookResult()

    def on_updates_hook(self, container_name, account, updates):
        if container_name not in ('TL_updates', 'TL_updatesCombined'):
            return HookResult()
        updates_list = getattr(updates, 'updates', None)
        if not updates_list:
            return HookResult()
        for upd in updates_list:
            upd_name = type(upd).__name__
            if 'UserStatus' in upd_name:
                self._handle_status(upd)
            elif 'ReadHistoryOutbox' in upd_name:
                self._handle_read(upd)
        return HookResult()

    def _handle_status(self, update):
        if not self.get_setting('sc_watch_status', True):
            return
        user_id = getattr(update, 'user_id', None)
        if user_id is None:
            user_id = getattr(update, 'userId', None)
        if user_id is None:
            return
        uid = str(user_id)
        special = self.get_setting('sc_special_ids', {})
        if uid not in special:
            return
        status = getattr(update, 'status', None)
        if status is None:
            return
        status_type = type(status).__name__
        contact = special.get(uid, {})
        name = contact.get('name') or contact.get('username') or f'User #{uid}'
        now = int(time.time())
        self._append(self.online_file, {'uid': uid, 'name': name, 'time': now, 'status': status_type})
        is_online = 'Online' in status_type
        is_offline = 'Offline' in status_type
        if is_online and self.get_setting('sc_notify_online', True):
            if self.get_setting(f'sc_notify_online_{uid}', True):
                self._notify(self.CH_STATUS, f'🔔 {name} снова в сети', 'Особый контакт онлайн', 'info')
        elif is_offline and self.get_setting('sc_notify_offline', False):
            if self.get_setting(f'sc_notify_offline_{uid}', False):
                self._notify(self.CH_STATUS, f'🔕 {name} теперь не в сети', 'Особый контакт оффлайн', 'info')

    def _handle_read(self, update):
        if not self.get_setting('sc_watch_read', True):
            return
        special = self.get_setting('sc_special_ids', {})
        peer = getattr(update, 'peer', None)
        if peer is None:
            return
        user_id = getattr(peer, 'user_id', None)
        if user_id is None:
            user_id = getattr(peer, 'userId', None)
        if not user_id:
            return
        uid = str(user_id)
        if uid not in special:
            return
        contact = special.get(uid, {})
        name = contact.get('name') or contact.get('username') or f'User #{uid}'
        now = int(time.time())
        max_id = getattr(update, 'max_id', 0)
        self._append(self.read_file, {'uid': uid, 'name': name, 'time': now, 'msg_id': max_id})
        if self.get_setting('sc_notify_read', True):
            if self.get_setting(f'sc_notify_read_{uid}', True):
                self._notify(self.CH_READ, f'👁 {name} прочитал(а) сообщение', 'Сообщение прочитано', 'check')

    def _notify(self, ch_id, title, text, icon_type):
        try:
            ctx = self._get_app_context()
            if not ctx:
                return
            nm = ctx.getSystemService(Context.NOTIFICATION_SERVICE)
            if Build.VERSION.SDK_INT >= Build.VERSION_CODES.O:
                if nm.getNotificationChannel(ch_id) is None:
                    self._create_channels()
            if Build.VERSION.SDK_INT >= Build.VERSION_CODES.O:
                builder = Notification.Builder(ctx, ch_id)
            else:
                builder = Notification.Builder(ctx)
            builder.setContentTitle(title)
            builder.setContentText(text)
            if icon_type == 'info':
                icon_names = ['msg_info', 'ic_notification', 'ic_bell']
            else:
                icon_names = ['msg_check', 'msg_check2', 'ic_done']
            icon_id = 0
            for name in icon_names:
                icon_id = self._get_drawable_id(ctx, name)
                if icon_id != 0:
                    break
            if icon_id == 0:
                icon_id = ctx.getApplicationInfo().icon
            builder.setSmallIcon(icon_id)
            if self.get_setting('sc_fake_progress', False):
                builder.setProgress(100, 0, True)
            builder.setCategory(Notification.CATEGORY_PROGRESS)
            builder.setAutoCancel(True)
            nid = abs(hash(title + text + str(time.time()))) % 100000
            nm.notify(nid, builder.build())
        except Exception:
            pass

    def _build_days_dict(self, uid):
        online = [e for e in self._read(self.online_file) if str(e.get('uid')) == uid]
        reads = [e for e in self._read(self.read_file) if str(e.get('uid')) == uid]
        days = defaultdict(list)
        for e in online:
            date_str = time.strftime('%d.%m.%Y', time.localtime(e['time']))
            t_str = time.strftime('%H:%M:%S', time.localtime(e['time']))
            st = e.get('status', '')
            if 'Online' in st:
                days[date_str].append((t_str, '🟢', 'снова в сети'))
            elif 'Offline' in st:
                days[date_str].append((t_str, '🔴', 'не в сети'))
            else:
                days[date_str].append((t_str, '⚪', 'статус изменился'))
        for e in reads:
            date_str = time.strftime('%d.%m.%Y', time.localtime(e['time']))
            t_str = time.strftime('%H:%M:%S', time.localtime(e['time']))
            days[date_str].append((t_str, '👁', 'прочитал сообщение'))
        return days

    def _append(self, path, entry):
        try:
            data = []
            if os.path.exists(path):
                with open(path, 'r', encoding='utf-8') as f:
                    data = json.load(f)
            data.append(entry)
            if len(data) > 50000:
                data = data[-50000:]
            with open(path, 'w', encoding='utf-8') as f:
                json.dump(data, f, ensure_ascii=False)
        except Exception:
            pass

    def _read(self, path):
        if not os.path.exists(path):
            return []
        try:
            with open(path, 'r', encoding='utf-8') as f:
                return json.load(f)
        except:
            return []
EFFECT_OFF = 0
EFFECT_HIGH_PITCH = 1
EFFECT_LOW_PITCH = 2
EFFECT_ROBOT = 3
EFFECT_ECHO = 4
EFFECT_REVERSE = 5
EFFECT_DEMON = 6
