__id__ = "lincoln_tools"
__name__ = "Lincoln Tools"
__description__ = "Локальная визуальная подмена баланса звёзд и TON в профиле. Работает только в интерфейсе, ничего не отправляет и не изменяет на сервере."
__author__ = "Lincoln"
__version__ = "2.0"
__icon__ = "msg_star"
__app_version__ = ">=12.5.1"
__sdk_version__ = ">=1.4.4.3"

from decimal import Decimal, getcontext

from base_plugin import BasePlugin, MethodReplacement
from ui.settings import Header, Switch, Input, Divider, Text

from hook_utils import find_class

getcontext().prec = 12


class ReplaceBalance(MethodReplacement):
    """Подменяет возвращаемое значение StarsController.getBalance."""

    def __init__(self, plugin):
        super().__init__()
        self.plugin = plugin

    def replace_hooked_method(self, param):
        try:
            this = param.thisObject
            # Некоторые сигнатуры передают ид аккаунта в аргументе или в поле accountNum
            is_ton = bool(getattr(this, "ton", False))
            value = Decimal(str(self.plugin._tons if is_ton else self.plugin._stars))
            stars = find_class("org.telegram.tgnet.tl.TL_stars$StarsAmount")
            ton_amount = find_class("org.telegram.tgnet.tl.TL_stars$TL_starsTonAmount")
            if is_ton:
                if ton_amount is None:
                    return param.getResult()
                amount = ton_amount()
                amount.amount = int(value * Decimal("1000000000"))
                return amount
            if stars is None:
                return param.getResult()
            try:
                amount = stars.ofStars(int(value))
            except Exception:
                try:
                    amount = stars()
                    amount.amount = int(value)
                except Exception:
                    amount = stars(int(value))
            frac = value - int(value)
            nanos = int((frac * Decimal("1000000000")).to_integral_value())
            try:
                amount.nanos = nanos
            except Exception:
                pass
            return amount
        except Exception:
            return param.getResult()


class ReplaceUserStars(MethodReplacement):
    """Подменяет поле баланса звёзд в объекте User (профиль)."""

    def __init__(self, plugin):
        super().__init__()
        self.plugin = plugin

    def after_hooked_method(self, param):
        try:
            user = param.getResult()
            if user is None or not self.plugin.get_setting("enabled", True):
                return
            stars_value = int(self.plugin._stars)
            import sys
            # Пробуем разные поля в зависимости от версии клиента
            for fname in ("starsBalance", "stars_balance", "starsAmount", "balance"):
                try:
                    setattr(user, fname, stars_value)
                except Exception:
                    continue
            # Если у User есть объект stars — пробуем покопаться
            for fname in ("stars", "stars_data", "starsInfo"):
                obj = getattr(user, fname, None)
                if obj is None:
                    continue
                try:
                    setattr(obj, "amount", stars_value)
                except Exception:
                    pass
                try:
                    setattr(obj, "balance", stars_value)
                except Exception:
                    pass
        except Exception:
            pass


class LincolnToolsPlugin(BasePlugin):

    def on_plugin_load(self):
        self.add_hook("TL_updateNewMessage")
        self._stars = self.get_setting("stars", "9999")
        self._tons = self.get_setting("ton", "1.5")
        self._hook_ref = None

        controller = find_class("org.telegram.ui.Stars.StarsController")
        if controller is not None:
            try:
                refs = self.hook_all_methods(controller, "getBalance", ReplaceBalance(self), priority=100)
                if refs:
                    self._hook_ref = refs[0]
            except Exception:
                pass

        # Подменяем баланс звёзд в объекте User — покрывает то, что
        # StarsController.getBalance не видит (разные экраны профиля)
        uc = find_class("org.telegram.messenger.UserConfig")
        if uc is not None:
            try:
                self.hook_all_methods(uc, "getCurrentUser", ReplaceUserStars(self), priority=100)
            except Exception:
                pass
        cc = find_class("org.telegram.messenger.ContactsController")
        if cc is not None:
            try:
                self.hook_all_methods(cc, "getUser", ReplaceUserStars(self), priority=100)
            except Exception:
                pass

    def on_amount_change(self, value):
        try:
            self._stars = str(value).strip() or "0"
            self.set_setting("stars", self._stars)
        except Exception:
            pass

    def on_ton_change(self, value):
        try:
            self._tons = str(value).strip() or "0"
            self.set_setting("ton", self._tons)
        except Exception:
            pass

    def create_settings(self):
        return [
            Header(text="Lincoln Tools"),
            Switch(
                key="enabled",
                text="Включить",
                subtext="Подменять баланс в профиле",
                default=True,
                icon="msg_switcher_off",
            ),
            Divider(),
            Header(text="Баланс звёзд"),
            Input(
                key="stars",
                text="Количество звёзд",
                default="9999",
                subtext="Целое число, видимое в профиле",
                icon="msg_star",
                on_change=self.on_amount_change,
            ),
            Divider(),
            Header(text="Баланс TON"),
            Input(
                key="ton",
                text="Количество TON",
                default="1.5",
                subtext="Дробное число с точкой",
                icon="msg_toncoin",
                on_change=self.on_ton_change,
            ),
            Divider(),
            Text(
                text="Как это работает",
                subtext="Плагин меняет только то, что показывает интерфейс. Серверный баланс не изменяется — это локальная визуальная настройка.",
                icon="msg_info",
            ),
        ]


def create_plugin():
    return LincolnToolsPlugin()


def get_plugin():
    return LincolnToolsPlugin()