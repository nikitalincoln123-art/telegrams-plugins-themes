__id__ = "lincoln_ios"
__name__ = "Lincoln iOS"
__description__ = "Профиль и чаты: свой номер, юзернейм, био, эмодзи-статус, звёзды и TON, премиум, буст, ghost-режим, своё «был(а)…», скрытие просмотров в каналах, «умный» статус по расписанию, режим самолёт, эффект «печатает», NFT-плашка. Всё локально."
__author__ = "Lincoln"
__version__ = "3.0"
__icon__ = "msg_profile"
__app_version__ = ">=12.5.1"
__sdk_version__ = ">=1.4.4.3"
__category__ = ["appearance", "privacy", "fun"]

from decimal import Decimal, getcontext
from typing import Any, List
from datetime import datetime

from base_plugin import BasePlugin, MethodHook, HookResult, HookStrategy
from ui.settings import Header, Switch, Input, Divider, Text
from android_utils import log
from hook_utils import find_class

getcontext().prec = 12


class MutateCurrentUser(MethodHook):
    """После получения своего User подменяем локальные поля (номер, username, био, премиум)."""

    def __init__(self, plugin):
        super().__init__()
        self.plugin = plugin

    def after_hooked_method(self, param):
        try:
            user = param.getResult()
            if user is None:
                return
            if self.plugin.get_setting("fake_phone", True):
                phone = str(self.plugin.get_setting("phone", "79990000000") or "")
                try:
                    user.phone = phone
                except Exception:
                    pass
            if self.plugin.get_setting("fake_username", True):
                usernames = str(self.plugin.get_setting("usernames", "lincoln") or "")
                first = usernames.split(",")[0].strip() or "lincoln"
                try:
                    user.username = first
                except Exception:
                    pass
            if self.plugin.get_setting("fake_premium", True):
                try:
                    user.premium = True
                except Exception:
                    pass
            # Своя био-подпись
            if self.plugin.get_setting("fake_bio", True):
                bio = str(self.plugin.get_setting("bio_text", "") or "").strip()
                if bio:
                    try:
                        user.about = bio
                    except Exception:
                        pass
        except Exception:
            pass


class MutateOtherUser(MethodHook):
    """Безопасная подмена номера/юзернейма у выбранных пользователей (визуально, только у вас)."""

    def __init__(self, plugin):
        super().__init__()
        self.plugin = plugin

    def after_hooked_method(self, param):
        try:
            if not self.plugin.get_setting("fake_others", True):
                return
            user = param.getResult()
            if user is None:
                return
            raw = str(self.plugin.get_setting("others_list", "") or "").strip()
            if not raw:
                return
            uid = getattr(user, "id", 0)
            for line in raw.splitlines():
                parts = [p.strip() for p in line.split(":") if p.strip()]
                if not parts:
                    continue
                try:
                    tid = int(parts[0])
                except Exception:
                    continue
                if tid == uid:
                    if len(parts) > 1:
                        try:
                            user.phone = parts[1]
                        except Exception:
                            pass
                    if len(parts) > 2:
                        try:
                            user.username = parts[2]
                        except Exception:
                            pass
                    break
        except Exception:
            pass


class ReplaceStarsBalance(MethodHook):
    """Подменяет возвращаемое значение getBalance (звёзды/тон) после вызова."""

    def __init__(self, plugin):
        super().__init__()
        self.plugin = plugin

    def after_hooked_method(self, param):
        try:
            if not self.plugin.get_setting("fake_balance", True):
                return
            is_ton = bool(getattr(param.thisObject, "ton", 0))
            value_str = self.plugin.get_setting("ton_balance", "1.5") if is_ton else self.plugin.get_setting("stars_balance", "9999")
            value = Decimal(str(value_str or "0"))
            stars = find_class("org.telegram.tgnet.tl.TL_stars$StarsAmount")
            ton_amount = find_class("org.telegram.tgnet.tl.TL_stars$TL_starsTonAmount")
            if is_ton:
                if ton_amount is not None:
                    amount = ton_amount()
                    amount.amount = int(value * Decimal("1000000000"))
                    param.setResult(amount)
                    return
            elif stars is not None:
                try:
                    amount = stars.ofStars(int(value))
                except Exception:
                    amount = stars(int(value))
                frac = value - int(value)
                try:
                    amount.nanos = int((frac * Decimal("1000000000")).to_integral_value())
                except Exception:
                    pass
                param.setResult(amount)
        except Exception:
            pass


class FakeLastSeen(MethodHook):
    """Подменяет строку «был(а)…» / «в сети» в профиле."""

    def __init__(self, plugin):
        super().__init__()
        self.plugin = plugin

    def after_hooked_method(self, param):
        try:
            if self.plugin.get_setting("fake_lastseen", True):
                try:
                    param.setResult(str(self.plugin.get_setting("lastseen_text", "был(а) только что") or ""))
                except Exception:
                    pass
        except Exception:
            pass


class BoostTrue(MethodHook):
    """Визуальный буст: isPremium возвращает True."""

    def __init__(self, plugin):
        super().__init__()
        self.plugin = plugin

    def after_hooked_method(self, param):
        try:
            if self.plugin.get_setting("boost_profile", True):
                param.setResult(True)
        except Exception:
            pass


class HideViews(MethodHook):
    """Скрывает счётчик просмотров в каналах — подменяет views на 0/скрывает."""

    def __init__(self, plugin):
        super().__init__()
        self.plugin = plugin

    def after_hooked_method(self, param):
        try:
            if not self.plugin.get_setting("hide_views", True):
                return
            result = param.getResult()
            if result is None:
                return
            # Если метод вернул число просмотров — обнуляем
            try:
                param.setResult(0)
            except Exception:
                pass
        except Exception:
            pass


class SetEmojiStatus(MethodHook):
    """Визуальный эмодзи-статус рядом с ником (подмена поля emoji_status)."""

    def __init__(self, plugin):
        super().__init__()
        self.plugin = plugin

    def after_hooked_method(self, param):
        try:
            if not self.plugin.get_setting("fake_emoji_status", True):
                return
            user = param.getResult()
            if user is None:
                return
            emoji = str(self.plugin.get_setting("emoji_status", "🔥") or "").strip()
            if not emoji:
                return
            try:
                # Пробуем задать текстовый эмодзи-статус (если поле поддерживает)
                if hasattr(user, "emoji_status"):
                    st = user.emoji_status
                    if st is None:
                        from org.telegram.tgnet import TLRPC
                        st = TLRPC.TL_emojiStatus()
                    if hasattr(st, "emoji"):
                        st.emoji = emoji
                    user.emoji_status = st
            except Exception:
                pass
        except Exception:
            pass


class LincolnIOSPlugin(BasePlugin):

    def on_plugin_load(self):
        try:
            self._refs = []
            self._hook_user = 0
            self._hook_others = 0
            self._hook_balance = 0

            # ghost-режим: перехват сетевых запросов
            for req in ("TL_account_updateStatus", "TL_messages_setTyping",
                        "TL_messages_readHistory", "TL_messages_readMessageContents"):
                self.add_hook(req)

            # Свой профиль (+ био, эмодзи-статус)
            try:
                uc = find_class("org.telegram.messenger.UserConfig")
                if uc is not None:
                    refs = self.hook_all_methods(uc, "getCurrentUser", MutateCurrentUser(self), priority=100)
                    if refs:
                        self._refs.extend(refs)
                        self._hook_user += len(refs)
                    refs = self.hook_all_methods(uc, "getCurrentUser", SetEmojiStatus(self), priority=90)
                    if refs:
                        self._refs.extend(refs)
            except Exception:
                pass

            # Чужие профили
            try:
                mc = find_class("org.telegram.messenger.MessagesController")
                if mc is not None:
                    refs = self.hook_all_methods(mc, "getUser", MutateOtherUser(self), priority=100)
                    if refs:
                        self._refs.extend(refs)
                        self._hook_others += len(refs)
            except Exception:
                pass

            # Звёзды / TON
            try:
                sc = find_class("org.telegram.ui.Stars.StarsController")
                if sc is not None:
                    refs = self.hook_all_methods(sc, "getBalance", ReplaceStarsBalance(self), priority=100)
                    if refs:
                        self._refs.extend(refs)
                        self._hook_balance += len(refs)
            except Exception:
                pass

            # Своё «был(а)…»
            try:
                cls = find_class("org.telegram.messenger.LocaleController")
                if cls is not None:
                    for mname in ("formatLastSeen", "formatDateOnline"):
                        try:
                            refs = self.hook_all_methods(cls, mname, FakeLastSeen(self), priority=100)
                            if refs:
                                self._refs.extend(refs)
                        except Exception:
                            pass
            except Exception:
                pass

            # Буст (визуальный premium)
            try:
                if self.get_setting("boost_profile", True):
                    uc = find_class("org.telegram.messenger.UserConfig")
                    if uc is not None:
                        refs = self.hook_all_methods(uc, "isPremium", BoostTrue(self), priority=100)
                        if refs:
                            self._refs.extend(refs)
            except Exception:
                pass

            # Скрытие просмотров в каналах
            try:
                if self.get_setting("hide_views", True):
                    for cls_name in ("org.telegram.messenger.MessageObject",
                                     "org.telegram.ui.Cells.ChatMessageCell"):
                        cls2 = find_class(cls_name)
                        if cls2 is not None:
                            try:
                                refs = self.hook_all_methods(cls2, "getViews", HideViews(self), priority=100)
                                if refs:
                                    self._refs.extend(refs)
                            except Exception:
                                pass
            except Exception:
                pass

            # Эффект «печатает»: фоновые типинг-запросы
            try:
                self._typing_running = False
                if self.get_setting("fake_typing", False):
                    self._start_typing_effect()
            except Exception:
                pass

            self.log("[lincoln_ios] loaded, hooks: user=%d others=%d balance=%d" % (self._hook_user, self._hook_others, self._hook_balance))
        except Exception as e:
            self.log("[lincoln_ios] load error: %s" % e)

    # -------------------- fake typing (эффект «печатает…») --------------------

    def _start_typing_effect(self):
        """Периодически отправляет «печатает…» в активный диалог."""
        try:
            if getattr(self, "_typing_running", False):
                return
            self._typing_running = True
            import threading
            from org.telegram.messenger import AccountInstance
            from org.telegram.tgnet import TLRPC, ConnectionsManager

            def _tick():
                try:
                    if not self.get_setting("fake_typing", False):
                        self._typing_running = False
                        return
                    try:
                        fragment = None
                        try:
                            from client_utils import get_last_fragment
                            fragment = get_last_fragment()
                        except Exception:
                            pass
                        if fragment is not None:
                            dialog_id = None
                            try:
                                dialog_id = fragment.getDialogId()
                            except Exception:
                                try:
                                    dialog_id = fragment.getCurrentDialogId()
                                except Exception:
                                    dialog_id = None
                            if dialog_id is not None:
                                try:
                                    account = AccountInstance.getInstance(0)
                                    cm = account.getConnectionsManager()
                                    req = TLRPC.TL_messages_setTyping()
                                    req.peer = account.getMessagesController().getInputPeer(int(dialog_id))
                                    req.action = TLRPC.TL_sendMessageTypingAction()
                                    cm.sendRequest(req, lambda res, err: None)
                                except Exception:
                                    pass
                    except Exception:
                        pass
                except Exception:
                    pass
                if getattr(self, "_typing_running", False):
                    threading.Timer(5.0, _tick).start()

            _tick()
        except Exception:
            self._typing_running = False

    # -------------------- ghost + умный статус + самолёт --------------------

    def pre_request_hook(self, request_name: str, account: int, request: Any) -> HookResult:
        try:
            # Режим самолёт: блокируем сетевые запросы
            if self.get_setting("airplane", False):
                return HookResult(strategy=HookStrategy.CANCEL)

            # «Умный» статус по расписанию: ночью всегда офлайн
            if request_name == "TL_account_updateStatus" and self.get_setting("smart_offline", False):
                try:
                    now = datetime.now().hour
                    start = int(self.get_setting("offline_from", "22") or "22")
                    end = int(self.get_setting("offline_to", "8") or "8")
                    if start <= end:
                        is_offline_hours = start <= now < end
                    else:
                        is_offline_hours = now >= start or now < end
                    if is_offline_hours:
                        try:
                            request.offline = True
                        except Exception:
                            pass
                        return HookResult(strategy=HookStrategy.MODIFY, request=request)
                except Exception:
                    pass

            if request_name == "TL_account_updateStatus" and self.get_setting("ghost_online", True):
                try:
                    request.offline = True
                except Exception:
                    pass
                return HookResult(strategy=HookStrategy.MODIFY, request=request)
            if request_name in ("TL_messages_setTyping", "TL_messages_setEncryptedTyping") \
                    and self.get_setting("dont_send_typing", True):
                return HookResult(strategy=HookStrategy.CANCEL)
            if request_name in ("TL_messages_readHistory", "TL_messages_readMessageContents",
                                "TL_messages_readEncryptedHistory") and self.get_setting("no_read", True):
                return HookResult(strategy=HookStrategy.CANCEL)
        except Exception:
            pass
        return HookResult()

    # -------------------- NFT-плашка (визуальная) --------------------

    def on_nft_row_click(self, *args):
        try:
            from ui.alert import AlertDialogBuilder
            from client_utils import get_last_fragment
            fragment = get_last_fragment()
            activity = fragment.getParentActivity() if fragment else None
            if activity is None:
                return
            builder = AlertDialogBuilder(activity)
            builder.set_title("NFT-подарок")
            builder.set_message("Это визуальная плашка в вашем профиле.\n\nНастоящие NFT-подарки приходят только с сервера Telegram.")
            builder.set_positive_button("OK", lambda b, w: b.dismiss())
            builder.show()
        except Exception:
            pass

    # -------------------- настройки --------------------

