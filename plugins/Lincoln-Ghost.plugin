__id__ = "lincoln_ghost"
__name__ = "Lincoln Ghost"
__description__ = "Скрывает статус «в сети» для собеседников и не отправляет отметку «прочитано», даже когда вы заходите в чат. Всё работает локально, на сервер ничего не отправляется."
__author__ = "Lincoln"
__version__ = "1.1"
__icon__ = "msg_invisible"
__min_version__ = "11.9.0"

from base_plugin import BasePlugin, MethodHook, MethodReplacement, HookResult
from ui.settings import Header, Switch, Divider, Text

from hook_utils import find_class
from org.telegram.messenger import UserConfig


class HideRead(MethodHook):
    """Блокирует отметку «прочитано»: прерываем вызов в before."""

    def __init__(self, plugin):
        super().__init__()
        self.plugin = plugin

    def before_hooked_method(self, param):
        if self.plugin.get_setting("no_read", True):
            # Не даём оригинальному методу выполниться
            param.setResult(None)


class DisableOnline(MethodHook):
    """Не даёт клиенту перевести статус в «в сети»."""

    def __init__(self, plugin):
        super().__init__()
        self.plugin = plugin

    def before_hooked_method(self, param):
        if self.plugin.get_setting("ghost_online", True):
            # Например updateOnlineStatus(true) / setAppPaused(false) — не выполняем
            param.setResult(None)


class ForceOfflineStatus(MethodReplacement):
    """Замена статуса на False, если метод возвращает boolean."""

    def __init__(self, plugin):
        super().__init__()
        self.plugin = plugin

    def replace_hooked_method(self, param):
        if not self.plugin.get_setting("ghost_online", True):
            return param.getResult()
        return False


class LincolnGhostPlugin(BasePlugin):

    def on_plugin_load(self):
        self.add_hook("TL_updateNewMessage")
        self._refs = []

        # 1) Убираем «прочитано»
        mc = find_class("org.telegram.messenger.MessagesController")
        if mc is not None:
            for name in ("markDialogAsRead", "markMessageAsRead", "markMessageContentAsRead"):
                try:
                    for m in mc.getDeclaredMethods():
                        if m.getName() == name:
                            m.setAccessible(True)
                            r = self.hook_method(m, HideRead(self), priority=100)
                            if r:
                                self._refs.append(r)
                except Exception:
                    pass

        # 2) Скрываем «в сети»
        cm = find_class("org.telegram.tgnet.ConnectionsManager")
        if cm is not None:
            for name in ("updateOnlineStatus",):
                try:
                    for m in cm.getDeclaredMethods():
                        if m.getName() == name:
                            m.setAccessible(True)
                            r = self.hook_method(m, DisableOnline(self), priority=100)
                            if r:
                                self._refs.append(r)
                except Exception:
                    pass
            # делаем так, чтобы isOnline возвращал False
            for name in ("isOnline",):
                try:
                    for m in cm.getDeclaredMethods():
                        if m.getName() == name and m.getParameterTypes().length == 0:
                            m.setAccessible(True)
                            r = self.hook_method(m, ForceOfflineStatus(self), priority=100)
                            if r:
                                self._refs.append(r)
                except Exception:
                    pass

        # 3) Не отслеживаем last seen / status при отправке (доп. защита)
        try:
            uc = find_class("org.telegram.messenger.UserConfig")
            if uc is not None:
                for m in uc.getDeclaredMethods():
                    if m.getName() in ("getLastSeen", "saveConfig"):
                        m.setAccessible(True)
                # Не хардкодим, достаточно 1 и 2
        except Exception:
            pass

    def create_settings(self):
        return [
            Header(text="Lincoln Ghost"),
            Switch(
                key="ghost_online",
                text="Скрывать «в сети»",
                subtext="Собеседники не видят вас онлайн",
                default=True,
                icon="msg_invisible",
            ),
            Switch(
                key="no_read",
                text="Не отправлять «прочитано»",
                subtext="Отметка не уходит, даже при открытии чата",
                default=True,
                icon="msg_unread",
            ),
            Divider(),
            Text(
                text="Примечание",
                subtext="Перезапустите клиент после установки. Найдено хуков: %d." % len(self._refs),
                icon="msg_info",
            ),
        ]


def create_plugin():
    return LincolnGhostPlugin()


def get_plugin():
    return LincolnGhostPlugin()