__id__ = "lincoln_ghost"
__name__ = "Lincoln Ghost"
__description__ = "Скрывает статус «в сети» для собеседников, блокирует «печатает» и не отправляет отметку «прочитано», даже когда вы заходите в чат. Работает на уровне запросов — совместимо с новыми версиями клиента."
__author__ = "Lincoln"
__version__ = "2.0"
__icon__ = "msg_invisible"
__app_version__ = ">=12.5.1"
__sdk_version__ = ">=1.4.4.3"

from typing import Any, List

from base_plugin import BasePlugin, HookResult, HookStrategy
from ui.settings import Header, Switch, Divider, Text

TYPING_REQUESTS = ["TL_messages_setTyping", "TL_messages_setEncryptedTyping"]
READ_REQUESTS = ["TL_messages_readHistory", "TL_messages_readMessageContents", "TL_messages_readEncryptedHistory"]


class LincolnGhostPlugin(BasePlugin):

    def on_plugin_load(self):
        for req in TYPING_REQUESTS + READ_REQUESTS:
            self.add_hook(req)
        self.add_hook("TL_account_updateStatus")

    def pre_request_hook(self, request_name: str, account: int, request: Any) -> HookResult:
        # Скрываем «печатает…»
        if request_name in TYPING_REQUESTS and self.get_setting("dont_send_typing", True):
            self.log("[lincoln_ghost] blocked typing: %s" % request_name)
            return HookResult(strategy=HookStrategy.CANCEL)

        # Не отправляем «прочитано»
        if request_name in READ_REQUESTS and self.get_setting("no_read", True):
            self.log("[lincoln_ghost] blocked read receipt: %s" % request_name)
            return HookResult(strategy=HookStrategy.CANCEL)

        # Всегда «оффлайн»
        if request_name == "TL_account_updateStatus" and self.get_setting("ghost_online", True):
            try:
                request.offline = True
            except Exception:
                pass
            return HookResult(strategy=HookStrategy.MODIFY, request=request)

        return HookResult()

    def create_settings(self) -> List[Any]:
        return [
            Header(text="Lincoln Ghost"),
            Switch(
                key="ghost_online",
                text="Скрывать «в сети»",
                subtext="Всегда показываться оффлайн",
                default=True,
                icon="msg_invisible",
            ),
            Switch(
                key="dont_send_typing",
                text="Скрывать «печатает…»",
                subtext="Собеседники не видят, что вы что-то набираете",
                default=True,
                icon="msg_typing",
            ),
            Switch(
                key="no_read",
                text="Не отправлять «прочитано»",
                subtext="Отметка не уходит, даже при открытии чата",
                default=True,
                icon="msg_unread",
            ),
            Divider(),
            Text(
                text="Примечание",
                subtext="Работает на уровне сетевых запросов, поэтому не зависит от версии клиента. Работает для всех аккаунтов.",
                icon="msg_info",
            ),
        ]


def create_plugin():
    return LincolnGhostPlugin()


def get_plugin():
    return LincolnGhostPlugin()