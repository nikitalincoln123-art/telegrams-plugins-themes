__id__ = "lincoln_cleaner"
__name__ = "Lincoln Cleaner"
__description__ = "Массовая очистка чатов: удаляет диалоги из списка одним нажатием — все или по типам (личные, группы, каналы). Работает локально через MessagesController."
__author__ = "Lincoln"
__version__ = "1.0"
__icon__ = "msg_delete"
__app_version__ = ">=12.5.1"
__sdk_version__ = ">=1.4.4.3"
__category__ = ["tools"]

from typing import Any, List, Set

from base_plugin import BasePlugin
from ui.settings import Header, Switch, Divider, Text
from ui.alert import AlertDialogBuilder
from ui.bulletin import BulletinHelper
from android_utils import log, run_on_ui_thread
from client_utils import get_last_fragment, run_on_queue
from org.telegram.messenger import AccountInstance, MessagesController
from java.lang import Boolean, Integer, Long


class LincolnCleanerPlugin(BasePlugin):

    def on_plugin_load(self):
        self._running = False

    def _cached_method(self, cls, name, *types):
        try:
            return cls.getDeclaredMethod(name, *types)
        except Exception:
            try:
                return cls.getMethod(name, *types)
            except Exception:
                return None

    def _collect_dialogs(self, controller):
        dialogs = []
        # Пробуем приватное поле dialogs_dict (классический способ)
        try:
            field = controller.getClass().getDeclaredField("dialogs_dict")
            field.setAccessible(True)
            obj = field.get(controller)
            if obj is not None:
                entries = obj.entrySet()
                it = entries.iterator()
                while it.hasNext():
                    entry = it.next()
                    key = entry.getKey()
                    value = entry.getValue()
                    dialogs.append((key, value))
                return dialogs
        except Exception as e:
            log("[lincoln_cleaner] dialogs_dict access error: %s" % e)
        # Запасной вариант: перечисление через getDialogs/getAllDialogs по всем диалогам
        try:
            for mname in ("getAllDialogs", "getDialogs"):
                try:
                    for method in controller.getClass().getDeclaredMethods():
                        if method.getName() == mname and method.getParameterTypes().length == 0:
                            method.setAccessible(True)
                            result = method.invoke(controller)
                            if result is not None and hasattr(result, "entrySet"):
                                entries = result.entrySet()
                                it = entries.iterator()
                                while it.hasNext():
                                    entry = it.next()
                                    dialogs.append((entry.getKey(), entry.getValue()))
                                return dialogs
                            break
                except Exception:
                    continue
        except Exception as e:
            log("[lincoln_cleaner] fallback collect error: %s" % e)
        return dialogs

    def _should_skip(self, dialog_id, only_private, only_groups, only_channels, keep_saved):
        if keep_saved and dialog_id == 0:
            return True
        if not (only_private or only_groups or only_channels):
            return False
        try:
            if dialog_id > 0:
                return not only_private
            if dialog_id < 0:
                # Каналы имеют id типа -100xxxxxxxxxx, группы - отрицательный
                if only_channels and only_groups:
                    return False
                if only_channels:
                    return not (-1000000000000 <= dialog_id <= -100000000000)
                if only_groups:
                    return -1000000000000 <= dialog_id <= -100000000000
                return False
        except Exception:
            pass
        return False

    def _delete_dialog(self, account, dialog_id):
        try:
            instance = AccountInstance.getInstance(account)
            controller = instance.getMessagesController()
            method = self._find_delete_method(controller)
            if method is None:
                log("[lincoln_cleaner] deleteDialog method not found")
                return
            method.setAccessible(True)
            # Пробуем разные сигнатуры аргументов
            try:
                method.invoke(controller, Long(dialog_id), Integer(0), Boolean(False))
            except Exception:
                try:
                    method.invoke(controller, Long(dialog_id))
                except Exception:
                    try:
                        method.invoke(controller, Long(dialog_id), Integer(0))
                    except Exception as e:
                        log("[lincoln_cleaner] deleteDialog invoke error: %s" % e)
        except Exception as e:
            log("[lincoln_cleaner] delete error %s: %s" % (dialog_id, e))

    def _find_delete_method(self, controller):
        """Ищем метод deleteDialog с любой подходящей сигнатурой."""
        try:
            for method in controller.getClass().getDeclaredMethods():
                if method.getName() != "deleteDialog":
                    continue
                if method.getParameterTypes().length in (1, 2, 3):
                    return method
        except Exception:
            pass
        try:
            return controller.getClass().getMethod("deleteDialog", Long.TYPE, Integer.TYPE, Boolean.TYPE)
        except Exception:
            return None

    def _run_clean(self, account, only_private, only_groups, only_channels, keep_saved, force):
        try:
            self._running = True
            instance = AccountInstance.getInstance(account)
            controller = instance.getMessagesController()
            dialogs = self._collect_dialogs(controller)
            count = 0
            for dialog_id, _dlg in dialogs:
                try:
                    if self._should_skip(dialog_id, only_private, only_groups, only_channels, keep_saved):
                        continue
                    self._delete_dialog(account, dialog_id)
                    count += 1
                except Exception:
                    continue
            self._running = False
            from android_utils import run_on_ui_thread
            run_on_ui_thread(lambda: BulletinHelper.show_info("Очищено диалогов: %d" % count))
        except Exception as e:
            self._running = False
            log("[lincoln_cleaner] run error: %s" % e)

    def _on_clean_click(self, *args):
        from android_utils import run_on_ui_thread

        def _confirm_click(bld, which):
            bld.dismiss()
            run_on_queue(lambda: self._run_clean(
                account=0,
                only_private=self.get_setting("only_private", True),
                only_groups=self.get_setting("only_groups", True),
                only_channels=self.get_setting("only_channels", True),
                keep_saved=self.get_setting("keep_saved", True),
                force=False,
            ))

        fragment = get_last_fragment()
        activity = fragment.getParentActivity() if fragment else None
        if activity is None:
            return
        if self._running:
            BulletinHelper.show_info("Очистка уже выполняется…")
            return
        builder = AlertDialogBuilder(activity)
        builder.set_title("Lincoln Cleaner")
        builder.set_message("Удалить чаты по выбранным правилам? Действие нельзя отменить.")
        builder.set_positive_button("Удалить", _confirm_click)
        builder.set_negative_button("Отмена", lambda b, w: b.dismiss())
        builder.make_button_red(AlertDialogBuilder.BUTTON_POSITIVE)
        builder.show()

    def create_settings(self) -> List[Any]:
        return [
            Header(text="Lincoln Cleaner"),
            Text(
                text="Запустить очистку",
                subtext="Удаляет диалоги по правилам ниже",
                on_click=self._on_clean_click,
                icon="msg_delete",
            ),
            Divider(),
            Header(text="Что удалять"),
            Switch(key="only_private", text="Личные чаты", default=True, icon="msg_user"),
            Switch(key="only_groups", text="Группы", default=True, icon="msg_chat"),
            Switch(key="only_channels", text="Каналы", default=True, icon="msg_broadcast"),
            Switch(key="keep_saved", text="Сохранить «Избранное»", default=True, icon="msg_favorite"),
            Divider(),
            Text(
                text="Важно",
                subtext="Удаляются диалоги из списка. Отменить операцию нельзя — сначала выберите, что оставить.",
                icon="msg_info",
            ),
        ]


def create_plugin():
    return LincolnCleanerPlugin()


def get_plugin():
    return LincolnCleanerPlugin()